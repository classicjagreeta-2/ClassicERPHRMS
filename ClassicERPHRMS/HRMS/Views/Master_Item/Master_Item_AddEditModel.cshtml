    <script src="~/libraries/msg/jquery-confirm.min.js"></script>

    <script src="~/JsProject/commanJs.js"></script>*@


<script>
    $('#btnSubmit').click(function (e) {
        e.preventDefault();
        var IstoVlidate = 'form';
        debugger;
        if ($(IstoVlidate).smkValidate()) {
            debugger;
            ResetTableControlNames();
            ResetTableControlNamesAlias();
            var dataString = new FormData($("#myForm").get(0));
            blockUIStart();
            // "StoreOrEdit", "Master_Customer"
            $.ajax({
                url: "../Master_Item/StoreOrEdit",
                data: dataString,
                contentType: false,
                processData: false,
                cache: false,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    OnSuccess(data);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    debugger;
                    OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });


        }
    });
    function ResetTableControlNames() {
        debugger;
        var tableRows = $("#tblItemOrigin tbody .RowTable");

        if (tableRows.length > 0) {
            var index = 0;
            tableRows.each(function () {
                //set new id of row
                //console.log("New row id = " + "POITable_" + index);
                $(this).attr("id", "POITable_" + index);




                $(this).closest('tr').find("input").each(function () {

                    var OldName = $(this).attr("name");
                    if (OldName != null) {
                        var NewName = $(this).attr("name").split('[')[0] + "[" +
                            index + "]" +
                            $(this).attr("name").split('[')[1].split(']')[1];

                        $(this).attr("name", NewName);

                        console.log(OldName + '----' + NewName);
                    }


                    //(parseInt($(this).attr("name").split('[')[1].split(']')[0]) + 1)

                });

                $(this).closest('tr').find("select").each(function () {

                    var OldName = $(this).attr("name");
                    if (OldName != null) {
                        var NewName = $(this).attr("name").split('[')[0] + "[" +
                            index + "]" +
                            $(this).attr("name").split('[')[1].split(']')[1];

                        $(this).attr("name", NewName);

                        //(parseInt($(this).attr("name").split('[')[1].split(']')[0]) + 1)
                        console.log(OldName + '----' + NewName);
                    }

                });
                index++;
            });
        }

    }
    function ResetTableControlNamesAlias() {
        debugger;
        var tableRows = $("#tblItemAlias tbody .RowTable");

        if (tableRows.length > 0) {
            var index = 0;
            tableRows.each(function () {
                //set new id of row
                //console.log("New row id = " + "POITable_" + index);
                $(this).attr("id", "AliasITable_" + index);




                $(this).closest('tr').find("input").each(function () {

                    var OldName = $(this).attr("name");
                    if (OldName != null) {
                        var NewName = $(this).attr("name").split('[')[0] + "[" +
                            index + "]" +
                            $(this).attr("name").split('[')[1].split(']')[1];

                        $(this).attr("name", NewName);

                        console.log(OldName + '----' + NewName);
                    }


                    //(parseInt($(this).attr("name").split('[')[1].split(']')[0]) + 1)

                });

                $(this).closest('tr').find("select").each(function () {

                    var OldName = $(this).attr("name");
                    if (OldName != null) {
                        var NewName = $(this).attr("name").split('[')[0] + "[" +
                            index + "]" +
                            $(this).attr("name").split('[')[1].split(']')[1];

                        $(this).attr("name", NewName);

                        //(parseInt($(this).attr("name").split('[')[1].split(']')[0]) + 1)
                        console.log(OldName + '----' + NewName);
                    }

                });
                index++;
            });
        }

    }
    function ReArrangeIdexSrl() {
        debugger;
        var tableRows = $('#tblItemOrigin tbody .RowTable');
        var i = 0;
        tableRows.each(function () {
            // $('#tblProduct tbody tr td:second').html(i + 1);
            $(this).find('td').eq(1).find('input').val(i + 1);
            i++;
        })
    }
    function ReArrangeIdexSrlAlias() {
        debugger;
        var tableRows = $('#tblItemAlias tbody .RowTable');
        var i = 0;
        tableRows.each(function () {
            // $('#tblProduct tbody tr td:second').html(i + 1);
            $(this).find('td').eq(1).find('input').val(i + 1);
            i++;
        })
    }
    function OnFailure() {
        $.unblockUI();
    }
    function delRow(delrowid) {
        // alert(delrowid);
        $('#POITable_' + delrowid + '').remove();


        ReArrangeIdexSrl();


        //  ResetTableControlNames();
    }
    function delAliasRow(delrowid) {
        // alert(delrowid);
        if (delrowid != '0') {
            $('#AliasITable_' + delrowid + '').remove();
        }


        //ReArrangeIdexSrlAlias();


        //  ResetTableControlNames();
    }
    function addItemRow() {
        debugger;
        var last_id = $('#hiddentablei').val();
        tablei = parseInt(last_id) + 1;

        //  var rowCount = $('#tblProduct tbody .RowTable').length;


        var MaxId = Number($("#TableMaxRow").val());
        $("#TableMaxRow").val(MaxId + 1);
        var rowCount = MaxId + 1;

        var ValProductCode = $("#tblItemOrigin").find('tr.RowTable').last().find('td').eq(2).find('input').val();

        var html = '';

        html += '<tr id="TblInnerTable_' + rowCount + '">';
        html += '<td colspan="20" class="hiddenRow">';
        html += '<div class="accordian-body collapse" id="demoAG_' + rowCount + '">';
        html += '<div class="row justify-content-center">';
        html += '<div class="col-md-10 TableChild">';
        html += '<table class="table table-bordered mb-0" id="innertable_' + rowCount + '" data-tablelastcolumn="1">';
        html += '<thead class="classHaeder">';
        html += '<tr>';
        html += '<th class="text-center">';
        html += '<a type="button" class="button button-small ag-i-btn" onclick="addRowColumn(' + rowCount + ',0)">';
        html += '<i class="fa fa-plus"></i>';
        html += '</a>';
        html += '</th>';
        html += '<th class="text-center">Product ID</th>';

        html += '</tr>';
        html += '</thead>';
        html += '</table>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
        html += '</td>';
        html += '</tr>';


        var data = { Id: rowCount, CallType: "O" }
        var JsReturn = httpGetWithObj("../Master_Item/AddNewRow", data);

        JsReturn.data += html;
        // $('#div_add_row').append(JsReturn.data);
        $("#tblItemOrigin tbody:first").append(JsReturn.data);
        $('#hiddentablei').val(tablei);
        ReArrangeIdexSrl();
    }
    function addAliasRow() {
        debugger;
        var last_id = $('#hiddentablei1').val();
        tablei = parseInt(last_id) + 1;

        //  var rowCount = $('#tblProduct tbody .RowTable').length;


        var MaxId = Number($("#AliasMaxRow").val());
        $("#AliasMaxRow").val(MaxId + 1);
        var rowCount = MaxId + 1;

        var ValProductCode = $("#tblItemAlias").find('tr.RowTable').last().find('td').eq(2).find('input').val();

        var html = '';

        html += '<tr id="TblInnerTable1_' + rowCount + '">';
        html += '<td colspan="20" class="hiddenRow">';
        html += '<div class="accordian-body collapse" id="demoAG_' + rowCount + '">';
        html += '<div class="row justify-content-center">';
        html += '<div class="col-md-10 TableChild">';
        html += '<table class="table table-bordered mb-0" id="innertable_' + rowCount + '" data-tablelastcolumn="1">';
        html += '<thead class="classHaeder">';
        html += '<tr>';
        html += '<th class="text-center">';
        html += '<a type="button" class="button button-small ag-i-btn" onclick="addRowColumn(' + rowCount + ',0)">';
        html += '<i class="fa fa-plus"></i>';
        html += '</a>';
        html += '</th>';
        html += '<th class="text-center">Product ID</th>';

        html += '</tr>';
        html += '</thead>';
        html += '</table>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
        html += '</td>';
        html += '</tr>';


        var data = { Id: rowCount, CallType: "A" }
        var JsReturn = httpGetWithObj("../Master_Item/AddNewRow", data);

        JsReturn.data += html;
        // $('#div_add_row').append(JsReturn.data);
        $("#tblItemAlias tbody:first").append(JsReturn.data);
        $('#hiddentablei1').val(tablei);
        //ReArrangeIdexSrlAlias();
    }
    function OnBegin() {
        blockUIStart();
    }

    function OnSuccess(result) {

        $.unblockUI();
        if (result.success == false) {
            debugger;
            msgError(result.details);
            //$.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "Errror"
            //})

        } else {
            //msgSuccess(result.message);
            $('form').smkClear();
            $("#ddlaccounthead option:selected").val(null).trigger("change");

            $.confirm({

                title: 'Confirmation !!',
                type: 'green',
                content: result.message,
                typeAnimated: true,
                icon: 'icon-smiley',
                buttons: {

                    Okay: function () {
                        $("#btnclose").click();
                        dataTable.ajax.reload();

                    },
                    //cancel: function () {

                    //}
                }

            });
            //  debugger;
            // $("#ddlaccounthead").empty().trigger('change')
            // $("#ddlaccounthead option:selected").prop("selected", false);
            // $("#ddlaccounthead").selectpicker("refresh");
            //$.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "success"
            //})
        }

    }

    function OnFailure(result) {
        $.unblockUI();
    }
</script>

}

