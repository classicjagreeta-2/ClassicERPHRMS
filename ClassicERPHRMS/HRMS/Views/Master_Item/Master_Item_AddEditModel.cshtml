@model WEB_VIEWMODEL17.TD_Model.TD_Model_ItemMaster



<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">


    @*@using (Ajax.BeginForm("StoreOrEdit", "Master_Item", new AjaxOptions
        { OnSuccess = "OnSuccess", OnBegin = "OnBegin" }, new { onsubmit = "return SubmitForm(this)" }))*@
    @using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))
    {

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Product Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Product ID</label>
                                @Html.TextBoxFor(x => x.ItemHead.PK_ITCD, new { @class = "form-control mustfiled", @readonly = true })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Description*</label>
                                @Html.TextBoxFor(x => x.ItemHead.ITEM_DESCN, new { @class = "form-control mustfiled", @required = "required", @maxlength = "60" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Short Description</label>
                                @Html.TextBoxFor(x => x.ItemHead.SHT_DESCN, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="uom">
                                <label for="exampleInputName1">UOM*</label>
                                @Html.DropDownListFor(x => x.ItemHead.FK_UNIT_CD, new SelectList(ViewBag.DropdownListMasterUnit, "PK_UNIT_CD", "UNIT_DESCN"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlUnit", @required = "required" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group" id="HSCode">
                                <label for="exampleInputName1">HS Code</label>
                                @Html.TextBoxFor(x => x.ItemHead.HS_CODE, new { @class = "form-control", @maxlength = "15" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="Grade">
                                <label for="exampleInputName1">Grade</label>
                                @Html.TextBoxFor(x => x.ItemHead.GRADE, new { @class = "form-control", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="pkUnit">
                                <label for="exampleInputName1">Packaging UOM*</label>
                                @Html.DropDownListFor(x => x.ItemHead.FK_PACK_UNIT, new SelectList(ViewBag.DropdownListMasterUnit, "PK_UNIT_CD", "UNIT_DESCN"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlPkUnit", @required = "required" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="pkNetWt">
                                <label for="exampleInputName1">Net Weight of Each Package</label>
                                @Html.TextBoxFor(x => x.ItemHead.PACKAGE_NET_WT, new { @class = "form-control", @type = "Number" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group" id="pkTareWt">
                                <label for="exampleInputName1">Tare Weight of Each Package</label>
                                @Html.TextBoxFor(x => x.ItemHead.PACKAGE_TARE_WT, new { @class = "form-control", @type = "Number" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="bh">
                                <label for="exampleInputName1">Broad Head*</label>
                                @Html.DropDownListFor(x => x.ItemHead.FK_BH, new SelectList(ViewBag.DropdownListMasterBH, "PK_CODE", "DESCN"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlBH", @required = "required" })

                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="sh">
                                <label for="exampleInputName1">Sub Head*</label>
                                @Html.DropDownListFor(x => x.ItemHead.FK_SH, new SelectList(ViewBag.DropdownListMasterSH, "PK_CODE", "DESCN"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlSH", @required = "required" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">

                                <div class="checkbox-fade fade-in-primary">

                                    @Html.CheckBoxFor(x => x.ItemHead.ITEM_SPECN_BOOL)
                                    <span>Maintain Item Specification</span>

                                </div>
                                <div class="checkbox-fade fade-in-primary">

                                    @Html.CheckBoxFor(x => x.ItemHead.ACTIVE_TAG_BOOL)
                                    <span>Active Item</span>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    @Html.CheckBoxFor(x => x.ItemHead.P205_YESNO_BOOL)
                                    <span>P205 Qty Applicable</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="TableMaxRow" value=@ViewBag.MaxRowIndex />
                <input type="hidden" id="AliasMaxRow" value=@ViewBag.AliasMaxRowIndex />
                <div class="col-lg-12">
                    <div class="row">
                        @if (@ViewBag.Loca1 == "VEC")
                        {
                            <div class="col-lg-6">
                                <input type="hidden" name="hiddentablei" id="hiddentablei" value=@ViewBag.MaxRowIndex>
                                <div class="dataTables_scroll">
                                    <div class="table-responsive text-nowrap" id="DivTble">
                                        <div style="overflow:auto">
                                            <table id="tblItemOrigin" class="table table-striped table-bordered nowrap dataTable no-footer" style="width: 100%;" role="grid" aria-describedby="ajax-table_info">
                                                <thead class="classHaeder">
                                                    <tr>
                                                        <th width="6%">
                                                            <a type="button" class="button button-small ag-i-btn" onclick="addItemRow()"><i class="fa fa-plus"></i></a>
                                                        </th>
                                                        <th width="3%"><label class="col-form-label">  Sl No </label> </th>
                                                        <th><label class="col-form-label">  code </label> </th>
                                                        <th><label class="col-form-label">  Country of Origin </label> </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @Html.Partial("_ItemOriginChild", Model)
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <input type="hidden" name="hiddentablei1" id="hiddentablei1" value=@ViewBag.AliasMaxRowIndex>
                                <div class="dataTables_scroll">
                                    <div class="table-responsive text-nowrap" id="DivTble1" style="display:none">
                                        <div style="overflow:auto">
                                            <table id="tblItemAlias" class="table table-striped table-bordered nowrap dataTable no-footer" style="width: 100%;" role="grid" aria-describedby="ajax-table_info">
                                                <thead class="classHaeder">
                                                    <tr>
                                                        <th width="6%">
                                                            <a type="button" class="button button-small ag-i-btn" onclick="addAliasRow()"><i class="fa fa-plus"></i></a>
                                                        </th>
                                                        <th width="4%"><label class="col-form-label">  Alias ID </label> </th>
                                                        <th width="50%"><label class="col-form-label">  Product Alias Description* </label> </th>
                                                        <th width="15%"><label class="col-form-label">  UOM* </label> </th>
                                                        <th width="15%"><label class="col-form-label">  Packaging UOM* </label> </th>
                                                        <th width="10%"><label class="col-form-label">  Net Weight </label> </th>
                                                        <th width="10%"><label class="col-form-label">  Tare Weight </label> </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @*@Html.Partial("_ItemAliasChild", Model)*@
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-lg-12">
                                <input type="hidden" name="hiddentablei1" id="hiddentablei1" value=@ViewBag.AliasMaxRowIndex>
                                <div class="dataTables_scroll">
                                    <div class="table-responsive text-nowrap" id="DivTble1">
                                        <div style="overflow:auto">
                                            <table id="tblItemAlias" class="table table-striped table-bordered nowrap dataTable no-footer" style="width: 100%;" role="grid" aria-describedby="ajax-table_info">
                                                <thead class="classHaeder">
                                                    <tr>
                                                        <th width="6%">
                                                            <a type="button" class="button button-small ag-i-btn" onclick="addAliasRow()"><i class="fa fa-plus"></i></a>
                                                        </th>
                                                        <th width="4%"><label class="col-form-label">  Alias ID </label> </th>
                                                        <th width="50%"><label class="col-form-label">  Product Alias Description* </label> </th>
                                                        <th width="15%"><label class="col-form-label">  UOM* </label> </th>
                                                        <th width="15%"><label class="col-form-label">  Packaging UOM* </label> </th>
                                                        <th width="10%"><label class="col-form-label">  Net Weight </label> </th>
                                                        <th width="10%"><label class="col-form-label">  Tare Weight </label> </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @Html.Partial("_ItemAliasChild", Model)
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>
                <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>


<script src="~/libraries/assets/js/select2.js"></script>
<!-- Multiselect js -->
<!-- Custom js -->
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>




