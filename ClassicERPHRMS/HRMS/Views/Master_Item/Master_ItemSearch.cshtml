
@model WEB_VIEWMODEL17.TD_Model.MAST_ITEM

@{
    ViewBag.Title = "Item Master";
}

<!-- Data Table Css -->

<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/datatables.net-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/data-table/css/buttons.dataTables.min.css">
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css">



<style>
    .modal-backdrop {
        opacity: 0.5 !important;
    }
</style>



<div class="modal fade" id="IdModal" tabindex="-1" role="dialog">

</div>
<div class="modal fade" id="myModal2">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="container"></div>
            <div class="modal-body">

                <div id="IdDivMsg" style="font-size:22px;color:red;"> </div>
                <br />
                <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>

            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="label-main">
            <label class="label label-inverse-noLine"><h4>Item Master</h4></label>
        </div>
        <button id="IdaddNewRecord" type="button" class="btn btn-grd-info  btn-md float-right" data-toggle="modal" data-target="#IdModal">Add New</button>
    </div>
    <div class="card-block">

        <div class="dt-responsive table-responsive">
            <table id="idDataTable" class="table table-striped table-bordered nowrap">

                <thead>
                    <tr>
                        <th>Master Item Head</th>
                        <th></th>

                    </tr>
                </thead>
            </table>
        </div>


    </div>


</div>


@section scripts{

    <!-- data-table js -->


    <script src="~/libraries/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/jszip.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/vfs_fonts.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/buttons.colVis.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script type="text/javascript" src="libraries\bower_components\sweetalert\js\sweetalert.min.js"></script>
    <script type="text/javascript" src="libraries\assets\js\modal.js"></script>
    <!-- sweet alert modal.js intialize js -->
    <!-- modalEffects js nifty modal window effects -->
    <script type="text/javascript" src="libraries\assets\js\modalEffects.js"></script>
    <script type="text/javascript" src="libraries\assets\js\classie.js"></script>


    <script src="~/JsProject/commanJs.js"></script>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>


 


    @*<script src="~/libraries/bootstrap-notify.js"></script>
        <script src="~/libraries/bootstrap-notify.min.js"></script>

        <script src="~/libraries/msg/jquery-confirm.min.js"></script>
        <link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />*@
    <script>
        var Popup, dataTable;

        $(document).ready(function () {

            // AddNewRecords
            $("#IdaddNewRecord").click(function () {
                var data = { Id: 0 };
                var x = httpGetWithObj("../Master_Item/AddEditModel", data);
                $("#IdModal").empty().append(x.data);
            });


            dataTable = $("#idDataTable").DataTable({
                initComplete: function () {
                    var input = $('.dataTables_filter input').unbind(),
                        self = this.api(),
                        $searchButton = $('<button>')
                            .text('search')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                self.search(input.val()).draw();
                            }),
                        $clearButton = $('<button>')
                            .text('clear')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                input.val('');
                                $searchButton.click();
                            })
                    $('.dataTables_filter').append($searchButton, $clearButton);
                },
                "proccessing": true,
                "serverSide": true,
                search: {
                    return: true,
                },
                ajax: {
                    url: "../Master_Item/GetData",
                    type: "POST"
                },

                columns: [
                    { data: "Item_descn" },

                    {
                        "data": "PK_ITCD", "render": function (data) {

                            return "<a class='btn btn-sm btn-info' data-toggle='modal' data-target='#IdModal' onclick=PopupForm(" + data + ")><i class='icofont icofont-eye-alt'></i></a> <a class='btn btn-sm btn-danger'  onclick=Delete(" + data + ")><i class='icofont icofont-delete-alt'></i></a>";

                        },
                    }
                ],

                dom: 'lBfrtip',
                buttons: [{
                    extend: 'excelHtml5',
                    exportOptions: {
                        columns: ':visible'
                    }
                }],

                "language": {
                    "search": "",
                    "searchPlaceholder": "Search..."
                },

            });
        });

        //function PopupForm(Id) {
        //    var data = { Id:Id };
        //    var x = httpGetWithObj("../MasterInsurance/AddEditModel", data);
        //    $('#IdModal').modal('show');
        //    // alert('');
        //}

        function PopupForm(Id) {


            var data = { Id: Id };
            var x = httpGetWithObj("../Master_Item/AddEditModel", data);
            $("#IdModal").empty().append(x.data);

        }

        function SubmitForm(form) {

            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })


                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');

                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }

            return false;

        }

        function Delete(id) {
            if (confirm('Are you sure to Delete this record ?')) {

                $.ajax({

                    type: "POST",
                    url: "../Master_Item/Delete",
                    data: { Id: id },
                    success: function (data) {

                        if (data.success) {

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })

                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');

                        }
                    },
                    error: function (errorjqXHR, exception) {


                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }

                });
            }
        }

    </script>

}

