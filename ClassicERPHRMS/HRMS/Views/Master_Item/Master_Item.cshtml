@section scripts{


    @*<script type="text/javascript" src="~/libraries/bower_components/jquery/js/jquery.min.js"></script>*@
    @*<script type="text/javascript" src="~/libraries/bower_components/jquery-ui/js/jquery-ui.min.js"></script>*@

    <script src="~/libraries/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/jszip.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/vfs_fonts.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/buttons.colVis.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>


    <script type="text/javascript" src="~/libraries/assets/js/modalEffects.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/classie.js"></script>
    <script src="~/libraries/js/jquery.unobtrusive-ajax.min.js"></script>
    @*<script src="~/libraries/assets/pages/data-table/js/data-table-custom.js"></script>*@
    @*<script src="~/libraries/assets/pages/data-table/extensions/responsive/js/responsive-custom.js"></script>*@


    <script src="~/Scripts/notify.min.js"></script>
    <script src="~/libraries/msg/jquery-confirm.min.js"></script>
    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>
    <script src="~/JsProject/commanJs.js"></script>
    <script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

    <link href="~/libraries/js/loader/easy-loading.css" rel="stylesheet" />

    <script src="~/libraries/Loader/waiting/bootstrap-waitingfor.js"></script>


    <script>
        var Popup, dataTable;

        $(document).ready(function () {

            // AddNewRecords


            $("#IdaddNewRecord").click(function () {

                var data = { Id: 0 };
                //var x = httpGetWithObj("/Master_AccountHead/AddEditModel", data);
                //$("#IdModal").empty().append(x.data);


                $.ajax({
                    type: "GET",
                    url: "../Master_Item/AddEditModel",
                    async: false,
                    data: data,
                    success: function (data) {

                        $("#IdModal").empty().append(data);

                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });

            });

            $("#IdImportRecord").click(function () {

                var data = { Id: 0 };
                $.ajax({
                    type: "GET",
                    url: "../MasterExcel/ItemMasterUpload",
                    async: false,
                    data: data,
                    success: function (data) {

                        $("#IdModal").empty().append(data);
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });

            });

            $("#btnaddNewRecord").click(function () {
                debugger;
                var data = { Id: 0 };
                $.ajax({
                    type: "POST",
                    url: "../Master_Item/AddEditModel",
                    async: false,
                    data: data,
                    success: function (data) {

                        //$("#divMsg").empty();
                        //$("#IdModal").empty().append(data);

                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });

            });
            dataTable = $("#ajax-table").DataTable({
                initComplete: function () {
                    var input = $('.dataTables_filter input').unbind(),
                        self = this.api(),
                        $searchButton = $('<button>')
                            .text('search')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                self.search(input.val()).draw();
                            }),
                        $clearButton = $('<button>')
                            .text('clear')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                input.val('');
                                $searchButton.click();
                            })
                    $('.dataTables_filter').append($searchButton, $clearButton);
                },               
                "serverSide": true,
                "processing": true, // for show progress bar,
                retrieve: true,
                "language": {
                    'processing': '<i class="icofont icofont-spinner-alt-2 icofont-3x"></i>'
                },
                search: {
                    return: true,
                },
                responsive: true,
                ajax: {
                    url: "/Master_Item/GetData",
                    type: "POST"
                },

                columns: [
                    {
                        "data": "PK_ITCD", "render": function (data) {
                            //return "<a class='btn btn-sm btn-info' data-toggle='modal' data-target='#IdModal' onclick=PopupForm('" + data + "')><i class='icofont icofont-pencil-alt-4 icofont-1x'></i></a> <a class='btn btn-sm btn-danger'  onclick=Delete('" + data + "')><i class='icofont icofont-delete-alt'></i></a>";
                            return "<a class='btn btn-sm btn-info' data-toggle='modal' data-target='#IdModal' onclick=PopupForm('" + data + "')><i class='icofont icofont-pencil-alt-4 icofont-1x'></i></a>";
                        },
                    },
                    { data: "PK_ITCD" },
                    { data: "ITEM_DESCN" },
                    { data: "SHT_DESCN" },
                    { data: "ITEM_SPECN" },
                    { data: "FK_UNIT_CD" },
                    { data: "HS_CODE" },
                    { data: "GRADE" },
                    { data: "P205_YESNO" },
                    { data: "FK_PACK_UNIT" },
                    { data: "PACKAGE_NET_WT" },
                    { data: "PACKAGE_TARE_WT" },
                    { data: "ACTIVE_TAG" },
                ],

                dom: 'lBfrtip',
                buttons: [{
                    extend: 'excelHtml5',
                    exportOptions: {
                        columns: ':visible'
                    }
                }],

                "language": {
                    "search": "",
                    "searchPlaceholder": "Search..."
                },

            });

            new $.fn.dataTable.FixedHeader(dataTable);
        });



        function PopupForm(Id) {
            var data = { Id: Id };

            $.ajax({
                type: "GET",
                url: "../Master_Item/AddEditModel",
                async: false,
                data: data,
                success: function (data) {

                    $("#IdModal").empty().append(data);
                    waitingDialog.hide();

                },
                error: function (errorjqXHR, exception) {

                    $('.btnClose').click();
                    $.notify("Error In Edit", {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }

            });
        }

        function SubmitForm(form) {

            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })


                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');

                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }

            return false;

        }

        function Delete(id) {
            $.confirm({
                title: "Confirmation required",
                content: "Are you sure you want to delete?",
                buttons: {
                    YES: function () {

                        DeleteRecord(id);
                    },
                    NO: function () {

                    },

                }
            });

        }


        function DeleteRecord(id) {
            $.ajax({

                type: "POST",
                url: "../Master_Item/Delete",
                data: { Id: id },
                success: function (data) {

                    if (data.success) {

                        dataTable.ajax.reload();

                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "success"
                        })

                    }
                    else {
                        $("#IdDivMsg").empty().append(data.message);
                        $("#IdDivDeatils").empty().append(data.details);
                        // $("#divMsg").empty().append(data.details);
                        $("#myModal2").modal('show');

                    }
                },
                error: function (errorjqXHR, exception) {


                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }

            });
        }
    </script>

}

