

@model  WEB_VIEWMODEL17.TD_Model.TD_Model_ItemMaster
@{
    int RowIndex = ViewBag.RowIndex1;// ViewBag.RowIndex;
}

@if (Model.ItemAliasDet != null && Model.ItemAliasDet.Any())


{
    for (int i = 0; i < Model.ItemAliasDet.Count; i++)
    {

        if (@ViewBag.EditForm == true)
        {
            RowIndex = i;
        }

<tr id="AliasITable_@RowIndex" class="RowTable">

    <td>
        <button type="button" class="button button-small ag-i-btn btn-del" onclick="delAliasRow(@RowIndex)"><i class="fa fa-trash"></i></button>
    </td>
    <td>
        @Html.TextBox("ItemAliasDet[" + RowIndex + "].PK_CODE", Model.ItemAliasDet[i].PK_CODE, new { @class = "form-control", @readonly = "true" })
    </td>
    <td class="form-group">
        @Html.TextBox("ItemAliasDet[" + RowIndex + "].ITEM_ALIAS_DESCN", Model.ItemAliasDet[i].ITEM_ALIAS_DESCN, new { @class = "form-control", @required = "required", @maxlength = "100" })
    </td>
    <td class="form-group">
        @Html.DropDownList("ItemAliasDet[" + RowIndex + "].UNIT_CD", new SelectList(ViewBag.DropdownListMasterUnit, "PK_UNIT_CD", "UNIT_DESCN",Model.ItemAliasDet[i].UNIT_CD),
            "SELECT..", new { @class = "js-example-responsive", @required = "required" })
    </td>
    <td class="form-group">
        @Html.DropDownList("ItemAliasDet[" + RowIndex + "].FK_PACK_UNIT",new SelectList(ViewBag.DropdownListMasterUnit, "PK_UNIT_CD", "UNIT_DESCN", Model.ItemAliasDet[i].FK_PACK_UNIT),
            "SELECT..", new { @class = "js-example-responsive", @required = "required" })
    </td>
    <td class="form-group">
        @Html.TextBox("ItemAliasDet[" + RowIndex + "].PACKAGE_NET_WT", Model.ItemAliasDet[i].PACKAGE_NET_WT, new { @class = "form-control", @type = "Number" })
    </td>
    <td class="form-group">
        @Html.TextBox("ItemAliasDet[" + RowIndex + "].PACKAGE_TARE_WT", Model.ItemAliasDet[i].PACKAGE_TARE_WT, new { @class = "form-control", @type = "Number" })
    </td>
</tr>
    }

}


<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />

<script type="text/javascript" src="~/libraries/bower_components/select2/js/select2.full.min.js"></script>
<!-- Multiselect js -->
<!-- Custom js -->
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/msg/jquery-confirm.min.js"></script>
<script src="~/JsProject/TD_EntryProduct.js"></script>
