@model  WEB_VIEWMODEL17.TD_Model.TD_Model_ItemMaster
@{
    int RowIndex = ViewBag.RowIndex;// ViewBag.RowIndex;
}

@if (Model.ItemOriginDet != null && Model.ItemOriginDet.Any())


{
    for (int i = 0; i < Model.ItemOriginDet.Count; i++)
    {

        if (@ViewBag.EditForm == true)
        {
            RowIndex = i;
        }

<tr id="POITable_@RowIndex" class="RowTable">

    <td>
        <button type="button" class="button button-small ag-i-btn btn-del" onclick="delRow(@RowIndex)"><i class="fa fa-trash"></i></button>
    </td>
    <td>
        @Html.TextBox("ItemOriginDet[" + RowIndex + "].SRLNO", Model.ItemOriginDet[i].SRLNO, new { @class = "form-control", @readonly = "true" })
    </td>
    <td>
        @Html.TextBox("ItemOriginDet[" + RowIndex + "].PK_CODE", Model.ItemOriginDet[i].PK_CODE, new { @class = "form-control", @readonly = "true"  })
    </td>
    <td class="form-group">
        @Html.DropDownList("ItemOriginDet[" + RowIndex + "].FK_COUNTRY_CODE", new SelectList(ViewBag.DropdownListMasterCountry, "PK_CODE", "NAME", Model.ItemOriginDet[i].FK_COUNTRY_CODE),
              "SELECT..", new  { @class = "js-example-responsive",  @Id = "ddlCountry_" + RowIndex, @required = "required" })
    </td>
</tr>

    }

}


<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />

<script type="text/javascript" src="~/libraries/bower_components/select2/js/select2.full.min.js"></script>
<!-- Multiselect js -->
<!-- Custom js -->
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/msg/jquery-confirm.min.js"></script>
<script src="~/JsProject/TD_EntryProduct.js"></script>
