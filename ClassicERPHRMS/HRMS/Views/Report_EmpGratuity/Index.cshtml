@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        @*<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>*@
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <strong>@TempData["ErrorMessage"]</strong>
    </div>
}
<div class="page-body">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pull-right">
                <div class="text-center"><h4>Gratuity Report</h4></div>
            </div>
            <div class="card-block" id="divcontainer">

                <div class="row">
                    <div class="col-sm-1">
                    </div>
                    <div class="col-sm-4">
                        <label for="exampleInputName1"><b>SELECT MONTH</b></label>
                        @Html.DropDownListFor(x => x.FK_MONTHCODE, new SelectList(ViewBag.GratuityMonth, "Value", "Text"), "SELECT..", new { @class = "form-control", @required = "required", @type = "text", @id = "ddlMonth" })
                    </div>
                    <div class="col-sm-6">
                        <label for="exampleInputName1"><b>SELECT Employee</b></label>
                        <select id="ddlEmp" multiple="multiple" class="js-example-responsive col-sm-12" disabled="true">
                            @foreach (var emp in ViewBag.EmpList)
                            {
                                <option value="@emp.Value">@emp.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnSubmit" class="btn btn-sm btn-primary pull-right">VIEW REPORT</button>
                </div>
            </div>
        </div>
    </div>
</div>
