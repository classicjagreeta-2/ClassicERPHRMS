      $(document).ready(function() {
    $('#ddlMonth').change(function () {
        debugger;

        var selectedMonth = $(this).val();
        var empDropdown = $('#ddlEmp');
        empDropdown.attr('disabled', 'true');
        if (selectedMonth) {
            $.ajax({
                url: '@Url.Action("GetEmployeesByMonth", "Report_EmpGratuity")', // Your action method
                type: 'GET',
                data: { monthCode: selectedMonth },
                success: function(data) {
                    empDropdown.empty(); // Clear existing options

                    if (data.length > 0) {
                        $.each(data, function(index, item) {
                            empDropdown.append($('<option>', {
                                value: item.PK_EMPCODE,
                                text: item.PK_EMPCODE + "-" + item.FNAME + " " + item.LNAME
                            }));
                        });

                        // Remove the 'disabled' attribute to enable the dropdown
                        empDropdown.removeAttr('disabled');
                    } else {
                        empDropdown.append($('<option>', {
                            value: '',
                            text: 'No employees found'
                        }));

                        // Ensure the dropdown is enabled even if no employees are found
                        empDropdown.removeAttr('disabled');
                    }
                },
                error: function() {
                    // Handle any errors
                    empDropdown.empty();
                    empDropdown.append($('<option>', {
                        value: '',
                        text: 'Error retrieving data'
                    }));
                    empDropdown.removeAttr('disabled');
                }
            });
        } else {
            empDropdown.empty(); // Clear employee dropdown if no month is selected

            // Optionally, reapply the disabled state if no month is selected
            // empDropdown.attr('disabled', 'true');
        }
    });
});
    </script>

