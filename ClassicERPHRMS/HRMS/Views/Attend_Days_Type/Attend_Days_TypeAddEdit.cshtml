<script>

    $(document).ready(function () {

        function attencd() {

            debugger;
            // Get the initial value of the textbox
            var initialValue = $("#attendcode").val();

            // Check if the initial value is not empty
            if (initialValue !== "") {
                // If it has initial data, disable the textbox
                $("#attendcode").prop("disabled", true);
            }
        }
   

        attencd();
       
    /*    ordertd();*/


    });


    $('.single-checkbox').click(function () {

        debugger;

        // Uncheck all checkboxes except the one clicked
        $('.single-checkbox').not(this).prop('checked', false);

    });

    //$('.checkbox-group').on('change', function () {
    //    $('.checkbox-group').not(this).prop('checked', false); // Uncheck other checkboxes
    //});

    $('#btnSubmit').click(function (e) {
        e.preventDefault();
        var IstoVlidate = 'form';
        var directUrl = '@Url.Action("StoreOrEdit", "Attend_Days_Type")';
        debugger;
        if ($(IstoVlidate).smkValidate()) {
            debugger;
            var dataString = new FormData($("#myForm").get(0));
            blockUIStart();
            // "StoreOrEdit", "Master_Customer"
            $.ajax({
                url: directUrl,
                data: dataString,
                contentType: false,
                processData: false,
                cache: false,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    OnSuccess(data);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    debugger;
                    OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });


        }
    });
    function OnFailure() {
        $.unblockUI();
    }
    function OnBegin() {
        blockUIStart();
    }

    function OnSuccess(result) {

        $.unblockUI();
        if (result.success == false) {
            debugger;
            msgError(result.details);
            //$.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "Errror"
            //})

        } else {
            //msgSuccess(result.message);
            $('form').smkClear();
            $("#ddlaccounthead option:selected").val(null).trigger("change");

            $.confirm({

                title: 'Confirmation !!',
                type: 'green',
                content: result.message,
                typeAnimated: true,
                icon: 'icon-smiley',
                buttons: {

                    Okay: function () {
                        $("#btnclose").click();
                        dataTable.ajax.reload();

                    },
                    //cancel: function () {

                    //}
                }

            });

            //  debugger;
            // $("#ddlaccounthead").empty().trigger('change')
            // $("#ddlaccounthead option:selected").prop("selected", false);
            // $("#ddlaccounthead").selectpicker("refresh");
            // $.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "success"
            //})

        }

    }

    function OnFailure(result) {
        $.unblockUI();
    }
</script>

