@model HRMS.Models.Master.M_ATTEND_DAYS_TYPE
@{
    ViewBag.Title = "AddEditModal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modal-dialog modal-lg" role="document">
    @using (Html.BeginForm("AddOrUpdate", "Attend_Days_Type", FormMethod.Post, new { id = "myForm" }))
    {
        @Html.HiddenFor(x => x.id)
        <div class="modal-content" style="width:70%">
            <div class="modal-header">
                <h4 class="modal-title">Attendence Type  Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        @if (Model.id != 0)
                        {
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="exampleInputName1">Attendance Code:</label>
                                    @Html.TextBoxFor(x => x.pK_ATTEND_CODE, new { @class = "form-control mustfiled", @required = "required", @minlength = "1", @maxlength = "4", @disabled = "disabled", @id = "CODE" })
                                </div>
                                @Html.HiddenFor(x => x.id)
                                @Html.HiddenFor(x => x.pK_ATTEND_CODE)
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="exampleInputName1">Attendance Code:</label>
                                    @Html.TextBoxFor(x => x.pK_ATTEND_CODE, new { @class = "form-control mustfiled", @required = "required", @minlength = "1", @maxlength = "4", @id = "CODE", @style = "text-transform:uppercase" })
                                </div>
                                @Html.HiddenFor(x => x.id)

                            </div>
                        }


                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="exampleInputName1">Attendance Description:</label>
                                @Html.TextBoxFor(x => x.description, new { @class = "form-control mustfiled", @maxlength = "25", @required = "required" })
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="exampleInputName1">Short Name:</label>
                                @Html.TextBoxFor(x => x.shorT_NAME, new { @class = "form-control mustfiled", @maxlength = "25", @required = "required" })
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="exampleInputName1">Print Ordertag:</label>
                                @Html.TextBoxFor(x => x.ordeR_TAG, new { @class = "form-control mustfiled", @maxlength = "25", @required = "required" })
                            </div>
                        </div>




                        <div class="col-md-12" id="chkbox">
                            <label class="checkbox-fade fade-in-primary">
                                @Html.RadioButtonFor(x => x.attendencetype, "WithoutPay", new { @class = "single-checkbox", @required = true })
                                Without Pay
                            </label><br>

                            <label class="checkbox-fade fade-in-primary">
                                @Html.RadioButtonFor(x => x.attendencetype, "Extra Days", new { @class = "single-checkbox" })
                                Extra Days
                            </label><br>
                            <label class="checkbox-fade fade-in-primary">
                                @Html.RadioButtonFor(x => x.attendencetype, "Leave", new { @class = "single-checkbox" })
                                Leave
                            </label><br>
                            <label class="checkbox-fade fade-in-primary">
                                @Html.RadioButtonFor(x => x.attendencetype, "Overtime", new { @class = "single-checkbox" })
                                Overtime
                            </label><br>
                            <label class="checkbox-fade fade-in-primary">
                                @Html.RadioButtonFor(x => x.attendencetype, " Weekly Off", new { @class = "single-checkbox" })
                                Weekly Off
                            </label><br>
                            <label class="checkbox-fade fade-in-primary">
                                @Html.RadioButtonFor(x => x.attendencetype, "Holiday", new { @class = "single-checkbox" })
                                Holiday
                            </label><br>
                        </div>
                        @*<div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.RadioButtonFor(x => x.attendencetype, new { @class = "single-checkbox", @required = true })
                                        <span>Without Pay</span>
                                    </div>
                                </div>


                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.RadioButtonFor(x => x.attendencetype, new { @class = "single-checkbox" })
                                        <span>Extra Days</span>
                                    </div>
                                </div>

                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.RadioButtonFor(x => x.attendencetype, new { @class = "single-checkbox" })
                                        <span>Leave</span>
                                    </div>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.RadioButtonFor(x => x.attendencetype, new { @class = "single-checkbox" })
                                        <span>Overtime</span>
                                    </div>
                                </div>

                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.RadioButtonFor(x => x.attendencetype, new { @class = "single-checkbox" })
                                        <span>Weekly Off</span>
                                    </div>
                                </div>

                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.RadioButtonFor(x => x.attendencetype, new { @class = "single-checkbox" })
                                        <span>Holiday</span>
                                    </div>
                                </div>

                            </div>*@
                    </div>
                </div>
                <div class="modal-footer">
                    <div id="divMsg" class="text-danger"> </div>
                    <a class="btn btn-default waves-effect" onclick="location.href='@Url.Action("Attend_Days_Type", "Attend_Days_Type")'" id="btnclose" data-dismiss="modal">Close</a>
                    <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>Submit</button>
                </div>
            </div>
        </div>
    }


</div>






