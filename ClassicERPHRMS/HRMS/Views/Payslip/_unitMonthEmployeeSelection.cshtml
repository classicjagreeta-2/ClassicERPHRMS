<div class="row">
    <div class="col-6">
        <div class="oh-input__group">

            <label class="oh-input__label" for="id_group_name">Unit</label>
            <input type="hidden" id="dailyUnit" value="This is a text box">
            <select id='Unit'name='Unit' data-placeholder="Please choose unit" data-allow-clear="true" data-close-on-select="false">
                <optgroup label="select all">
                    <option> </option>
                </optgroup>
            </select>
        </div>
    </div>
    <div class="col-6">
        <div class="oh-input__group">
            <label class="oh-input__label" for="id_group_name">Month</label>
            <input type="hidden" id="dailyMonth" value="This is a text box">
            <select id='MonthCode'name='MonthCode' data-placeholder="Month Year" data-allow-clear="true" data-close-on-select="false">
                <optgroup id="SELECTALL" label="select all">
                    <option></option>
                </optgroup>
            </select>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="oh-input__group">
            <label class="oh-input__label" for="select-employee">Employee</label>
            <select id="select_employee"name="select_employee" placeholder="Select Text" multiple data-placeholder="Please choose one or more" data-allow-clear="true" data-close-on-select="false">
            </select>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        debugger
      let optionSelect2 = {

      closeOnSelect: false,
      width: '100%',
      ajax: {
           url: "@Url.Action("GetEmployee", "Setting")",
           data: function (params) {
               var UNIT = $('#dailyUnit').val();
               //var _UNIT = $('#unitValue').val();
               //var _Unit = $('#Unit').val();
               //var _unit = $('#unit').val();
               //if (typeof (_UNIT) !== "undefined") {
               //    UNIT = _UNIT;
               //}
               //else if (typeof (_Unit) !== "undefined") {
               //    UNIT = _Unit;
               //}
               //else {
               //    UNIT = _unit;
               //}
           var query = {
               searchString: params.term,
               page: params.page || 1,
               pageSize: 10,
               UNIT: UNIT,
           }
           return query;
   },
           processResults: function (res) {
       var list = res.Data.value.results;
       var dataList =  $.map(list, function (x) {
           return {
               text: x.pK_EMPCODE + "-" + x.fname,
               id: x.pK_EMPCODE
           };
       })
       return {
           results: dataList,
           pagination: {
               more: res.Data.value.currentPage < res.Data.value.pageCount
           }
       };
   }
      }
  };
    $("#select_employee").select2(optionSelect2);

    $("#checkbox").click(function () {
        if ($("#checkbox").is(':checked')) {
            $("#select_employee > option").prop("selected", "selected");
            $("#select_employee").trigger("change");
        } else {
            $("#select_employee > option").removeAttr("selected");
            $("#select_employee").trigger("change");
        }
    });

        $("#generatePayslipBtn").click(function () {
            debugger
            /*alert($("#select_employee").val());*/
            var selectemployee=  $("#select_employee").val();
            var mcode = $("#dailyMonth").val();
            var unit = $("#dailyUnit").val();
            //var yrcode = $("#yearcode").val();
            //var monthcode = yrcode.concat(mcode);
            window.location.href = "@Url.Action("Payslip", "Payslip")?select_employee=" + selectemployee + "&MonthCode=" + mcode + "&Unit=" + unit;
    });
    });
</script>
<script>

    $('#Unit').change(function () {
        debugger
       var x = $(this).val();
        $('#dailyUnit').val(x);
    });

    $('#MonthCode').change(function () {
        debugger
        var x = $(this).val();
        $('#dailyMonth').val(x);
    });

    debugger
    $('#MonthCode').select2({
       ajax: {
       url:  "@Url.Action("GetMonthCodeDropDown", "DailyAttend")",
       data: function (params) {
           var query ={
               searchString: params.term,
               page: params.page || 1,
               pageSize: 25,
               UNIT: $('#dailyUnit').val(),
           }
           return query;
       },
            processResults: function (res, params) {
                debugger;
                var list = res.Data.value.results; // The data returned from the API
           // Map the data into the Select2 expected format
           return {
               results: $.map(list, function (x) {
                   return {
                       text: x.MonthName, // The text to display in the dropdown
                       id: x.pK_MONTHCODE
                   };
               }),
               pagination: {
                   more: res.Data.value.currentPage < res.Data.value.pageCount // Check if more results are available
               }
           };
       },

       cache: true
      }
    });

    $('#Unit').select2({
    ajax: {
    url:  "@Url.Action("GetUnitDropdown", "DailyAttend")",
    data: function (params) {
        var query ={
            searchString: params.term, // The search term
            page: params.page || 1, // Page number for pagination
            pageSize: 5, // Number of results per page
            /*UNIT: $("#select-unit").val(), // The value of the UNIT dropdown*/
        }
        return query;
    },
    processResults: function (res, params) {

        var list = res.Data.value.results; // The data returned from the API
        return {
            results: $.map(list, function (x) {
                return {
                    text: x.code + "-" + x.name, // The text to display in the dropdown
                    id: x.code // The value to store for the option
                };
            }),
            pagination: {
                more: res.Data.value.currentPage < res.Data.value.pageCount // Check if more results are available
            }
        };
    },

    cache: true
   }
    });
</script>
