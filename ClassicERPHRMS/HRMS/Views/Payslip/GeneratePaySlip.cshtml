                    icon: 'icon-smiley',
                    buttons: {
                        Okay: function () {
                            $("#btnclose").click();
                            /*location.reload();*/

                        },
                    }
                });
            }
        }

        function OnFailure(result) {
            $.unblockUI();
        }


        function SubmitForm(form) {

            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })
                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');
                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }
            return false;
        }

        function IdaddNewRecord(Id) {
            debugger
          
            var data = { EmpCode: Id };
            var returnUrl = '@Url.Action("AddEditModel", "MastEmpRate")';

                debugger;
                $.ajax({
                    type: "GET",
                    url: returnUrl,
                    data: data,
                    beforeSend: function () {
                        blockUIStart();
                    },
                    complete: function () {
                        $.unblockUI();
                    },
                    success: function (data) {
                        debugger;
                        $("#IdModal").empty().append(data);
                        $('#IdModal').modal('show');
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Error"
                        });
                    }
                });
        }
        
           
        
    </script>

