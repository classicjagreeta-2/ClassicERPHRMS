<div class="modal-dialog modal-lg" role="document">

    <div class="row">
        <div class="col-lg-4">
            <div class="card">
                @if (ViewBag.Attend == null)
                {
                    using (Html.BeginForm("GeneratePaySlip", "Payslip", FormMethod.Post))
                    {
                        <div class="card-block" id="divcontainer">
                            <div class="j-wrapperForm j-wrapper-640">
                                <!-- end /.header -->
                                <div class="j-content">
                                    <!-- start login -->
                                </div>
                                <div class="col-sm-12">
                                    <label for="exampleInputName1">SELECT MONTH</label>
                                    @{
                                        var empList = ViewBag.Month as List<M_MONTH>;
                                        var empSelectList = empList.Select(item => new SelectListItem
                                        {
                                            Text = DateTime.ParseExact(item.pK_MONTHCODE, "yyyyMM", CultureInfo.InvariantCulture).ToString("MMM") + " " + DateTime.ParseExact(item.pK_MONTHCODE, "yyyyMM", CultureInfo.InvariantCulture).ToString("yyyy"),
                                            Value = item.pK_MONTHCODE.ToString()
                                        }).ToList();
                                        empSelectList.Insert(0, new SelectListItem { Text = "SELECT ..", Value = "" });
                                    }
                                    @Html.DropDownListFor(x => x.t_DAILYATTEND.FK_MONTHCODE, empSelectList, new { @class = "js-example-responsive col-sm-12", @id = "ddlMonth", @required = "required" })
                                    <div class="modal-footer">

                                        <a id="IdAddNewAllActiveEmpRecord" class="btn btn-outline-primary m-r-0">
                                            <i class="fa fa-files-o fa-lg" aria-hidden="true"></i> Payroll Calculation
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <!-- Multiple Open Accordion start -->
        <div class="col-lg-8">

            <div class="card">
                <h6 style="text-align:center">Employee w/o Declared Rate</h6>
                <div class="card-header">
                    <div class="row">
                        @if (ViewBag.EmpWithOutRate != null)
                        {
                            foreach (var item in ViewBag.EmpWithOutRate)
                            {

                                <div class="col-sm-3">
                                    <a href="#" class="employee-link" onclick=IdaddNewRecord(@item.PK_EMPCODE) id="IdaddNewRecord" data-id="@item.PK_EMPCODE" style="color: darkred;">
                                        <i class="fa fa-circle-o-notch fa-spin" style="color: darkred;"></i> @item.PK_EMPCODE - @item.FNAME @item.LNAME  
                                    </a>
                                </div>
                                




                            }
                        }
                    </div>
                            </div>
            </div>
        </div>
    </div>
</div>
