        function OnFailure() {
            $.unblockUI();
        }
        function OnBegin() {
            blockUIStart();
        }

        function OnSuccess(result) {

            $.unblockUI();
            if (result.success == false) {
                debugger;
              /*  msgError(result.details);*/
                //$.notify(result.message, {
                //    globalPosition: "top center",
                //    className: "Errror"
                //})
                $.confirm({

                    title: 'Warning !!',
                    type: 'red',
                    content: result.message,
                    typeAnimated: true,
                    icon: 'icon-smiley',
                    buttons: {
                        Okay: function () {
                            $("#btnclose").click();
                            /*location.reload();*/

                        },
                    }
                });


            } else {
                //msgSuccess(result.message);
                //$('form').smkClear();
                //$("#ddlaccounthead option:selected").val(null).trigger("change");

                $.confirm({

                    title: 'Confirmation !!',
