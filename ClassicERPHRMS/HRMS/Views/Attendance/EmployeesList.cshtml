
@model List<HRMS.Models.TRN.T_DAILY_ATTEND>

@using System.Globalization


@{
    ViewBag.Title = "Employee Daily Attendance";
    DateTime date = DateTime.ParseExact(ViewBag.MonthCodeId, "yyyyMM", CultureInfo.InvariantCulture);
    ViewBag.MonthName = date.ToString("MMMM");
    ViewBag.Year = date.ToString("yyyy");
    //int LeaveCount = ViewBag.LeaveRemaining;
    //TempData["toastrSuccess"]=null;
}


<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/datatables.net-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/data-table/css/buttons.dataTables.min.css">
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<link href="~/libraries/TableRowDesign.css" rel="stylesheet" />


<link href="~/libraries/assets/css/CheckBoxStyle.css" rel="stylesheet" />

<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<!-- Multi Select css -->
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/bootstrap-multiselect/css/bootstrap-multiselect.css">
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/multiselect/css/multi-select.css">

<style>
    .modal-backdrop {
        opacity: 0.5 !important;
    }

    .dataTables_length {
        margin: 0px 0px -45px 6px;
    }

    div.dt-buttons {
        margin: 0px 0px 0px 188px;
    }


    .select2-container .select2-selection--single {
        height: 34px;
    }
</style>

<div class="card">
    <div class="card-header pull-right">


        <a href="@Url.Action("Index","Menu")" class="btn btn-sm btn-info float-left">
            Close
            <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>
        </a>
        <a id="backBtn" href="javascript:void(0)" class="btn btn-sm btn-info float-right">
            <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i> Back
        </a>
        <div class="text-center"><h4>Attendance Details (@ViewBag.MonthName @ViewBag.Year)</h4></div>
        <div class="text-center"><h5>@ViewBag.DisplayName </h5></div>

    </div>

    @*@if (TempData["toastrSuccess"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["toastrSuccess"]
            </div>
        }*@
    @if (TempData["toastrSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["toastrSuccess"]</strong>    
            @*<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>*@
        </div>
        
    }
    @if (TempData["toastrError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@TempData["toastrError"]</strong>
        </div>
    }
    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <div id="TblEmp">
                @Html.Partial("~/Views/Attendance/_EmpList.cshtml", Model)

            </div>
        </div>
    </div>
</div>



