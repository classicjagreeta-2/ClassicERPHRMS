    <script>
        var table;
        $(document).ready(function () {
            datatable();
        });
        $(document).ready(function () {
            $('.ddlattend').change(function () {
                debugger
                var selectedValue = $(this).val();
                var lateTimeInput = $(this).closest('tr').find('.form-control');

                if (selectedValue == 'S' || selectedValue == 'M' || selectedValue == 'PH' || selectedValue == 'L' || selectedValue == 'W' || selectedValue == 'A') {
                    lateTimeInput.prop('disabled', true);
                } else {
                    lateTimeInput.prop('disabled', false);
                }
            });
        });

        function datatable() {
            $(function () {
                table = $("#ajax-table").DataTable({
                    scrollY: '320px',
                    scrollX: true,
                    "processing": true, // for show progress bar,
                    retrieve: true,
                    "language": {
                        'processing': '<i class="icofont icofont-spinner-alt-2 icofont-3x"></i>'
                    },

                    lengthMenu: [
                        [50, 100, 500, -1],
                        ['50', '100', '500', 'Show all']
                    ],
                    dom: 'lBfrtip',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                        }
                    ],
                });
            });
        }

        setTimeout(function () { $('.alert').alert('close'); }, 5000);

        $('#btnSubmit').click(function (e) {
            e.preventDefault();
            var IstoVlidate = 'form';
            debugger;
            if ($(IstoVlidate).smkValidate()) {
                debugger;
                var dataString = new FormData($("#myForm").get(0));
                var returnUrl = '@Url.Action("StoreOrEdit", "Attendance")'
                blockUIStart();
                // "StoreOrEdit", "Master_Customer"
                $.ajax({
                    url: returnUrl,
                    data: dataString,
                    contentType: false,
                    processData: false,
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        OnSuccess(data);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        debugger;
                        OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                });
            }
        });


        function PopupForm(Id, empcode,moncode) {
            debugger

            let attendtypeid = "FK_ATTEND_CODE" + Id;
            let attendtype2 = document.getElementById(attendtypeid).value;//id+ID=idID
            let lateValue = document.getElementById("txt_" + Id).value;
            let data = { Id: Id, EmpCode: empcode, MonthCode: moncode, LateId: lateValue, AttendType: attendtype2 };
            var returnUrl = '@Url.Action("StoreOrEditEmployeesList", "Attendance")'
            if (!["P", "E", "W", "A", "M", "F"].includes(attendtype2))
            {
                //var leaveType = document.getElementById(attendtypeid);
                var dropdown = document.getElementById(attendtypeid);
                var selectedOptionText = dropdown.options[dropdown.selectedIndex].text;
                //var leaveType = $("#attendtypeid option:selected").text();
                //var remainingCasualLeave = $("#Leave").val();


                 $.ajax({
                     type: "POST",
                    /* url: "/MastEmpLinkDel/AddEditModel",*/
                     url: returnUrl,
                     async: false,
                     data: data,
                     success: function (data) {
                         debugger;

                             @*var remainingCasualLeave = @ViewBag.LeaveRemaining;*@

                             let dropdown = document.getElementById(attendtypeid);
                             let originalValue = dropdown.getAttribute("data-original-value");
                             dropdown.value = originalValue;
                             /* $('.btnClose').click();*/
                                     $("#TblEmp").empty().html(data);
                                     datatable();
                                     var remainingCasualLeave = $("#Leave").val();
                                     if (remainingCasualLeave == 0) {

                                         $.notify(" No Remaining " + selectedOptionText + " left, Contact ADMINISTRATION", {
                                        globalPosition: "top center",
                                        className: "Error"
                                    })
                                }
                                     else {
                                         $("#TblEmp").empty().html(data);
                                         datatable();
                                    //$.notify("Remaining " + leaveType + " " + " Leave: " + remainingCasualLeave + ", Contact ADMINISTRATION", {
                                    //    globalPosition: "top center",
                                    //    className: "Error"
                                    $.notify("Successfully Save. " + "Remaining " + selectedOptionText + " " + remainingCasualLeave , {
                                        globalPosition: "top center",
                                        className: "success"
                                    })
                                }
                     },
                     error: function (errorjqXHR, exception) {

                         $('.btnClose').click();
                         $.notify("Error In Edit", {
                             globalPosition: "right center",
                             className: "Errror"
                         })
                     }
                 });
            }

            else
            {
                 @*let data = { Id: Id, EmpCode: empcode, MonthCode: moncode, LateId: lateValue, AttendType: attendtype2 };
                  var returnUrl = '@Url.Action("StoreOrEditEmployeesList", "Attendance")'*@
                 $.ajax({
                     type: "POST",
                    /* url: "/MastEmpLinkDel/AddEditModel",*/
                     url: returnUrl,
                     async: false,
                     data: data,
                     success: function (data) {
                         debugger;

                         $.notify("Successfully Save", {
                             globalPosition: "top center",
                             className: "success"
                         })
                         $("#TblEmp").empty().html(data);
                         datatable();




                     },
                     error: function (errorjqXHR, exception) {

                         $('.btnClose').click();
                         $.notify("Error In Edit", {
                             globalPosition: "right center",
                             className: "Errror"
                         })
                     }
                 });
            }
        }
        function BackPageForm(moncode) {
            debugger
            let data = { mcode: moncode };
            var returnUrl = '@Url.Action("DailyAttend", "Attendance")'
            $.ajax({
                type: "GET",
                url: returnUrl,
                async: false,
                data: data,
                success: function (data) {
                    //$("#BackIdModal").empty().append(data);
                    //waitingDialog.hide();
                },
                error: function (errorjqXHR, exception) {

                    $('.btnClose').click();
                    $.notify("Error In Edit", {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        };
        document.getElementById("backBtn").addEventListener("click", openNewWindow);
        debugger

         function openNewWindow() {
            var url = '../DailyAttend?mcode=@ViewBag.MonthCodeId';
            window.open(url, '_self');
          }
        $("#IdaddNewRecord").click(function () {
            debugger
            var Id = $(this).data('id');
            var data = { monthcode: Id };
            var returnUrl = '@Url.Action("EmployeesList", "Attendance")'
            //var x = httpGetWithObj("/MastEmp/AddEditModel", data);
            //$("#IdModal").empty().append(x.data);
            debugger;
            $.ajax({
                type: "GET",
                url: returnUrl,
                async: false,
                data: data,
                success: function (data) {

                    debugger;
                    $("#IdModal").empty().append(data);
                },
                error: function (errorjqXHR, exception) {
                    $("#divMsg").empty();
                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        });

        function SubmitForm(form) {
            debugger
            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })
                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');
                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }
            return false;
        }

        $("#FK_ATTEND_CODE").change(function () {
            debugger
            var attendCode = $(this).val();
            @*var remainingCasualLeave = @ViewBag.LeaveRemaining;*@
            var remainingCasualLeave = LeaveCount;
            if (attendCode == "C" && remainingCasualLeave == 0)
            {
               /* $("#errorMsg").text("Casual Leave: 0, Contact Administration");*/
                $("#IdDivMsg").empty().append("Casual Leave: 0, Contact Administration");
                // Show error message
            }
            else
            {
                $("#IdDivMsg").empty().append("Reamaining Casual Leave: "+remainingCasualLeave);
                    // Clear error message
            }
        });

        function Delete(id) {
            $.confirm({
                title: "Confirmation required",
                content: "Are you sure you want to delete?",
                buttons: {
                    YES: function () {

                        DeleteRecord(id);
                    },
                    NO: function () {

                    },
                }
            });
        }

        function DeleteRecord(id) {
            $.ajax({

                type: "POST",
                url: "../TD_OtherMaster/Delete",
                data: { Id: id },
                success: function (data) {

                    if (data.success) {

                        dataTable.ajax.reload();

                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "success"
                        })
                    }
                    else {
                        $("#IdDivMsg").empty().append(data.message);
                        $("#IdDivDeatils").empty().append(data.details);
                        // $("#divMsg").empty().append(data.details);
                        $("#myModal2").modal('show');
                    }
                },
                error: function (errorjqXHR, exception) {

                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        }
        function submitForm() {
            debugger
            $('#loader').show();
            $('#myForm').submit(function () {
                $('#loader').hide();
            });
        }

    </script>
}
