        function PopupForm(Id) {
            var data = { Id: Id };
            var returnUrl = '@Url.Action("EmployeesList", "Attendance")'
        debugger
            $.ajax({
                type: "GET",
               
                url: returnUrl,
                async: false,
                data: data,
                success: function (data) {

                    $("#AddEmp").empty().append(data);
                    waitingDialog.hide();
                },
                error: function (errorjqXHR, exception) {

                    $('.btnClose').click();
                    $.notify("Error In Edit", {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        }
        $("#IdaddNewRecord").click(function () {
            debugger
            var Id = $(this).data('id');
            var data = { monthcode: Id };
            //var x = httpGetWithObj("/MastEmp/AddEditModel", data);
            //$("#IdModal").empty().append(x.data);
            var directUrl = '@Url.Action("EmployeesList", "Attendance")';
            debugger;
            $.ajax({
                type: "GET",
                url: directUrl,
                async: false,
                data: data,
                success: function (data) {

                    debugger;
                    $("#AddEmp").empty().append(data);
                },
                error: function (errorjqXHR, exception) {
                    $("#divMsg").empty();
                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        });
        function SubmitForm(form) {

            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#AddEmp').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })
                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');
                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }
            return false;
        }
        function Delete(id) {
            $.confirm({
                title: "Confirmation required",
                content: "Are you sure you want to delete?",
                buttons: {
                    YES: function () {

                        DeleteRecord(id);
                    },
                    NO: function () {

                    },
                }
            });
        }

        function DeleteRecord(id) {
            var redirectUrl = '@Url.Action("Delete", "TD_OtherMaster")';
            $.ajax({

                type: "POST",
                url: redirectUrl,
                data: { Id: id },
                success: function (data) {

                    if (data.success) {

                        dataTable.ajax.reload();

                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "success"
                        })
                    }
                    else {
                        $("#IdDivMsg").empty().append(data.message);
                        $("#IdDivDeatils").empty().append(data.details);
                        // $("#divMsg").empty().append(data.details);
                        $("#myModal2").modal('show');
                    }
                },
                error: function (errorjqXHR, exception) {

                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        }
    </script>

