@model HRMS.Models.ModelView.PayModel_Daily_Attend
@using HRMS.Models.Master
@using System.Globalization
@{
    ViewBag.Title = "Daily Attendance";
    if (ViewBag.FK_ID != null)
    {
        DateTime date = DateTime.ParseExact(ViewBag.FK_ID, "yyyyMM", CultureInfo.InvariantCulture);
        ViewBag.MonthName = date.ToString("MMMM");
        ViewBag.Year = date.ToString("yyyy");
    }

    var empList = ViewBag.Month as List<M_MONTH>;
    // Assuming ViewBag.Month is of type List<string>

    var empSelectList = empList.Select(item => new SelectListItem
    {
        //Text = GetMonthYearText(item.PK_MONTHCODE.ToString()),
        Text = DateTime.ParseExact(item.PK_MONTHCODE, "yyyyMM", CultureInfo.InvariantCulture).ToString("MMM") + " " + DateTime.ParseExact(item.PK_MONTHCODE, "yyyyMM", CultureInfo.InvariantCulture).ToString("yyyy"),
        Value = item.PK_MONTHCODE.ToString()
    }).ToList();
    empSelectList.Insert(0, new SelectListItem { Text = "SELECT OPTION", Value = "" });

}


