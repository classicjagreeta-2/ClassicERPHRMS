
@{

}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Redesign</title>
    @*Add your CSS framework (e.g., Bootstrap, Font Awesome)*@
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<style>
    .form-check-inline .form-check-input {
        position: static;
        margin-top: 0px;
        margin-right: -0.6875rem;
        margin-left: 0;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #444;
        line-height: 11px;
    }
    select.form-control:not([size]):not([multiple]) {
        height: 28px;
    }
</style>
<body>
    <div class="container mt-5">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title"><strong>File Creation for PF (ECR) data upload</strong></h4>
            </div>
            <div class="card-body">
                <!-- Unit Selection -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <input type="hidden" id="dailyUnit" value="This is a text box">
                        <label for="unitSelect" class="form-label"><strong>Select Unit</strong></label>
                        <select id='select-dailyUnit' data-placeholder="Please choose unit" data-allow-clear="true" class="form-control" data-close-on-select="true">
                            <optgroup label="select all">
                                <option> </option>
                            </optgroup>
                        </select>
                    </div>
                    <!-- Month Year Selection -->
                    <div class="col-md-3">
                        <input type="hidden" id="dailyMonth" value="This is a text box">
                        <label for="monthYearSelect" class="form-label"><strong>Select Month & Year</strong></label>
                        <select id='select-dailyMonth' data-placeholder="please choose Month Year" class="form-control" data-allow-clear="false" data-close-on-select="true">
                            <optgroup id="SELECTALL" label="select all">
                                <option></option>
                            </optgroup>
                        </select>
                    </div>
                    <!-- Employee Type Selection -->
                    <div class="col-md-3">
                        <label for="employeeTypeSelect" class="form-label"><strong>Select Employee Type</strong></label>
                        @Html.DropDownList("EmpType", new SelectList(ViewBag.EmpType ?? new List<SelectListItem>(), "Value", "Text"), "please choose Emp Type",
                                                      new { @class = "form-control", @required = "required", id = "select-empType" })
                        @Html.ValidationMessage("EmpType", "", new { @class = "text-danger" })
                        @*<select id="employeeTypeSelect" name="employeeType" class="form-control">
                                <option value="" selected>Select Employee Type</option>
                                <option value="FullTime">Full Time</option>
                                <option value="PartTime">Part Time</option>
                                <option value="Contract">Contract</option>
                            </select>*@
                    </div>

                    <!-- Department Selection -->
                    <div class="col-md-3">
                        <label for="departmentSelect" class="form-label"><strong>Select Department</strong></label>
                        @Html.DropDownList("Dept", new SelectList(ViewBag.Department ?? new List<SelectListItem>(), "Value", "Text"), "SELECT..",
                              new { @class = "form-control", @required = "required" })
                        @Html.ValidationMessage("Dept", "", new { @class = "text-danger" })
                        @*<select id="departmentSelect" name="department" class="form-control">
                                <option value="" selected>Select Department</option>
                                <option value="HR">HR</option>
                                <option value="Finance">Finance</option>
                                <option value="IT">IT</option>
                                <option value="Sales">Sales</option>
                            </select>*@
                    </div>

                </div>

                <!-- Radio Buttons for PF No / UAN Wise -->
                <fieldset class="mb-4">
                    @*<legend class="col-form-label">Select PF or UAN Wise</legend>*@
                    <legend class="col-form-label"><strong>Select PF or UAN Wise</strong></legend>

                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="radio" id="pfNoWise" value="PF" checked>
                        <label class="form-check-label" for="pfNoWise">PF No Wise</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="radio" id="uanWise" value="UAN">
                        <label class="form-check-label" for="uanWise">UAN Wise</label>
                    </div>
                </fieldset>

                <!-- Data Import Options -->
                <fieldset class="mb-4">
                    <legend class="col-form-label"><strong>Select Data Import Type</strong></legend>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="dataImport" id="monthlyDataImport" value="Monthly" checked>
                        <label class="form-check-label" for="monthlyDataImport">Monthly Data Import</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="dataImport" id="employeeUpload" value="Employee">
                        <label class="form-check-label" for="employeeUpload">Employee Upload</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="dataImport" id="form2Upload" value="Form2">
                        <label class="form-check-label" for="form2Upload">Form 2 Upload</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="dataImport" id="annexureUpload" value="Annexure">
                        <label class="form-check-label" for="annexureUpload">Annexure II Upload</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="dataImport" id="form12AUpload" value="Form12A">
                        <label class="form-check-label" for="form12AUpload">Form 12A Upload</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" name="dataImport" id="esiDataUpload" value="ESI">
                        <label class="form-check-label" for="esiDataUpload">ESI Data Upload</label>
                    </div>
                </fieldset>


                <!-- File Upload Section -->
                <div class="mb-4">
                    <label for="fileUpload" class="form-label"><strong>Select Excel File Import</strong></label>
                    <input type="file" class="form-control-file" id="fileUpload" name="files[]">
                </div>

                <!-- Submit Button -->
                <div class="text-right">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        //$(document).ready(function () {
        //    $('.select2').select2({
        //        width: '100%',
        //        //theme: 'bootstrap4' // Optional if you want Bootstrap-styled dropdowns
        //    });
        //});
    $('#select-dailyUnit').change(function () {
        debugger
        var x = $(this).val();
        $('#dailyUnit').val(x);
    });

    $('#select-dailyMonth').change(function () {
        debugger
        var x = $(this).val();
        $('#dailyMonth').val(x);
    });

     $('#select-dailyUnit').select2({
        ajax: {
        url:  "@Url.Action("GetUnitDropdown", "DailyAttend")",
        data: function (params) {
            var query ={
                searchString: params.term, // The search term
                page: params.page || 1, // Page number for pagination
                pageSize: 5, // Number of results per page
                /*UNIT: $("#select-unit").val(), // The value of the UNIT dropdown*/
            }
            return query;
        },
            processResults: function (res, params) {

                var list = res.Data.value.results; // The data returned from the API
                return {
                    results: $.map(list, function (x) {
                        return {
                            text: x.code + "-" + x.name, // The text to display in the dropdown
                            id: x.code // The value to store for the option
                        };
                    }),
                    pagination: {
                        more: res.Data.value.currentPage < res.Data.value.pageCount // Check if more results are available
                    }
                };
            },
            cache: true
        }
     });

     $('#select-dailyMonth').select2({
        ajax: {
        url:  "@Url.Action("GetMonthCodeDropDown", "DailyAttend")",
            data: function (params) {
                var query ={
                    searchString: params.term,
                    page: params.page || 1,
                    pageSize: 25,
                    UNIT: $('#dailyUnit').val(),
                }
                return query;
            },
             processResults: function (res, params) {
                 debugger;
                 var list = res.Data.value.results; // The data returned from the API
            // Map the data into the Select2 expected format
                return {
                    results: $.map(list, function (x) {
                        return {
                            text: x.MonthName, // The text to display in the dropdown
                            id: x.pK_MONTHCODE
                        };
                    }),
                    pagination: {
                        more: res.Data.value.currentPage < res.Data.value.pageCount // Check if more results are available
                    }
                };
             },

            cache: true
        }
     });
    </script>
</body>

</html>




