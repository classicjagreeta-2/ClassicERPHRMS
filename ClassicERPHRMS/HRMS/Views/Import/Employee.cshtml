@using System.Data;
@{
        ViewBag.Title = "AttendanceMonthly";
        Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<div class="card">
    <div class="card-header">
        <div class="card-header-right">

        </div>
    </div>
    <div class="card-block">
        <div class="sub-title">Employee Excel Upload</div>
        @using (Html.BeginForm("Employee", "Import", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="row form-group col-sm-12">
                <div class="col-sm-8">
                    @*<input class="form-control " type="file" id="FileUpload" name="FileUpload">*@
                    <input type="file" id="fileUpload" name="fileUpload" class="" accept=".xlsx, .xls .csv" />
                    @Html.ValidationMessage("FileUpload2", "", new { @class = "text-danger" })
                </div>
                <div class="row form-group col-sm-4">
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary">Upload</button>
                    </div>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary">Cancel</button>
                    </div>
                </div>
            </div>
        }
        @Html.Partial("_UploadTable")
    </div>
</div>









