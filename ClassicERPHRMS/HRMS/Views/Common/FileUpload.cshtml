@{
    ViewBag.Title = "UPLOAD / DOWNLOAD FILES";
}
<style>
    .input-group a {
        padding-top: 12px;
        padding-bottom: 12px;
        /* font-size: 12px; */
    }

    .file-drop-zone {
        min-height: 100px;
    }

    @@media (min-width:1200px) {
        .container {
            max-width: 100%
        }
    }

    .hide1 {
        display: none;
    }
</style>

<div class="page-body">
    <div class="card">
        <div class="card-header">
            <h5 class="card-header-text">ORDER DETAILS</h5>
          
        </div>
        <div class="card-block">
            <div class="view-info">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="general-info">
                            <div class="row">
                                <div class="col-lg-12 col-xl-6">
                                    <div class="table-responsive">
                                        <table class="table m-0">
                                            <tbody>
                                                <tr>
                                                    <th scope="row"> @ViewBag.HeaderName : </th>
                                                    <td>@ViewBag.dtHead.Rows[0]["DOCNO"]</td>
                                                    <th scope="row">@ViewBag.HeaderDate : </th>
                                                    <td>

                                                        @(Convert.ToDateTime(ViewBag.dtHead.Rows[0]["DOCDT"]).ToString("dd/MMM/yyyy"))

                                                    </td>

                                                </tr>


                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <!-- end of table col-lg-6 -->
                                <div class="col-lg-12 col-xl-6">
                                    <div class="table-responsive">
                                        <table class="table">
                                            <tbody>
                                                <tr>
                                                    <th scope="row">@ViewBag.Header  : </th>
                                                    <td>@ViewBag.dtHead.Rows[0]["CUSTOMER"]</td>


                                                </tr>

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <!-- end of table col-lg-6 -->
                            </div>
                            <!-- end of row -->
                        </div>
                        <!-- end of general info -->
                    </div>
                    <!-- end of col-lg-12 -->
                </div>
                <!-- end of row -->
            </div>
            <!-- end of view-info -->
            <!-- end of edit-info -->
        </div>
        <!-- end of card-block -->
    </div>

    <div class="row">
        <div class="col-sm-12">

            <div class="card">

                <div class="card-block tab-icon">
                    <!-- Row start -->
                    <div class="row">


                        <div class="col-lg-12 col-xl-12">
                            <!-- <h6 class="sub-title">Tab With Icon</h6> -->
                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs md-tabs " role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="tab1" data-toggle="tab" href="#T1" role="tab"><i class="icofont icofont-upload"></i>Upload New Files</a>
                                    <div class="slide"></div>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="tab2" data-toggle="tab" href="#T2" role="tab"><i class="icofont icofont-download "></i>Download Or View Files </a>
                                    <div class="slide"></div>
                                </li>

                            </ul>
                            <!-- Tab panes -->
                            <div class="tab-content card-block">
                                <div class="tab-pane active" id="T1" role="tabpanel">
                                    <input type="hidden" id="Hd_Id" value="@ViewBag.Id" />
                                    <input type="hidden" id="Hd_DocId" value="@ViewBag.dtHead.Rows[0]["DOCNO"]" />
                                    <input type="hidden" id="Hd_IdDocType" value="@ViewBag.IdDocType" />
                                    <div class="card-block">
                                        <div class="file-loading">
                                            <input id="file-Uploder" type="file" multiple>
                                        </div>
                                    </div>
                                    @*<button type="reset" class="btn btn-outline-secondary">Reset</button>*@
                                </div>
                                <div id="kv-error-1" style="margin-top:10px;display:Block"></div>
                                <div id="kv-success-1" class="alert alert-success " style="margin-top:10px;display:none"></div>
                                
                                <div class="tab-pane" id="T2" role="tabpanel">
                                    <div class="card-block" id="IdDataList">




                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                    <!-- Row end -->
                </div>


            </div>
        </div>
    </div>
</div>


@section scripts{



    <link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
    <link href="~/libraries/fileupload/css/fileinput.css" media="all" rel="stylesheet" type="text/css" />
    @*<link href="~/libraries/fileupload/css/Filefontawesome.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" crossorigin="anonymous">
    <link href="~/libraries/fileupload/themes/explorer-fa5/theme.css" media="all" rel="stylesheet" type="text/css" />

    <script src="~/libraries/fileupload/js/plugins/buffer.min.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/js/plugins/filetype.min.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/js/plugins/piexif.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/js/plugins/sortable.js" type="text/javascript"></script>

    <script src="~/libraries/fileupload/js/fileinput.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/js/locales/fr.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/js/locales/es.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/themes/fa5/theme.js" type="text/javascript"></script>
    <script src="~/libraries/fileupload/themes/explorer-fa5/theme.js" type="text/javascript"></script>



    <script src="~/JsProject/commanJs.js"></script>
    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>
    <script src="~/libraries/msg/jquery-confirm.min.js"></script>

    <script src="~/Scripts/notify.min.js"></script>

 

    <script>


        $("#tab1").click(function () {

            $("#T1").addClass("active")
            $("#T2").removeClass("active")

        });
        $("#tab2").click(function () {
            blockUIStart();
            $("#T1").removeClass("active")
            $("#T2").addClass("active")
            var Data = {
                ID: $("#Hd_Id").val().trim()
            }
            debugger;
            var Rtn = httpPOST("/Common/GetFiles", Data, true)
            debugger;
            $("#IdDataList").empty().append(Rtn.data);
            $.unblockUI();

        });

        $(document).ready(function () {

            $("#file-Uploder").fileinput({
                'theme': 'explorer-fa5',
                'uploadUrl': '@Url.Action("UploadFiles")',
               uploadAsync: true,
                elErrorContainer: '#kv-error-1',
                showCancel: true,
                allowedFileExtensions: ['pdf', 'png','jpg','jpeg'],
                uploadExtraData: function () {
                    
                    return {
                       
                        ID: $("#Hd_Id").val().trim(),
                        PK_DocType: $("#Hd_IdDocType").val(),
                        DocNo: $("#Hd_DocId").val()

                        //ID: "1",
                        //PK_DocType: "DD",
                        //DocNo: "009D"
                    };
                },

            }).on('fileuploaded', function (event, data, id, index) {
                debugger;
                //if (Number(data.response.StatusCode) > 0) {
                //  //  msgSuccess("Uploaded Successfully");
                //}

            })
        });

        function delRow(Id) {
            $("#T1").removeClass("active")
            $("#T2").addClass("active")

            $.confirm({
                title: "Confirmation required",
                content: "Are you sure you want to delete?",
                buttons: {
                 
                    NO: function () {

                    },
                    YES: function () {

                        var Data = {
                            ID: Id
                        }
                        debugger;
                        var Rtn = httpPOST("/Common/DeleteFiles", Data, true)
                        debugger;
                        if (Number(Rtn.data.StatsCode) <= 0) {
                            msgError("Failed to delete" + Rtn.data.Message);
                        } else {
                            $.notify("File Delete Sucessfully", {
                                globalPosition: "right center",
                                className: "success"
                            })

                        }
                        $("#tab2").click();
                    },

                }
            });

           // $("#IdDataList").empty().append(Rtn.data);
        }

    </script>

}