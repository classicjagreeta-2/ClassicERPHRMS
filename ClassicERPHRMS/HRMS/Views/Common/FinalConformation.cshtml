<div class="modal fade" id="default-Modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Head Selection </h5>
                <button type="button" class="btn btn-danger HeadModelClose">X</button>
            </div>
            <div class="modal-body">
                <div class="j-unit">
                    <div class="j-input">
                        <div class="checkbox-zoom zoom-primary">
                            <div class="form-group">
                            </div>
                            <div class="checkbox-fade fade-in-primary">

                                <input type="hidden" id="HID" />
                                <input type="hidden" id="HFmId" />

                                <div id="lblCheckBoxList">

                                </div>



                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect HeadModelClose">Close</button>
                <button type="button" class="btn btn-primary  waves-effect btnpdfdownload">PDF</button>
                <button type="button" class="btn btn-primary  waves-effect btnSendMail"> <i class="icofont icofont-email"></i>Email</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="default-ModalEmail" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Head Selection </h5>
                <button type="button" class="btn btn-danger" data-dismiss="modal" id="x">X</button>
            </div>
            <div class="modal-body">
                <div class="j-unit">
                    <div class="j-input">
                        <div class="checkbox-zoom zoom-primary">
                            <div class="form-group">
                            </div>
                            <div class="checkbox-fade fade-in-primary">

                                <input type="hidden" id="HID" />
                                <input type="hidden" id="HFmId" />
                                <input type="hidden" id="HEmail" />
                                <div id="lblCheckBoxListEmail">

                                </div>



                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary  waves-effect btnSendMail"> <i class="icofont icofont-email"></i>Email</button>
            </div>
        </div>
    </div>
</div>

@section scripts{


    <script type="text/javascript" src="~/libraries/bower_components/bootstrap/js/bootstrap.min.js"></script>

    <script src="~/libraries/msg/jquery-confirm.min.js"></script>
    <script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>
    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>
    <script src="~/JsProject/TD_ReportModel.js"></script>
    <script src="~/JsProject/commanJs.js"></script>

    <script>

        $("#btnprintx").click(function () {
            blockUIStart();
            var Data = {
                ID: $('#txtID').val(),
                FmType: $('#txtfrmType').val(),
            }
            debugger;
            var Rtn = httpPOST("/TD_Report/TD_Report_Details", Data, true)
            if (Rtn.status != "OK") {
                //window.open('/TD_Report/TD_Report_Details', '_blank');
                $.unblockUI();
            } else {
                $.unblockUI();
                msgError("Error");
            }


        })


    </script>
}