        $('#frm_dt, #to_dt').change(function () {
            debugger
            var fromDate = new Date($('#frm_dt').val());
            var toDate = new Date($('#to_dt').val());

            var prevDate = new Date(fromDate);
            prevDate.setDate(prevDate.getDate() - 1);
            $('#prev_dt').val(prevDate.toISOString().split('T')[0]);

            var nextDate = new Date(toDate);
            nextDate.setDate(nextDate.getDate() + 1);
            $('#nxt_dt').val(nextDate.toISOString().split('T')[0]);
        });
        $('#frm_dt, #to_dt').change(function () {
