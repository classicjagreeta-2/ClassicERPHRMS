<div class="page-body">
    <div class="col-sm-12">
        <!-- Login card start -->
        <div class="card">
            @using (Html.BeginForm("HolidayList", "M_Holiday", FormMethod.Post))
            {

                @*<div class="modal-content">
                *@
                <div class="modal-header">

                    <div class="text-center" style="margin-left: 160px;"><h4>HOLIDAY LIST</h4></div>

                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="j-wrapperForm j-wrapper-640">

                        <div class="card-block">
                            <div class="row">
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">From Date :</label>
                                        @if (Model.FROM_DATE == ViewBag.NullDate)
                                        {
                                            @Html.EditorFor(x => x.FROM_DATE, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @type = "Date", @class = "form-control", @required = "required", @id = "frm_dt" } })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.FROM_DATE, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @id = "frm_dt" })
                                        }
                                        @*@Html.HiddenFor(x => x.FROM_DATE, "{0:yyyy-MM-dd}")*@
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">To Date :</label>
                                        @if (Model.TO_DATE == ViewBag.NullDate)
                                        {
                                            @Html.EditorFor(x => x.TO_DATE, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @type = "Date", @class = "form-control", @required = "required", @id = "to_dt" } })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.TO_DATE, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @id = "to_dt" })
                                        }

                                        @*@Html.HiddenFor(x => x.TO_DATE, "{0:yyyy-MM-dd}")*@
                                    </div>
                                    <div id="errorMessage" style="color: red;"></div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Previous Date :</label>
                                        @if (Model.FROM_DATE == ViewBag.NullDate)
                                        {
                                            @Html.EditorFor(x => x.PREV_DATE, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @type = "Date", @class = "form-control", @required = "required", @id = "prev_dt" } })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.PREV_DATE, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @id = "prev_dt" })
                                        }
                                        @*@Html.HiddenFor(x => x.FROM_DATE, "{0:yyyy-MM-dd}")*@
                                    </div>
                                </div>
                                <div class="col-sm-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Next Date :</label>
                                        @if (Model.TO_DATE == ViewBag.NullDate)
                                        {
                                            @Html.EditorFor(x => x.NEXT_DATE, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @type = "Date", @class = "form-control", @required = "required", @id = "nxt_dt" } })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.NEXT_DATE, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @id = "nxt_dt" })
                                        }

                                        @*@Html.HiddenFor(x => x.TO_DATE, "{0:yyyy-MM-dd}")*@
                                    </div>
                                    <div id="errorMessage" style="color: red;"></div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4">
                                    <label for="exampleInputName1">Attendance Code & Description :</label>
                                    @Html.DropDownListFor(x => x.FK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text"), "SELECT..",
                                    new { @class = "js-example-disabled-results col-sm-12", @required = "required" })
                                </div>
                                <div class="col-sm-8">
                                    <label for="exampleInputName1">Holiday Description:</label>
                                    @Html.TextBoxFor(x => x.DESCRIPTION, new { @type = "text", @class = "form-control col-sm-12", @maxlength = "30" })

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-primary pull-right aLoader" id="nextButton" type="submit" onclick="showLoading()">
                        Get <i class="fa fa-arrow-circle-o-right" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</div>


@if (ViewBag.HolidayList != null)

{
    <div class="modal-body">
        <div class="card" id="divcontainer">
            <div class="dt-responsive table-responsive">

                <form method="post" action="/M_Holiday/SubmitHolidayList">
                    <table id="ajax-table" class="table table-striped table-bordered nowrap" style="width:100%">
                        <thead>
                            <tr>
                                <th width="10%">Holiday Type</th>
                                <th width="10%">Holiday Date</th>
                            </tr>
                        </thead>
                        <tbody>

                            @if (ViewBag.HolidayList != null)
                            {

                                //var leaveList = ViewBag.LeaveList;

                                for (int i = 0; i < ViewBag.HolidayList.Count; i++)
                                {
                                    <tr class="RowTable">

                                        @if (ViewBag.HolidayList[i].LOCA == "AGR")
                                        {
                                            <td>
                                                @Html.DropDownListFor(x => x.FK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text", ViewBag.HolidayList[i].FK_ATTEND_CODE),
                                                    new { @class = "js-example-disabled-results col-sm-12", @id = "holi" + ViewBag.HolidayList[i].HOL_DATE, @disabled = "disabled" })
                                            </td>

                                        }
                                        else
                                        {
                                            <td>
                                                @Html.DropDownListFor(x => x.FK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text", ViewBag.HolidayList[i].FK_ATTEND_CODE),
                                                    new { @class = "js-example-disabled-results col-sm-12", @id = "holi" + ViewBag.HolidayList[i].HOL_DATE })
                                            </td>

                                        }

                                        <td> @ViewBag.HolidayList[i].HOL_DATE </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2"><center> No Data </center></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @*<button type="submit" class="btn btn-primary">Submit</button>*@
                    <div class="modal-footer">
                        <button class="btn btn-sm btn-primary pull-right aLoader" id="nextButton1" type="submit" onclick="showLoading()">
                            Submit <i class="fa fa-arrow-circle-o-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>


            </div>
        </div>
    </div>
}








