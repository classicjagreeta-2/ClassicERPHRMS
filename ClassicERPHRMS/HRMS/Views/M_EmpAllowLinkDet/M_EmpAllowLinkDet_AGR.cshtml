        <div class="col-md-4">
            <div class="form-group">
                <label> <input type="text" id="txt_FullName" disabled class="form-control" /> </label>-->
        @*<input type="text" id="txt_FullName" disabled class="form-control" />*@
        <!--</div>
            </div>

        </div>-->


    </div>
    <div class="card-block" id="divcontainer">
        <div class="dt-responsive table-responsive">
            <table id="ajax-table" class="table table-striped table-bordered nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th width="1%">Action</th>
                        <th width="10%">Allow Code</th>
                        <th width="10%">Allow Description</th>
                        <th width="10%">Amount</th>
                        @*<th width="10%">Amount %</th>
                            <th width="10%">Limit</th>*@
                        <th width="10%">Currency Code</th>
                        <th width="10%">Effected From</th>
                        <th width="10%">Active Status</th>
