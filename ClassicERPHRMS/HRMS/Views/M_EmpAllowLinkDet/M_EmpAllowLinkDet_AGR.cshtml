@section scripts{
    <script src="~/libraries/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/jszip.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/vfs_fonts.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/buttons.colVis.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>


    <script type="text/javascript" src="~/libraries/assets/js/modalEffects.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/classie.js"></script>
    <script src="~/libraries/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script src="~/Scripts/Notify/notify.js"></script>
    <script src="~/libraries/msg/jquery-confirm.min.js"></script>
    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>
    <script src="~/JsProject/commanJs.js"></script>
    <script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

    @*<link href="~/libraries/js/loader/easy-loading.css" rel="stylesheet" />

        <script src="~/libraries/Loader/waiting/bootstrap-waitingfor.js"></script>*@
    <script src="~/libraries/js/jsmomentDate.js"></script>
    <script src="~/JsProject/TD_Loder.js"></script>

    <script>
        var Popup, dataTable;


        $(document).ready(function () {

            // AddNewRecords

            var directUrl = '@Url.Action("AddEditModel", "M_EmpAllowLinkDet")';
            $("#IdaddNewRecord").click(function () {

                var data = {
                    Id: 0,
                    EmpId: $("#IdEmpId").val(),
                    Ucodee: $("#IdUcodee").val()

                };
                //var x = httpGetWithObj("/Master_AccountHead/AddEditModel", data);
                //$("#IdModal").empty().append(x.data);


                $.ajax({
                    type: "GET",
                    url: directUrl,
                    /*async: false,*/
                    data: data,
                    beforeSend: function () {
                        blockUIStart();
                    },
                    complete: function () {
                        $.unblockUI();
                    },
                    success: function (data) {
                        debugger;
                        $("#IdModal").empty().append(data);
                        $('#IdModal').modal('show');


                    },
                    error: function (errorjqXHR, exception) {
                        $.unblockUI();
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });

            });

             var TredirectUrl = '@Url.Action("GetEmpAllowLinkData", "M_EmpAllowLinkDet")';
             dataTable = $("#ajax-table").DataTable({
                initComplete: function () {
                    var input = $('.dataTables_filter input').unbind(),
                        self = this.api(),
                        $searchButton = $('<button>')
                            .text('search')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                self.search(input.val()).draw();
                            }),
                        $clearButton = $('<button>')
                            .text('clear')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                input.val('');
                                $searchButton.click();
                            })
                    $('.dataTables_filter').append($searchButton, $clearButton);
                },
                "proccessing": true,
                 "serverSide": true,
                 retrieve: true,
                 "language": {
                     'processing': '<i class="icofont icofont-spinner-alt-2 icofont-3x"></i>'
                 },
                 scrollY: '310px',
                 scrollX: true,
                 search: {
                    return: true,
                 },
                responsive: true,
                ajax: {
                    url: TredirectUrl,
                    type: "POST",
                    complete: function (data) {
                        debugger;
                        $("#lblname").html(data.responseJSON.FName);
                    /*    $("#lblunt").html(data.responseJSON.UName);*/
                    },
                },

                columns: [
                    {
                        "data": "m_EMP_ALLOW_DET.ID", "render": function (dt) {
                            return "<a class='btn btn-mini btn-info' data-toggle='modal'   onclick=PopupForm('" + dt + "')><i class='icofont icofont-pencil-alt-4 icofont-1x'></i></a>\
                            <a class='btn btn-mini btn-danger'  onclick=FnDelete('" + dt + "')><i class='fa fa-trash-o fa-lg'></i></a>";
                        },
                    },

                    { data: "m_EMP_ALLOW_DET.FK_ALL_CODE", "render": function (data) { return '\u200C' + data } },
                    { data: "m_ALLOWANCE.DESCRIPTION"},
                    { data: "m_EMP_ALLOW_DET.ALL_RS" },
                    //{ data: "m_EMP_ALLOW_DET.ALL_PERCENT" },
                    //{ data: "m_EMP_ALLOW_DET.ALL_LIMIT" },
                    { data: "m_EMP_ALLOW_DET.FK_CURR_CODE" },
                    { data: "m_EMP_ALLOW_DET.EFF_DATE", "render": function (data) { return parseDate(data) }},
                    { data: "m_EMP_ALLOW_DET.ACTIVE_STATUS" },
                    { data: "m_EMP_ALLOW_DET.DDATE", "render": function (data) { return parseDate(data) }},
                    //{ data: "m_EMP_ALLOW_DET.INCL_OT" },


                ],

                dom: 'lBfrtip',
                buttons: [{
                    extend: 'excelHtml5',
                    exportOptions: {
                        columns: ':visible'
                    }
                }],

                "language": {
                    "search": "",
                    "searchPlaceholder": "Search..."
                },

            });

            new $.fn.dataTable.FixedHeader(dataTable);
        });


        function parseDate(data) {
            if (data != null)
                return moment(data).format('DD/MMM/YYYY');
            return null;
        }



        function PopupForm(Id) {
            var Tre_direct_Url = '@Url.Action("AddEditModel", "M_EmpAllowLinkDet")';
            debugger;
            var data = { Id: Id };

            $.ajax({
                type: "GET",
                url: Tre_direct_Url,
                /*async: false,*/
                beforeSend: function () {
                    blockUIStart();
                },
                complete: function () {
                    $.unblockUI();
                },
                data: data,
                success: function (data) {

                    $("#IdModal").empty().append(data);
                    $('#IdModal').modal('show')

                },
                error: function (errorjqXHR, exception) {
                    $.unblockUI();
                    $('.btnClose').click();
                    $.notify("Error In Edit", {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }

            });
        }

        function SubmitForm(form) {
            $.validator.unobtrusive.parse(form);
            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })
                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');

                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }

            return false;

        }

        function FnDelete(id) {
        debugger;
        $.confirm({
            title: "Confirmation required",
            content: "Do you want to delete?",
            type: 'red',
            typeAnimated: true,
            buttons: {

                NO: function () {
                },
                YES: function () {
                    DeleteRecord(id);
                },
            }
        });

    }

    var Turl= '@Url.Action("Delete", "M_EmpAllowLinkDet")';
    function DeleteRecord(id) {
        debugger;
        $.ajax({
            type: "POST",
            url: Turl,
            data: { Id: id },
            beforeSend: function () {
                showLoading2("divcontainer","Deleting....")
            },
            complete: function () {
                HideLoading();
            },
            success: function (data) {
                debugger;
                if (data.success) {

                    dataTable.ajax.reload();
                    NotifyMsgSucc(data.message);


                }
                else {
                    NotifyMsgError(data.message + "\n" + data.details.Message )


                }
            },
            error: function (errorjqXHR, exception) {
                debugger;
                NotifyMsgError("Failed to delete")
            }

        });
    }

    function checkForDuplicate() {
        var enteredID = $('#idInput').val();

        // Perform an AJAX request to check if the entered ID already exists
        $.ajax({
            url: '../YourController/CheckForDuplicate',
            type: 'POST',
            data: { id: enteredID },
            success: function (response) {
                if (response.isDuplicate) {
                    alert('ID already exists. Please enter a different ID.');
                } else {
                    // If the ID is not a duplicate, submit the form
                    $('#myForm').submit();
                }
            },
            error: function () {
                alert('Error checking for duplicate ID.');
            }
        });
    }
    </script>

}







