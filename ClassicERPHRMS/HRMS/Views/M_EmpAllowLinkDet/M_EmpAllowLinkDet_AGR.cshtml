        </button>
        <a href=@Url.Action("Index","Menu") class="btn btn-sm btn-info">
            <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>Close
        </a>
        <div class="text-center" style="margin-top: -29px;"><h4>Employee Allowance Link Master</h4></div>
        <input type="hidden" value="@ViewBag.EmpId" id="IdEmpId" />
        <input type="hidden" value="@ViewBag.Ucodee" id="IdUcodee" />
        @*<p>Employee Name: <span id="employeeName">John Doe</span></p>*@
        <div class="modal-body">
            <div class="text-center">
                <div class="form-group">
                    <div class="text-accent-2"><h5>Employee Name and Code :- <strong id="lblname"></strong></h5></div>
                    @*<div class="text-accent-3" ><h5>Unit Name:- <strong id="lblunt"></strong></h5></div>*@
                </div>
            </div>
        </div>


        @*<div class="text-capitalize" style="margin-top: -1px;"><h4><label id="lblunt"></label></h4></div>*@


        @*<h4>@ViewBag.Name</h4>*@
        @*<h1>Welcome <span id="displayName"></span>!</h1>*@
