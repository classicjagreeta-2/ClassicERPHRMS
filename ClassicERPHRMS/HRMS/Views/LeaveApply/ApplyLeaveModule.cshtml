<script>



    $(document).ready(function () {
        // Get the leave data from ViewBag and parse it
        //var leaveData = Html.Raw(Json.Serialize(ViewBag.LeaveData));
        //var leaveData = Html.Raw(JsonSerializer.Serialize(ViewBag.LeaveData));
        var leaveData = @Html.Raw(leaveDataJson);

        // Prepare the chart data
        const chartData = {
            labels: leaveData.map(item => item.Description),
            data: leaveData.map(item => item.ReaminingLeave), // You can change this to use any other value you need
        };

        const myChart = document.querySelector("#Leave-Chat");
        const ul = document.querySelector(".Leave-Chat-Lable ul");

        new Chart(myChart, {
            type: "doughnut",
            data: {
                labels: chartData.labels,
                datasets: [
                    {
                        label: "Leave Allotted",
                        data: chartData.data,
                    },
                ],
            },
            options: {
                borderWidth: 5,
                borderRadius: 5,
                hoverBorderWidth: 0,
                maintainAspectRatio: true,
                responsive: false,
                cutoutPercentage: 0,
                plugins: {
                    legend: {
                        display: true,
                        position: 'right',
                    },
                    datalabels: {
                        display: true,
                    },
                    outlabels: {
                        text: '%l %p',
                        color: 'white',
                        stretch: 1,
                        font: {
                            resizable: false,
                            minSize: 12,
                            maxSize: 14
                        }
                    }
                },
                title: {
                    display: true,
                    text: "Leave Allocation Chart", // Update the title dynamically if needed
                },
                animation: {
                    animateScale: true,
                    animateRotate: true
                }
            }
        });

        // Populate the leave details below the chart
        const populateUl = () => {
            chartData.labels.forEach((l, i) => {
                let li = document.createElement("li");
                li.innerHTML = `${l}: <span class='percentage'>${chartData.data[i]}%</span>`;
                ul.appendChild(li);
            });
        };

        populateUl();
    });

    $('#Leave-table').DataTable({
        "scrollY": "170px",
        "scrollCollapse": true,
        "paging": false
    });
</script>









