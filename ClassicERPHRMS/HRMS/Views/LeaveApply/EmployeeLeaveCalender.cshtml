<body>
    <div class="modal fade" id="IdModal" role="dialog" data-backdrop="static" data-keyboard="false">
        <input type="hidden" id="startTime" />
        <input type="hidden" id="endTime" />
        <input type="hidden" id="eventTitle" />

        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                    <h4 class="modal-title">Alert Message</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <div class="container"></div>
                <div class="modal-body">

                    <div id="IdDivMsg" style="font-size:22px;color:red;">
                        Erorr In Edit
                    </div>
                    <br />
                    <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
                </div>
                <div class="modal-footer">
                    <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>
                </div>
            </div>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["SuccessMessage"]</strong>
            @*<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>*@
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@TempData["ErrorMessage"]</strong>
        </div>
    }
    <div id="calendar"></div>

    <div class="modal fade calendar_modal " id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                @*@using (Ajax.BeginForm("AppliedLeaveWithNoOfDays", "T_Lev_App"))*@
                @*@using (Ajax.BeginForm("AppliedLeaveWithNoOfDays", "T_Lev_App", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", OnFailure = "OnFailure" }))*@
                @*{*@
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Add an event</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="DivContainer">
                </div>
                @*}*@
            </div>
        </div>
    </div>

    <div class="modal fade" id="hrApprovalModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">HR Approval</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div> <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label>Leave Details:</label>
                            <p id="leaveDetails"></p>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" id="btnApprove" class="btn btn-success">Approve</button>
                            <button type="submit" id="btnReject" class="btn btn-danger">Reject</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="EmpApprovalModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Leave Application</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div> <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label>Applied Leave:</label>
                            <p id="leaveDetails"></p>
                        </div>
                        <div class="modal-footer">
                            <button id="btnCancel" class="btn btn-info">Cancel</button>
                            <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>

