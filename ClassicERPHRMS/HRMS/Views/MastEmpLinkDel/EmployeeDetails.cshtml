    <script src="~/libraries/bootstrapTale/src/extensions/fixed-columns/bootstrap-table-fixed-columns.js"></script>*@
<link href="~/libraries/assets/css/CheckBoxStyle.css" rel="stylesheet" />

<style>
    .modal-backdrop {
        opacity: 0.5 !important;
    }

    .dataTables_length {
        margin: 0px 0px -45px 6px;
    }

    div.dt-buttons {
        margin: 0px 0px 0px 188px;
    }


    .select2-container .select2-selection--single {
        height: 34px;
    }
</style>



<div class="modal fade" id="IdModal" role="dialog" data-backdrop="static" data-keyboard="false">

    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="container"></div>
            <div class="modal-body">

                <div id="IdDivMsg" style="font-size:22px;color:red;">
                    Erorr In Edit
                </div>
                <br />
                <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="myModal2">

    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="container"></div>
            <div class="modal-body">

                <div id="IdDivMsg" style="font-size:22px;color:red;"> </div>
                <br />
                <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>

            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header pull-right">
        <button id="IdaddNewRecord" type="button" class="btn btn-sm btn-info" data-toggle="modal" data-target="#IdModal">
            <i class="fa fa-plus-circle fa-lg" aria-hidden="true"></i>  Add New
        </button>
        <a href=@Url.Action("Index","Menu") class="btn btn-sm btn-info">
            <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>Close
        </a>
        <div class="text-center" style="margin-top: -29px;"><h4>Employee Link Details Master</h4></div>
        <div class="text-center"><h5>hahha</h5></div>
    </div>
    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="ajax-table" class="table table-striped table-bordered nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th width="1%">Action</th>
                        <th width="30%">Effective Date</th>
                        <th width="9%"> Unit Code</th>
                        <th width="30%">Category</th>
                        <th width="30%">Employee Type</th>
                        <th width="30%">Department</th>
                        <th width="30%">Sub Dept</th>
                        <th width="30%">Grade</th>
                        <th width="30%">Designation</th>
                        <th width="30%">Cost Centre</th>

                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


@section scripts{
    <script src="~/libraries/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/jszip.min.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/vfs_fonts.js"></script>
    <script src="~/libraries/assets/pages/data-table/extensions/buttons/js/buttons.colVis.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/libraries/bower_components/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>


    <script type="text/javascript" src="~/libraries/assets/js/modalEffects.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/classie.js"></script>
    <script src="~/libraries/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script src="~/libraries/msg/jquery-confirm.min.js"></script>
    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>
    <script src="~/JsProject/commanJs.js"></script>
    <script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

    <link href="~/libraries/js/loader/easy-loading.css" rel="stylesheet" />

    <script src="~/libraries/Loader/waiting/bootstrap-waitingfor.js"></script>


    <script>
        var Popup, dataTable;

        $(document).ready(function () {

            // AddNewRecords


            $("#IdaddNewRecord").click(function () {

                var data = { Id: 0 };
                //var x = httpGetWithObj("/MastEmp/AddEditModel", data);
                //$("#IdModal").empty().append(x.data);


                $.ajax({
                    type: "GET",
                    url: "../MastEmpLinkDel/AddEditModel",
                    async: false,
                    data: data,
                    success: function (data) {
                        $("#IdModal").empty().append(data);
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });

            });


            dataTable = $("#ajax-table").DataTable({

                initComplete: function () {

                    var input = $('.dataTables_filter input').unbind(),
                        self = this.api(),
                        $searchButton = $('<button>')
                            .text('search')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                self.search(input.val()).draw();
                            }),
                        $clearButton = $('<button>')
                            .text('clear')
                            .addClass('dt-button  buttons-html5')
                            .click(function () {
                                input.val('');
                                $searchButton.click();
                            })
                    $('.dataTables_filter').append($searchButton, $clearButton);
                },
                "proccessing": true,
                "serverSide": true,
                search: {
                    return: true,
                },
                responsive: true,
                ajax: {
                    url: "../MastEmpLinkDel/GetMastEmpLinkDel",
                    type: "POST"
                },

                columns: [
                    {
                        "data": "ID", "render": function (data) {
                            return "<a class='btn btn-sm btn-info' data-toggle='modal' data-target='#IdModal' onclick=PopupForm('" + data + "')><i class='icofont icofont-pencil-alt-4 icofont-1x'></i></a>";
                        },
                    },
                    /*{ data: parseInt("EFF_DATE".match(/\((\d+)\)/)[1]) },*/


                   /* { data: "EFF_DATE".match(/\((\d+)\)/)[1]},*/
                    /*{ data: "EFF_DATE"},*/
                    {
                        "data": "EFF_DATE",
                        "render": function (data) {
                            // Remove "/Date(" and ")/" and convert to milliseconds
                            var dateString = data.replace("/Date(", "").replace(")/", "");
                            var milliseconds = parseInt(dateString);

                            // Create a new Date object from milliseconds
                            var date = new Date(milliseconds);


                            // Format EFF_DATE as DD-MM-YYYY
                            var day = date.getDate();
                            var month = date.getMonth() + 1;
                            var year = date.getFullYear();
                            debugger;
                            return ("0" + day).slice(-2) + "-" + ("0" + month).slice(-2) + "-" + year;
                        },
                    },

                    { data: "FK_UNIT_CODE" },
                    { data: "FK_CAT_CODE" },
                    { data: "FK_EMP_TYPE" },
                    { data: "FK_DEPT_CODE" },
                    { data: "FK_SUB_DEPT_CODE" },
                    { data: "FK_GRADE_CODE" },
                    { data: "FK_DESG_CODE" },
                    { data: "FK_COST_CODE" },


                ],

                dom: 'lBfrtip',
                buttons: [{
                    extend: 'excelHtml5',
                    exportOptions: {
                        columns: ':visible'
                    }
                }],

                "language": {
                    "search": "",
                    "searchPlaceholder": "Search..."
                },

            });

            new $.fn.dataTable.FixedHeader(dataTable);
        });



        function PopupForm(Id) {
            var data = { Id: Id };

            $.ajax({
                type: "GET",
                url: "../MastEmpLinkDel/AddEditModel",
                async: false,
                data: data,
                success: function (data) {

                    $("#IdModal").empty().append(data);
                    waitingDialog.hide();

                },
                error: function (errorjqXHR, exception) {

                    $('.btnClose').click();
                    $.notify("Error In Edit", {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }

            });
        }

        function SubmitForm(form) {

            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })


                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');

                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }

            return false;

        }

        function Delete(id) {
            $.confirm({
                title: "Confirmation required",
                content: "Are you sure you want to delete?",
                buttons: {
                    YES: function () {

                        DeleteRecord(id);
                    },
                    NO: function () {

                    },
                }
            });
        }

        function DeleteRecord(id) {
            $.ajax({

                type: "POST",
                url: "../TD_OtherMaster/Delete",
                data: { Id: id },
                success: function (data) {

                    if (data.success) {

                        dataTable.ajax.reload();

                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "success"
                        })
                    }
                    else {
                        $("#IdDivMsg").empty().append(data.message);
                        $("#IdDivDeatils").empty().append(data.details);
                        // $("#divMsg").empty().append(data.details);
                        $("#myModal2").modal('show');

                    }
                },
                error: function (errorjqXHR, exception) {


                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }

            });
        }
    </script>

}

