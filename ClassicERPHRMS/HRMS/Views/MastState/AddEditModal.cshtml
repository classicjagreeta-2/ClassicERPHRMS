@model HRMS.Models.Master.M_STATE
@{
    ViewBag.Title = "AddEditModal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modal-dialog modal-lg" role="document">
    @using (Ajax.BeginForm("AddOrUpdate", "MastState", new AjaxOptions { }, new { Id = "myForm" }))
    {
        @Html.HiddenFor(x => x.id)
        <div class="modal-content" id="form_my">
            <div class="modal-header">
                <h4 class="modal-title">State Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        @if (Model.id != 0)
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">State Code :</label>
                                    @Html.TextBoxFor(x => x.pK_STATE_CODE, new { @class = "form-control mustfiled", @required = "required", @minlength = "3", @maxlength = "4", @readonly = true })
                                </div>
                                @Html.HiddenFor(x => x.id)
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">State Code :</label>
                                    @Html.TextBoxFor(x => x.pK_STATE_CODE, new { @class = "form-control mustfiled", @required = "required", @minlength = "3", @maxlength = "4" , @style = "text-transform:uppercase" })
                                </div>
                            </div>
                        }
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">State Name :</label>
                                @Html.TextBoxFor(x => x.name, new { @class = "form-control", @maxlength = "20", @required = "required", @id = "DESCN" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Short Description :</label>
                                @Html.TextBoxFor(x => x.descn, new { @class = "form-control", @maxlength = "20", @required = "required", @id = "DESCN" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Ptax Number :</label>
                                @Html.TextBoxFor(x => x.ptaX_NO, new { @class = "form-control", @maxlength = "20", @id = "DESCN" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">ESI Number :</label>
                                @Html.TextBoxFor(x => x.esI_NO, new { @class = "form-control", @maxlength = "20",  @id = "DESCN" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>
                <a href=@Url.Action("Index","MastState") class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</a>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>

