
@model HRMS.Models.TRN.T_LEAVE_APPLICATION

<div class="row">
    <div class="col-12 form-group">
        <label>Leave Type:</label>
        @*<input type="text" class="form-control" id="summary" name="summary" value="" placeholder="Summary">*@
        @Html.DropDownListFor(x => x.FK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text"),
                    "SELECT..", new { @class = "form-control", @id = "summary", @required = "required" })
        @Html.HiddenFor(x => x.FK_EMPCODE)
        @Html.HiddenFor(x => x.NO_OF_DAYS, new { @class = "form-control", @id = "NOOFDAYS", @readonly = "readonly" })
    </div>
    <div class="col-12 form-group">
        <label>Reason Of Leave :</label>
        @Html.DropDownListFor(x => x.FK_REASON_CODE, new SelectList(ViewBag.Reason, "Value", "Text"),
                     "SELECT..", new { @class = "form-control", @id = "ddlreason", @required = "required" })
    </div>
    <div class="col-12 form-group mb-3">
        <label>Remarks:</label>
        @Html.TextAreaFor(x => x.REMARKS, new { @class = "form-control", @id = "description" })
    </div>

    <div class="col-12 form-group text-right">
        <input hidden type="color" id="color" name="color" value="#ffc107" list="reds" oninput='onInput()' />
        <datalist id="reds">
            <option hidden>#ffc107</option>
        </datalist>
    </div>
    <div class="col-6 form-group">
        <label> Start Date</label>
        <div class="input-group datepicker">
            @Html.TextBoxFor(m => m.FROM_DATE, new { @class = "form-control datepicker", id = "start_date", placeholder = "start" })
            <span class="input-group-addon "><i class="fa fa-calendar" aria-hidden="true"></i></span>
        </div>
    </div>
    <div class="col-6 form-group">
        <label> End Date</label>
        <div class="input-group datepicker">
            @Html.TextBoxFor(m => m.TO_DATE, new { @class = "form-control datepicker", id = "end_date", placeholder = "End" })
            <span class="input-group-addon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
        </div>
    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        @*<button type="submit" id="btnSubmit1" class="btn btn-primary" onclick="onAddClick()">Add</button>*@
        <button type="submit" id="btnSubmit1" class="btn btn-primary">Add</button>
    </div>
  

</div>





