@*@using HRMS.Models.Master*@
@model HRMS.Models.TRN.T_LEAVE_APPLICATION

<form method="post" action="/T_Lev_App/AppliedLeave">
    <table id="ajax-table" class="table table-striped table-bordered nowrap" style="width:100%">
        <thead>
            <tr>
                <th width="10%">Leave Type</th>
                <th width="10%">Session</th>
                <th width="10%">Leave Date</th>
                <th width="10%">Reason of Leave</th>
            </tr>
        </thead>
        <tbody>

            @if (ViewBag.LeaveList != null)
            {

                //var leaveList = ViewBag.LeaveList;

                for (int i = 0; i < ViewBag.LeaveList.Count; i++)
                {
                    <tr class="RowTable">

                        @if (ViewBag.LeaveList[i].LOCA == "AGR")
                        {
                            <td>
                                @Html.DropDownListFor(x => x.FK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text", ViewBag.LeaveList[i].FK_ATTEND_CODE),
                                    new { @class = "js-example-disabled-results col-sm-12", @id = "leave" + ViewBag.LeaveList[i].LEAVE_DATE, @disabled = "disabled" })
                            </td>
                            <td>
                                @Html.DropDownListFor(x => x.SESSION, new SelectList(ViewBag.Session, "DESCN1", "DESCN", ViewBag.LeaveList[i].SESSION),
                               new { @class = "js-example-responsive col-sm-12", @id = "SESSION" + ViewBag.LeaveList[i].LEAVE_DATE, @disabled = "disabled" })

                            </td>
                        }
                        else
                        {
                            <td>
                                @Html.DropDownListFor(x => x.FK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text", ViewBag.LeaveList[i].FK_ATTEND_CODE),
                                    new { @class = "js-example-disabled-results col-sm-12", @id = "leave" + ViewBag.LeaveList[i].LEAVE_DATE })
                            </td>
                            <td>
                                @Html.DropDownListFor(x => x.SESSION, new SelectList(ViewBag.Session, "DESCN1", "DESCN", ViewBag.LeaveList[i].SESSION),
                               new { @class = "js-example-responsive col-sm-12", @id = "SESSION" + ViewBag.LeaveList[i].LEAVE_DATE })

                            </td>
                        }

                        <td> @ViewBag.LeaveList[i].LEAVE_DATE </td>
                        <td>
                            @Html.DropDownListFor(x => x.FK_REASON_CODE, new SelectList(ViewBag.Reason, "Value", "Text", ViewBag.LeaveList[i].FK_REASON_CODE),
                                new { @class = "js-example-disabled-results col-sm-12", @id = "reason" + ViewBag.LeaveList[i].LEAVE_DATE, @disabled = "disabled" })
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2"><center> No Data </center></td>
                </tr>
            }
        </tbody>
    </table>
    @*<button type="submit" class="btn btn-primary">Submit</button>*@
    <div class="modal-footer">
        <button class="btn btn-sm btn-primary pull-right aLoader" id="nextButton" type="submit" onclick="showLoading()">
            Submit <i class="fa fa-arrow-circle-o-right" aria-hidden="true"></i>
        </button>
    </div>
</form>
