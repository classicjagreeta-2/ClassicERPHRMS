
@model HRMS.Models.Master.MAST_ALLOWANCE



<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">


    @*@using (Ajax.BeginForm("StoreOrEdit", "Master_Item", new AjaxOptions
        { OnSuccess = "OnSuccess", OnBegin = "OnBegin" }, new { onsubmit = "return SubmitForm(this)" }))*@

    @using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))
    {

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">MASTER ALLOWANCE</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Unit* :</label>
                                @Html.TextBoxFor(x => x.UNIT, new { @class = "form-control mustfiled", @required = "required", @maxlength = "3" })

                            </div>
                            @Html.HiddenFor(x => x.ID)
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="exampleInputName1">Code* :</label>
                                @Html.TextBoxFor(x => x.ALL_CODE, new { @class = "form-control mustfiled", @required = "required", @maxlength = "50" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Description :</label>
                                @Html.TextBoxFor(x => x.DESCRIPTION, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Name :</label>
                                @Html.TextBoxFor(x => x.SHORT_NAME, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Calculation Mode :</label>
                                @Html.TextBoxFor(x => x.CALCULATION_MODE, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Transaction :</label>
                                @Html.TextBoxFor(x => x.TRANSACTION_MASTER, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">PF Number :</label>
                                @Html.TextBoxFor(x => x.INCL_PF, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">ESI Number :</label>
                                @Html.TextBoxFor(x => x.INCL_ESI, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">PTAX Number :</label>
                                @Html.TextBoxFor(x => x.INCL_PTAX, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">ESI Number :</label>
                                @Html.TextBoxFor(x => x.INCL_TAXABLE, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Voucher INCL :</label>
                                @Html.TextBoxFor(x => x.INCLUDE_VOUCHER, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Voucher Debit :</label>
                                @Html.TextBoxFor(x => x.VOUCHER_DEBIT, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Emp Welfare :</label>
                                @Html.TextBoxFor(x => x.EMP_WELFARE, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Voucher OT :</label>
                                @Html.TextBoxFor(x => x.VOUCHER_OT_AC, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Voucher Head :</label>
                                @Html.TextBoxFor(x => x.VOUCHER_HEAD, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">OT INCL :</label>
                                @Html.TextBoxFor(x => x.INCL_OT, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>
                <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>

<script src="~/libraries/assets/js/select2.js"></script>
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

<script>
    $('#btnSubmit').click(function (e) {
        e.preventDefault();
        var IstoVlidate = 'form';
        debugger;
        if ($(IstoVlidate).smkValidate()) {
            debugger;
            var dataString = new FormData($("#myForm").get(0));
            blockUIStart();
            // "StoreOrEdit", "Master_Customer"
            $.ajax({
                url: "../MastAllowance/StoreOrEdit",
                data: dataString,
                contentType: false,
                processData: false,
                cache: false,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    OnSuccess(data);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    debugger;
                    OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });


        }
    });
    function OnFailure() {
        $.unblockUI();
    }
    function OnBegin() {
        blockUIStart();
    }

    function OnSuccess(result) {

        $.unblockUI();
        if (result.success == false) {
            debugger;
            msgError(result.details);
            //$.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "Errror"
            //})

        } else {
            //msgSuccess(result.message);
            $('form').smkClear();
            $("#ddlaccounthead option:selected").val(null).trigger("change");

            $.confirm({

                title: 'Confirmation !!',
                type: 'green',
                content: result.message,
                typeAnimated: true,
                icon: 'icon-smiley',
                buttons: {

                    Okay: function () {
                        $("#btnclose").click();
                        dataTable.ajax.reload();

                    },
                    //cancel: function () {

                    //}
                }

            });

            //  debugger;
            // $("#ddlaccounthead").empty().trigger('change')
            // $("#ddlaccounthead option:selected").prop("selected", false);
            // $("#ddlaccounthead").selectpicker("refresh");
            // $.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "success"
            //})

        }

    }

    function OnFailure(result) {
        $.unblockUI();
    }
</script>

}


