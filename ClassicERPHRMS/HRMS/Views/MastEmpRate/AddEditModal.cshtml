                                new { @class = "js-example-disabled-results col-sm-12", @required = "required", @id = "curr_cd" })

                            </div>

                        </div>*@
                    @if (ViewBag.Loca != "AGR")
                    {
                        <div class="@(ViewBag.Loca == "AGR" ? "hidden-lg" : "col-md-12")">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">ADA/HRA %</label>
                                        @Html.TextBoxFor(x => x.HRA_PERCENT, new { @class = "form-control", @maxlength = "7", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">HRA Rs</label>
                                        @Html.TextBoxFor(x => x.HRA_RS, new { @class = "form-control", @min = "0", @required = "required", @maxlength = "17", @value = 0m })
                                    </div>
                                </div>
                                @*<div class="col-md-3">
                                        <div class="form-group">
                                            <label for="exampleInputName1">% On</label>
                                            @Html.TextBoxFor(x => x.HRA_FORMULA, new { @class = "form-control ", @maxlength = "20" })
                                        </div>
                                    </div>*@
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">VDA %</label>
                                        @Html.TextBoxFor(x => x.VDA_PERCENT, new { @class = "form-control", @maxlength = "7", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">VDA Rs</label>
                                        @Html.TextBoxFor(x => x.VDA_RS, new { @class = "form-control ", @maxlength = "17", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Conveyance %</label>
                                        @Html.TextBoxFor(x => x.CONVEYANCE_PERCENT, new { @class = "form-control ", @maxlength = "7", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Conveyance Rs</label>
                                        @Html.TextBoxFor(x => x.CONVEYANCE_RS, new { @class = "form-control ", @maxlength = "17", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">PTax Debit Manually</label>
                                        @*@Html.DropDownListFor(x => x.PTAX_MANUALLY, new SelectList(ViewBag.YesNo, "DESCN1", "DESCN", 0), "SELECT..", new { @class = "js-example-responsive col-sm-12" })*@

                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Yearly PTax Amount(Max)</label>
                                        @Html.TextBoxFor(x => x.MAXPTAX, new { @class = "form-control ", @maxlength = "16", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">ESI %</label>
                                        @Html.TextBoxFor(x => x.ESI_PERCENT, new { @class = "form-control ", @maxlength = "7", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">ESI Rs</label>
                                        @Html.TextBoxFor(x => x.ESI_RS, new { @class = "form-control ", @maxlength = "17", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
