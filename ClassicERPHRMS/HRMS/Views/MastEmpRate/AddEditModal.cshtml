                                        <label for="exampleInputName1">ESI Limit</label>
                                        @Html.TextBoxFor(x => x.ESI_LIMIT, new { @class = "form-control ", @maxlength = "17", @value = 0m })
                                    </div>
                                </div>


                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">PF</label>
                                        @Html.TextBoxFor(x => x.PF, new { @class = "form-control ", @maxlength = "7", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">EPF</label>
                                        @Html.TextBoxFor(x => x.EPF, new { @class = "form-control ", @maxlength = "10", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">FPF</label>
                                        @Html.TextBoxFor(x => x.FPF, new { @class = "form-control ", @maxlength = "10", @value = 0m })
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Superannuation Fund %</label>
                                        @Html.TextBoxFor(x => x.SA_FUND_PER, new { @class = "form-control ", @maxlength = "15", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Superannuation Fund Rs</label>
                                        @Html.TextBoxFor(x => x.SA_FUND_AMT, new { @class = "form-control ", @maxlength = "13", @value = 0m })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="exampleInputName1">Allow Arrear</label>

                                        @*@Html.DropDownListFor(x => x.ALLOW_ARR, new List<SelectListItem>()
                                            {
                                            new SelectListItem { Text = "Select Option" },
                                            new SelectListItem { Text = "Yes", Value = "Yes" },
                                            new SelectListItem { Text = "No", Value = "No" },
                                            }, new { @class = "form-control" })*@
                                    </div>
                                </div>
                            </div>
                        </div>
