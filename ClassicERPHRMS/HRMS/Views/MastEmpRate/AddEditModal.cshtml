

@model HRMS.Models.Master.M_EMPRATE

@{
    ViewBag.Title = "AddEditModel";
}


@using (Html.BeginForm("AddOrUpdate", "MastEmpRate", FormMethod.Post, new { id = "myForm" }))
{

    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Employee Rate Master:</h4> <h5>@ViewBag.DisplayName</h5>
            @*<button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>*@
        </div>
        <div class="modal-body">
            <div class="card-block">
                <div class="row">

                    @*@if (Model.ID == 0 && Model.FK_EMPCODE == null)
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Employee Code*</label>

                                    @Html.DropDownListFor(x => x.FK_EMPCODE, new SelectList(ViewBag.Emp2, "Value", "Text"), "SELECT..",
                                            new { @class = "js-example-disabled-results col-sm-12", @required = "required" })


                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="exampleInputName1">Employee Code*</label>
                                    @Html.DropDownListFor(x => x.FK_EMPCODE, new SelectList(ViewBag.EmpLst, "Value", "Text"),
                                           new { @class = "js-example-disabled-results col-sm-12", @required = "required", @Disabled = "disabled" })
                                    @Html.HiddenFor(x => x.FK_EMPCODE)
                                </div>

                            </div>
                        }*@

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="exampleInputName1">Date</label>
                            @Html.EditorFor(x => x.EDATE, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @type = "Date", @class = "form-control", @required = "required" } })
                            @Html.HiddenFor(x => x.UNIT)
                            @Html.HiddenFor(x => x.FK_EMPCODE)
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="exampleInputName1">Basic</label>
                            @Html.TextBoxFor(x => x.BASIC, new { @class = "form-control", @maxlength = "17", @required = "required", @value = 0m })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="exampleInputName1">DA Amount</label>
                            @Html.TextBoxFor(x => x.DA_RS, new { @class = "form-control ", @maxlength = "17", @required = "required", @value = 0m })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="exampleInputName1">DA %</label>
                            @Html.TextBoxFor(x => x.DA_PERCENT, new { @class = "form-control  ", @maxlength = "8", @value = 0m })
                        </div>
                    </div>
