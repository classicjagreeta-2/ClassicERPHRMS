                    <div class="modal-footer">
                        <div id="divMsg" class="text-danger"> </div>
                        <button type="button" class="btn btn-default waves-effect" id="btnclose" onclick="location.href='@Url.Action("MastEmpRate", "MastEmpRate")'" data-dismiss="modal">Close</button>

                        <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>

