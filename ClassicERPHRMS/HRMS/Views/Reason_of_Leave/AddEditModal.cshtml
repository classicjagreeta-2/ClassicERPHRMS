@model HRMS.Models.Master.M_REASON_OF_LEAVING
@using HRMS.Models.Master
@using System.Globalization;
@{
    ViewBag.Title = "AddEditModal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("AddOrUpdate", "Reason_of_Leave", FormMethod.Post, new { id = "myForm" }))
{
    @Html.HiddenFor(x => x.id)
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Reason Of Leave Master</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="card-block">
                <div class="row">
                    @if (Model.id != 0)
                    {
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Code :</label>
                                @Html.TextBoxFor(x => x.pK_CODE, new { @class = "form-control mustfiled", @required = "required", @maxlength = "2", @disabled = "disabled" })
                            </div>
                            @Html.HiddenFor(x => x.id)
                            @Html.HiddenFor(x => x.pK_CODE)
                        </div>
                    }
                    else
                    {
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Code :</label>
                                @Html.TextBoxFor(x => x.pK_CODE, new { @class = "form-control mustfiled", @required = "required", @maxlength = "2" })
                            </div>
                            @Html.HiddenFor(x => x.id)
                        </div>
                    }
                    <div class="col-md-5">
                        <div class="form-group">
                            <label for="exampleInputName1">Description :</label>
                            @Html.TextBoxFor(x => x.description, new { @class = "form-control", @maxlength = "30", @required = "required" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="exampleInputName1">Type :</label>                            
                            @Html.DropDownListFor(x => x.type, new SelectList(ViewBag.typeList, "Value", "Text"), "SELECT..", new { @class = "form-control", @required = "required",@type= "text"})
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div id="divMsg" class="text-danger"> </div>
            <a class="btn btn-default waves-effect" onclick="location.href='@Url.Action("Reason_of_Leave","Reason_of_Leave")'" id="btnclose" data-dismiss="modal"
               style="color: white;background-color: red;">Close</a>
            <button name="submit" type="submit" id="nextButton1" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>Submit</button>
        </div>
    </div>
}

