                                    @*@using (Html.BeginForm("CompanySelectionNav", "Module", FormMethod.Post))*@
                                    {
                                    <div class="media userlist-box" data-id="1" data-status="online" data-username="Company" data-toggle="tooltip" data-placement="left" title="" data-original-title="Company">
                                        <div class="media-body">
                                            <div class="f-13 chat-header">Company</div>
                                            @if (companyList != null)
                                            {
                                                @Html.DropDownList("CompanyName", new SelectList(companyList, "Value", "Text", SelectedCompany), // value that should be set selected of dropdown
                                                                   new
                                                                   {
                                                                       @class = "form-control js-dropdown",
                                                                       @required = "required",
                                                                       //onchange = "document.forms[0].submit();"
                                                                   })
                                            }
                                        </div>
                                    </div>
                                    <div class="media userlist-box" data-id="2" data-status="online" data-username="Location" data-toggle="tooltip" data-placement="left" title="" data-original-title="Location">
                                        <div class="media-body">
                                            <div class="f-13 chat-header">Location</div>
                                            @if (locationList != null)
                                            {
                                                @Html.DropDownList("LocationName", new SelectList(locationList, "Value", "Text", SelectedLocation), // value that should be set selected of dropdown
                                                     new
                                                     {
                                                         @class = "form-control js-dropdown",
                                                         @required = "required",
                                                         //onchange = "document.forms[0].submit();"
                                                     })
                                            }
                                        </div>
                                    </div>
                                    <div class="media userlist-box" data-id="3" data-status="online" data-username="financialYear" data-toggle="tooltip" data-placement="left" title="" data-original-title="Financial Year">
                                        <div class="media-body">
                                            <div class="f-13 chat-header">Financial Year</div>
                                            @if (financialYearList != null)
                                            {
                                                @Html.DropDownList("FinancialYear", new SelectList(financialYearList, "Value", "Text", SelectedfinancialYear), // value that should be set selected of dropdown
                                                       new
                                                       {
                                                           @class = "form-control js-dropdown",
                                                           @required = "required",
                                                           //onchange = "document.forms[0].submit();"
                                                       })
                                            }
                                        </div>
                                    </div>
                                    }
                                </div><div class="slimScrollBar" style="background: rgb(27, 139, 249); width: 7px; position: absolute; top: 0px; opacity: 0.4; display: none; border-radius: 7px; z-index: 99; right: 1px; height: 471px;"></div><div class="slimScrollRail" style="width: 7px; height: 100%; position: absolute; top: 0px; display: none; border-radius: 7px; background: rgb(51, 51, 51); opacity: 0.2; z-index: 90; right: 1px;"></div>
                            </div>
                        </div>
