            <div id="sidebar" class="users p-chat-user showChat" style="display: none;">
                @{
                    var companyList = Session["companyList"] as IEnumerable<SelectListItem>;
                    var locationList = Session["locationList"] as IEnumerable<SelectListItem>;
                    var financialYearList = Session["financialYearList"] as IEnumerable<SelectListItem>;
                    var SelectedCompany = Session["SelectedCompany"] as string;
