@*@using WEB_PRO17.Common*@




<head>
    <title> @ViewBag.PageName</title>
    <link href="~/src/selectstyle.css" rel="stylesheet">
    <link rel="icon" href="libraries/assets/images/favicon.ico" type="image/x-icon">
    <!-- Google font-->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,800" rel="stylesheet">
    <!-- Required Fremwork -->
    <link rel="stylesheet" type="text/css" href="~/libraries/bower_components/bootstrap/css/bootstrap.min.css">
    <!-- themify-icons line icon -->
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/icon/themify-icons/themify-icons.css">
    <!-- ico font -->
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/icon/icofont/css/icofont.css">
    <!-- feather Awesome -->
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/icon/feather/css/feather.css">
    <!-- Select 2 css -->
    <link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
    <!-- Multi Select css -->
    <link rel="stylesheet" type="text/css" href="~/libraries/bower_components/bootstrap-multiselect/css/bootstrap-multiselect.css">
    <link rel="stylesheet" type="text/css" href="~/libraries/bower_components/multiselect/css/multi-select.css">
    <!-- Style.css -->
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/css/jquery.mCustomScrollbar.css">

    <!-- jpro forms css -->
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/j-pro/css/demo.css">
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/j-pro/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/j-pro/css/j-pro-modern.css">

    <!-- Switch component css -->
    <link rel="stylesheet" type="text/css" href="~/libraries/bower_components/switchery/css/switchery.min.css">

    <!-- Tags css -->
    <link rel="stylesheet" type="text/css" href="~/libraries/bower_components/bootstrap-tagsinput/css/bootstrap-tagsinput.css">

    <style>
        .select2-container--default .select2-selection--single {
            color: #fff;
            height: 41px;
        }

        .j-wrapperForm {
            margin: 0 auto;
            outline: none;
            padding: 40px 15px;
            /*-webkit-box-sizing: content-box;*/
            -moz-box-sizing: content-box;
            /*box-sizing: content-box;*/
        }

        input[type="checkbox"] {
            background-color: #fff;
            margin: 0;
            font: inherit;
            color: currentColor;
            width: 1.5em;
            height: 1.5em;
            border: 0.15em solid currentColor;
            border-radius: 0.15em;
            transform: translateY(-0.075em);
            border: 2px solid #01a9ac;
        }

        .shade {
            -webkit-box-shadow: 0px 10px 13px -7px #000000, -6px 2px 23px 5px rgba(14,0,166,0.44);
            box-shadow: 0px 10px 13px -7px #000000, -6px 2px 23px 5px rgba(14,0,166,0.44);
        }
    </style>
</head>

<div class="page-body">



    <div class="col-sm-12">

        <!-- Login card start -->
        <div class="card">
            @using (Html.BeginForm("UnitStore", "UnitSelect", FormMethod.Post))
            {
                <div class="card-block">
                    <div class="j-wrapperForm j-wrapper-640">

                        <!-- end /.header -->
                        <div class="j-content">
                            <!-- start login -->


                            <div class="col-sm-12">
                                <label>SELECT UNIT</label>
                                <div class="input-group input-group-button">

                                  

                                    @Html.DropDownList("ddlUnit", new SelectList(ViewBag.loctionlst,
                                   "PK_CODE", "NAME"),"SELECT..", new {@class = "js-example-responsive col-sm-12"  })

                                    <button class="input-group-warning btn btn-warning" id="btnNext" type="submit">
                                        <span class="">NEXT</span>
                                    </button>

                                </div>
                            </div>

                        </div>


                    </div>
                </div>
                <!-- Login card end -->
            }
        </div>
    </div>

</div>
@section scripts{


    <script type="text/javascript" src="~/libraries/bower_components/bootstrap/js/bootstrap.min.js"></script>

    <!-- Editable-table js -->
    <script type="text/javascript" src="~/libraries/assets/pages/edit-table/jquery.tabledit.js"></script>
    <script type="text/javascript" src="~/libraries/assets/pages/edit-table/editable.js"></script>

    <script type="text/javascript" src="~/libraries/assets/pages/ace-editor/ace-editor-custom.js"></script>

    <!-- Select 2 js -->
    <script type="text/javascript" src="~/libraries/bower_components/select2/js/select2.full.min.js"></script>
    <!-- Multiselect js -->
    <!-- Custom js -->
    <script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
    <script src="~/libraries/assets/js/pcoded.min.js"></script>


    <script src="~/Scripts/notify.min.js"></script>

    <script type="text/javascript" src="~/libraries/bower_components/sweetalert/js/sweetalert.min.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/modal.js"></script>
    <!-- sweet alert modal.js intialize js -->
    <!-- modalEffects js nifty modal window effects -->
    <script type="text/javascript" src="~/libraries/assets/js/modalEffects.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/classie.js"></script>

    <script type="text/javascript" src="~/libraries/assets/js/script.js"></script>

    <!-- Accordion js -->
    <script type="text/javascript" src="~/libraries/assets/pages/accordion/accordion.js"></script>

    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>

    <script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

    <script src="~/libraries/msg/jquery-confirm.min.js"></script>

    <script src="~/JsProject/commanJs.js"></script>




}




