                        @*@using (Ajax.BeginForm("StoreOrEdit", "Master_Item", new AjaxOptions
                            { OnSuccess = "OnSuccess", OnBegin = "OnBegin" }, new { onsubmit = "return SubmitForm(this)" }))*@

                        @*@using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))*@
                        @using (Html.BeginForm("GetCode", "EmpDeductLink", FormMethod.Post))
                        {

                            <div class="modal-content">
                                <div class="modal-header">
                                    <h4 class="text-center" style="margin-left: 180px;">Employee Deduction Link Master</h4>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <div class="card-block">
                                        <div class="row">

                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="exampleInputName1">Employee Code And Name:</label>
                                                    @*@Html.TextBoxFor(x => x.DESCRIPTION, new { @class = "form-control mustfiled", @required = "required", @maxlength = "4", @disabled = "disabled" })*@

                                                    @{
                                                        var empList = ViewBag.Emp as List<M_EMPMAS>; // Assuming ViewBag.Emp is of type List<Employee>
                                                        var empSelectList = empList.Select(item => new SelectListItem { Text = item.PK_EMPCODE + " " + " - " + item.TITLE + " " + item.FNAME + " " + item.MNAME + " " + item.LNAME + " ", Value = item.PK_EMPCODE.ToString() }).ToList();
                                                        empSelectList.Insert(0, new SelectListItem { Text = "SELECT..", Value = "" });
                                                    }

                                                    @Html.DropDownListFor(x => x.FK_EMPCODE, empSelectList, new { @class = "js-example-disabled-results col-sm-12", @id = "ddlEmp", @required = "required" })
                                                    @*@Html.DropDownListFor(x => x.FK_EMPCODE, new SelectList(ViewBag.DropdownListEmpMode, "PK_EMPCODE", "PK_EMPCODE"),
                                                        "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @required = "required", @Id = "ddlEmp" })*@
                                                </div>
                                            </div>
                                            @if (ViewBag.Loca != "AGR")
                                            {
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <div class="form-group">
                                                        <label for="exampleInputName1">Unit Code And Unit Description :</label>
                                                        @*@Html.TextBoxFor(x => x.FK_EMPCODE, new { @class = "form-control mustfiled", @required = "required", @maxlength = "4", @disabled = "disabled" })*@
                                                        @*@Html.DropDownListFor(x => x.UNIT, new SelectList(ViewBag.DropdownListUnitMode, "CODE", "CODE"),
                                                            "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @required = "required", @Id = "ddlUnit" })*@
                                                        @{
                                                            var unitList = ViewBag.Unit as List<M_UNIT>; // Assuming ViewBag.Emp is of type List<Employee>
                                                            var unitSelectList = unitList.Select(item => new SelectListItem { Text = item.CODE + " " + " - " + item.NAME, Value = item.CODE.ToString() }).ToList();
                                                            unitSelectList.Insert(0, new SelectListItem { Text = "SELECT..", Value = "" });
                                                        }
                                                        @Html.DropDownListFor(x => x.UNIT, unitSelectList, new { @class = "js-example-disabled-results col-sm-12", @id = "ddlUnit", @required = "required" })
                                                    </div>
                                                </div>
                                            </div>
                                            }
                                        


                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <div id="divMsg" class="text-danger"> </div>
                                    <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>

                                    <button type="submit" class="btn btn-primary pull-right" id="nextButton">NEXT</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
