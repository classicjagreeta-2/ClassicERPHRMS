    <script>

        $(document).ready(function () {
            $('#btnclose').click(function () {
                // Navigate back using JavaScript history
                window.history.back();
            });
        });

    $("#ddlEmp").change(function () {

        var UrlData ='@Url.Action("GetEmplyData", "EmpDeductLink")';
        var EmpCode = $(this).val();
        var Obj = {};
        Obj.Id = EmpCode;
        var Rtn = httpPOST(UrlData, Obj, true)
        debugger;

        var FullName = Rtn.data.TITLE + ' ' + Rtn.data.FNAME + ' ' + Rtn.data.MNAME + ' ' + Rtn.data.LNAME;
        $("#txt_FullName").val(FullName);

       // alert(FullName);
    });

        $("#ddlUnit").change(function () {

        var UrlData ='@Url.Action("GetUnitData", "EmpAllowLink")';
        var Code = $(this).val();
        var Obj = {};
        Obj.Id = Code;
        var Rtn = httpPOST(UrlData, Obj, true)
        debugger;

        var Name = Rtn.data.NAME + '';
        $("#txt_UnitDescription").val(Name);

       // alert(FullName);
    });


    function OnFailure() {
        $.unblockUI();
    }
    function OnBegin() {
        blockUIStart();
    }



    </script>
