
@model HRMS.Models.TRN.T_DAILY_ATTEND
@{
    ViewBag.Title = "Index";
}


<style>
    .top-buffer {
        margin-top: 20px;
    }
</style>


<div style="text-align:center "><b> Daily Attendance Retrieval From Bio-Metric</b></div>
<div class="page-body">
    <div class="row">
        <div class="col-sm-12">

            <div class="card">

                <div class="card-block">
                    <div class="row">
                        <div class="col-sm-1">
                            <label class="col-form-label">Date</label>
                        </div>
                        <div class="col-sm-3">
                            <input type="date" class="form-control date2">
                        </div>
                        <div class="col-sm-2">

                            @Html.RadioButton("COMPANY", "Y", new { @id = "company" })
                            <label for="html">OptionI</label><br>
                        </div>
                        <div class="col-sm-2">
                            @Html.RadioButton("COMPANY", "N", new { @id = "nonCompany" })
                            <label for="html">OptionII</label><br>
                        </div>

                        <div class="col-sm-2">
                            @Html.RadioButton("COMPANY", "N", new { @id = "nonCompany" })
                            <label for="html">OptionIII</label><br>
                        </div>
                    </div>
                    <div class="row top-buffer">
                        <div class="col-sm-1">
                            <label class="col-form-label">Unit</label>
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("UNIT", new SelectList(ViewBag.AllowCal2 ?? new List<SelectListItem>(), "Value", "Text"), "SELECT..",
                           new { @class = "form-control js-example-data-array", @id = "unit" })
                           
                        </div>
                        <div class="col-sm-4">
                            @*<input type="text" class="form-control date2">*@
                            <label class="col-form-label"></label>
                        </div>
                    </div>
                    <div class="row top-buffer ">
                        <div class="col-sm-3">
                           
                        </div>
                        <div class="col-sm-3">
                            <input class="form-control " type="file" id="formFile">
                            @* <input type="file" name="files[]" id="filer_input" multiple="multiple">*@
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="btn btn-primary">Retrieve</button>
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="btn btn-primary">Cancel</button>
                        </div>
                    </div>
                </div>


                <div class="card">

                    <div class="card-block">
                        <div class="row">
                            <div class="col-xs-12 col-sm-12">
                                <table id="dom-jqry" class="table table-striped table-bordered nowrap dataTable" style="width: 100%;" role="grid" aria-describedby="dom-jqry_info">
                                    <thead>
                                        <tr role="row">
                                            <th width="1%"></th>
                                            <th width="10%">Shift</th>
                                            <th width="10%">Last Retrieval Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
