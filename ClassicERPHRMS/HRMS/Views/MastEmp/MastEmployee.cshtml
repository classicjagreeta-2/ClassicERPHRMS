@model PagedList.IPagedList<HRMS.Models.Master.M_EMPMAS>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@{
    ViewBag.Title = "Employee Master";
}

<div class="page-body">
    <div class="card">
        <div class="card-header pull-right">
            <button id="IdaddNewRecord" type="button" onclick="location.href='@Url.Action("AddEditModal", "MastEmp")'" class="btn btn-sm btn-info aLoader" data-toggle="modal">
                <i class="fa fa-plus-circle fa-lg" aria-hidden="true"></i>  Add New
            </button>
            <a href=@Url.Action("CommonDashBoard","CommonDashBoard") class="btn btn-sm btn-info">
                <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>Close
            </a>
            <div class="text-center" style="margin-top: -29px;"><h4>Employee Master</h4></div>
        </div>
        <div class="card-block">
            <div class="table-responsive dt-responsive">
                <div id="dom-jqry_wrapper" class="dataTables_wrapper dt-bootstrap4">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-sm-12 col-md-6">
                            <div class="dataTables_length" id="dom-jqry_length">
                                @using (Html.BeginForm("Index", "MastEmp", FormMethod.Get))
                                {
                                    <label>
                                        Show
                                        <select name="pageSize" onchange="document.forms[0].submit();" aria-controls="dom-jqry" class="form-control input-sm" fdprocessedid="794bn7">
                                            <option value=25>25</option>
                                            <option value=50>50</option>
                                            <option value=100>100</option>
                                        </select>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-6">
                            <div id="dom-jqry_filter" class="dataTables_filter">
                                @using (Html.BeginForm("Index", "MastEmp", FormMethod.Get))
                                {
                                    <label> Search:@Html.TextBox("SearchString", ViewBag.CurrentFilter as string, new { @class = "form-control input-sm" })</label>
                                    <button type="submit" class="btn btn-sm btn-info aLoader"> Search</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-12">
                            <table id="dom-jqry" class="table table-striped table-bordered nowrap dataTable" style="width: 100%;" role="grid" aria-describedby="dom-jqry_info">
                                <thead>
                                    <tr role="row">
                                        <th width="1%">Action</th>
                                        <th width="10%">Code</th>
                                        <th width="30%">First Name</th>
                                        <th width="20%">Last Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            @*<td>
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.id }) |
                                                    @Html.ActionLink("Details", "Details", new { id = item.id }) |
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.id })
                                                </td>*@
                                            <td class="sorting_1">
                                                @*<a class="btn btn-mini btn-info" data-toggle="modal" onclick="$('#IdModal').modal('show')">*@
                                                <a class="btn btn-mini btn-info" data-toggle="modal" onclick="location.href='@Url.Action("AddEditModal", "MastEmp",new {Id = item.id})'">
                                                    <i class="icofont icofont-pencil-alt-4 icofont-1x"></i>
                                                </a>
                                                <a class="btn btn-mini btn-danger" onclick="FnDelete('2')">
                                                    <i class="fa fa-trash-o fa-lg">
                                                    </i>
                                                </a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.loca)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.fname)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.lname)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-5">
                            <div class="dataTables_info" id="dom-jqry_info" role="status" aria-live="polite"> Showing @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-7">
                            <div class="dataTables_paginate paging_simple_numbers" id="dom-jqry_paginate">
                                @Html.PagedListPager(Model, page => Url.Action("Index",
                                new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="errorModal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="container"></div>
            <div class="modal-body">

                <div id="IdDivMsg" style="font-size:22px;color:red;">
                    Error In Edit
                </div>
                <br />
                <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>

            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="myModal2">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="container"></div>
            <div class="modal-body">

                <div id="IdDivMsg" style="font-size:22px;color:red;"> </div>
                <br />
                <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>

            </div>
        </div>
    </div>
</div>



