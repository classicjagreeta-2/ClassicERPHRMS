<script>
    $(document).ready(function () {
        $('#NUMBER').on('input', function () {
            var mobileNo = $(this).val();
            if (mobileNo.length != 10) {
                $('#NUMBER').addClass('is-invalid');
            }
            else {
                $('#NUMBER').removeClass('is-invalid');
            }
        });
    });</script>
