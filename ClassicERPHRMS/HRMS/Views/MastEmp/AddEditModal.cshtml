<script>
    $(document).ready(function () {
        debugger
        $('#Passport_renew_date').blur(function () {

            debugger
            if ($('#Passport_renew_date').val() < $('#Passport_issued_on').val()) {
                alert("Invalid Date Range");

                $('#Passport_renew_date').prop('value', true)
            }

        });
    });
    $(document).ready(function () {
        $("#Passport_issued_on, #Passport_renew_date,#Date_of_leaving_EPF,#Date_of_joining_EPF,#Date_of_leaving_EPS,#Date_of_joining_EPS,#Date_of_joining,#DATEOFBIRTH,#Date_of_Joining_gratuity,#Transfer_date").on("input", function () {
            var inputValue = $(this).val();
            var validDatePattern = /^\d{4}-\d{2}-\d{2}$/;

            if (!validDatePattern.test(inputValue)) {
                $(this).val(""); // Clear the input if it doesn't match the pattern
            }
        });
    });
</script>
