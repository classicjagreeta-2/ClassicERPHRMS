@model HRMS.Models.Master.M_ALLOWANCE
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modal-dialog modal-lg" role="document">
    @using (Ajax.BeginForm("AddOrUpdate", "M_Allowance", new AjaxOptions { }, new { Id = "myForm" }))
    {
        @Html.HiddenFor(x => x.id)
        <div class="modal-content" id="form_my">
            <div class="modal-header">
                <h4 class="modal-title">Allowance Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        @if (Model.id != 0)
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Allowance Code :</label>
                                    @Html.TextBoxFor(x => x.pK_alL_CODE, new { @class = "form-control mustfiled", @required = "required", @minlength = "4", @maxlength = "4", @style = "text-transform:uppercase", @readonly = true })
                                </div>
                                @Html.HiddenFor(x => x.pK_alL_CODE)
                               
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Allowance Code :</label>
                                    @Html.TextBoxFor(x => x.pK_alL_CODE, new { @class = "form-control mustfiled", @required = "required", @style = "text-transform:uppercase", @minlength = "4", @maxlength = "4" })
                                </div>
                            </div>
                        }
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Description :</label>
                                @Html.TextBoxFor(x => x.description, new { @class = "form-control", @maxlength = "20", @required = "required", @id = "DESCN" })
                            </div>
                        </div>
                        @if (Model.id == 0)
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Unit :</label>
                                    @Html.DropDownListFor(x => x.unit, new SelectList(ViewBag.Unit, "Value", "Text"), "SELECT..",
                                    new { @class = "form-control", @required = "required", @id = "unt" })
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Unit :</label>
                                    @Html.TextBoxFor(x => x.description, new { @class = "form-control", @id = "DESCN" , @readonly = true })
                                </div>
                                @Html.HiddenFor(x => x.unit)
                            </div>
                        }
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Calculation Mode :</label>                               
                                @Html.DropDownListFor(x => x.fK_CALC_MODE, new SelectList(ViewBag.AllowCal, "Value", "Text"),
                                "SELECT..", new { @class = "form-control", @id = "CALCULATION_MODE", @required = "required" })
                            </div>
                            @Html.HiddenFor(x => x.fK_CALC_MODE)
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Short Name :</label>
                                @Html.TextBoxFor(x => x.shorT_NAME, new { @class = "form-control", @maxlength = "12" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Voucher Head Code:</label>
                                @Html.TextBoxFor(x => x.voucheR_HEAD, new { @class = "form-control", @maxlength = "3", @id = "voucherhead" })
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group hidden-lg">
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.CheckBoxFor(x => x.incL_PF)
                                        <span>PF</span>
                                    </div>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.CheckBoxFor(x => x.incL_ESI)
                                        <span>ESI</span>
                                    </div>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.CheckBoxFor(x => x.incL_PTAX)
                                        <span>PTAX</span>
                                    </div>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.CheckBoxFor(x => x.incL_TAXABLE)
                                        <span>Income Tax</span>
                                    </div>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>
                                        @Html.CheckBoxFor(x => x.incL_OT)
                                        <span>OT</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>               
                <a  class="btn btn-default waves-effect" onclick="location.href='@Url.Action("Index","M_Allowance")'" id="btnclose" data-dismiss="modal" 
                   style="color: white;background-color: red;">Close</a>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>



