    <script src="~/libraries/MultiSelectDropDown/bootstrap-select.js"></script>

    <script src="//cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.12.4/css/bootstrap-select.min.css"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.12.4/js/bootstrap-select.min.js"></script>

    <!--<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>-->
    <!-- Include Select2 JS -->
    <!--<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>-->

    <script src="~/libraries/assets/js/select2.js"></script>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <!-- Include Select2 JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <!-- Multiselect js -->
    <!-- Custom js -->
    <script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
    <script src="~/libraries/assets/js/pcoded.min.js"></script>

    <script>

        $("#btnSubmit").click(function () {
            //alert('');
            debugger;
            MCode = $("#ddlMonth").val() ;
            MUnit = $("#ddlUnit").val() || "";
            MDpartCode = $("#ddlDeptCode").val() || "";
            MEmp = $('#ddlEmp').val() || "";
            MType = $('#report').prop('checked');


            var DirectUrl = '@Url.Action("Report_Payroll_PaySlip", "Report_Payroll")' + '?MonthCode=' + MCode + '&Unit=' + MUnit + '&DpartCode=' + MDpartCode + '&RptType=' + MType +'&EmpCode='+MEmp;
            var link = document.createElement('a');
            link.href = DirectUrl;
            link.target = "_blank";
            document.body.appendChild(link);
            link.click();
        })
        setTimeout(function () { $('.alert').alert('close'); }, 5000);
        $(document).ready(function () {
            // Initialize Select2
            $('#ddlEmp').select2({
                placeholder: 'Select employees',
                closeOnSelect: false, // Keep the dropdown open after selection
                allowClear: true, // Allow clearing selection
                templateResult: function (data) {
                    if (!data.element) {
                        return data.text;
                    }
                    var $element = $(data.element);
                    var text = $element.text();
                    var $result = $('<span></span>');
                    $result.text(text);
                    return $result;
                }
            });
        });
    </script>
}











