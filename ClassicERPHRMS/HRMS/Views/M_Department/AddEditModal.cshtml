@model HRMS.Models.Master.M_DEPARTMENT
@using HRMS.Models.Master
@using System.Globalization;
@{
    ViewBag.Title = "AddEditModal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("AddOrUpdate", "M_Department", FormMethod.Post, new { id = "myForm" }))
{
    @Html.HiddenFor(x => x.id)
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Department Master</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="card-block">
                <div class="row">
                    @if (Model.id != 0)
                    {
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Department Code :</label>
                                @Html.TextBoxFor(x => x.pK_DEPT_CODE, new { @class = "form-control mustfiled", @required = "required", @minlength = "3", @maxlength = "4", @disabled = "disabled" })
                            </div>
                            @Html.HiddenFor(x => x.id)
                            @Html.HiddenFor(x => x.pK_DEPT_CODE)
                        </div>
                    }
                    else
                    {
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Department Code :</label>
                                @Html.TextBoxFor(x => x.pK_DEPT_CODE, new { @class = "form-control mustfiled", @required = "required",  @style = "text-transform:uppercase", @minlength = "3", @maxlength = "4" })
                            </div>
                        </div>
                    }
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="exampleInputName1">Department Description :</label>
                            @Html.TextBoxFor(x => x.description, new { @class = "form-control mustfiled", @required = "required", @maxlength = "60" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="exampleInputName1">Reference :</label>
                            @Html.TextBoxFor(x => x.reF_CODE, new { @class = "form-control", @maxlength = "7" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="exampleInputName1">Cost Centre :</label>
                            @Html.TextBoxFor(x => x.cosT_CENTRE, new { @class = "form-control", @maxlength = "10" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div id="divMsg" class="text-danger"> </div>           
            <a class="btn btn-default waves-effect" onclick="location.href='@Url.Action("M_Department","M_Department")'" id="btnclose" data-dismiss="modal"
               style="color: white;background-color: red;">Close</a>
            <button name="submit" type="submit" id="nextButton1" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>Submit</button>
        </div>

    </div>
}


