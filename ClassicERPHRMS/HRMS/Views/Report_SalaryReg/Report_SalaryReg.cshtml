    <style>
        .select2-container--default .select2-selection--single {
            color: #fff;
            height: 41px;
        }

        .j-wrapperForm {
            margin: 0 auto;
            outline: none;
            padding: 40px 15px;
            /*-webkit-box-sizing: content-box;*/
            -moz-box-sizing: content-box;
            /*box-sizing: content-box;*/
        }

        input[type="checkbox"] {
            background-color: #fff;
            margin: 0;
            font: inherit;
            color: currentColor;
            width: 1.5em;
            height: 1.5em;
            border: 0.15em solid currentColor;
            border-radius: 0.15em;
            transform: translateY(-0.075em);
            border: 2px solid #01a9ac;
        }

        .shade {
            -webkit-box-shadow: 0px 10px 13px -7px #000000, -6px 2px 23px 5px rgba(14,0,166,0.44);
            box-shadow: 0px 10px 13px -7px #000000, -6px 2px 23px 5px rgba(14,0,166,0.44);
        }
    </style>
</head>
@if (TempData["toastrSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["toastrSuccess"]</strong>
        @*<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>*@
    </div>
}
@if (TempData["toastrError"] != null)
{
    <div class="alert alert-danger" role="alert">
        <strong>@TempData["toastrError"]</strong>
    </div>
}

