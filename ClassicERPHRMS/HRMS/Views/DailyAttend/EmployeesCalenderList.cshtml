<script>
    $(document).ready(function () {
        var d = new Date();
        var month = d.getMonth() + 1;
        var year = d.getFullYear();
        $("#months").val(month);
        $("#years").val(year);
    });

    document.addEventListener('DOMContentLoaded', function () {
        var years = document.querySelector("years");
        var months = document.querySelector("months");
        var prev = document.querySelector("prev");
        var next = document.querySelector("next");
        var eventsL = JSON.parse('@Html.Raw(_calenderlist)');
        GenerateCalander(eventsL);
    });

    function GenerateCalander(events) {
            var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
                defaultDate: new Date(),
                //initialDate: new Date('@monthCode.ToString("yyyy-MM-dd")'),
                headerToolbar: true, // don't display the default headerToolbar
                disableDragging: true,
                navLinks: false, // can click day/week names to navigate views
                selectable: false,
                selectMirror: true,
                dayMaxEvents: true, // allow "more" link when too many events
                editable: false,
                droppable: false, // this allows things to be dropped onto the calendar
                events: events,
                //events: function (fetchInfo, successCallback, failureCallback) {
                //    debugger;
                //    //events
                //    successCallback(events);
                //},
                headerToolbar: {
                    left: '', //prev,next ,myCustomButton
                    center: 'title', //'title'
                    right: '' //today
                },
                customButtons: {
                    myCustomButton: {
                        text: 'custom!',
                        click: function () {
                            alert('clicked the custom button!');
                        }
                    }
                },
                selectAllow: function (select) {
                    return moment().diff(select.start, 'days') <= 0
                },
                eventMouseEnter: function (info) {
                 /*   debugger;*/
                    console.log(info)
                    var tis = info.el;
                    var tooltip = '<div class="tooltipevent" style="top:' + ($(tis).offset().top - 5) + 'px;left:' + ($(tis).offset().left + ($(tis).width()) / 2) + 'px"><div>' + info.event.title + '</div><div><span class="datespan">' + 'Date: ' + info.event.start.toLocaleDateString() + '</span><span class="timespan">Time: ' + info.event.start.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '</span>' + (info.event.extendedProps.details || 'No details available') + '</div></div>';
                    var $tooltip = $(tooltip).appendTo('body');
                },
                eventMouseLeave: function (info) {
                    console.log('eventMouseLeave');
                    $(info.el).css('z-index', 8);
                    $('.tooltipevent').remove();
                },
                drop: function (arg) {
                    debugger;
                    // is the "remove after drop" checkbox checked?
                    if (document.getElementById('drop-remove').checked) {
                        // if so, remove the element from the "Draggable Events" list
                        arg.draggedEl.parentNode.removeChild(arg.draggedEl);
                    }
                },
                eventDidMount: function (arg) {
                    debugger;
                    //let val = $years.value;
                    //if (!(val == arg.event.extendedProps.userId || val == "all")) {
                    //    arg.el.style.display = "none";
                    //}
                },
                eventRender: function (info) {
                    var tooltip = new Tooltip(info.el, {
                        title: info.event.extendedProps.description,
                        placement: 'top',
                        trigger: 'hover',
                        container: 'body'
                    });
                },
                datesSet(dateInfo) { // v4 datesRender(info)
                    //AddMySelectToFullCalendar();
                }
            });
            calendar.render();

            years.addEventListener('change', function () {
                debugger;
                var value = months.value;
                var monthvalue = months.value;
                var monthtext = months.options[months.selectedIndex].text;
                var yearvalue = years.value;
                var yeartext = years.options[years.selectedIndex].text;

                var gotodate = yearvalue + "-" + monthvalue + "-" + "01";
                calendar.refetchEvents(); // call method
                calendar.gotoDate(gotodate);  //('2014-01-01')
            });

            months.addEventListener('change', function () {
                debugger;
                var value = months.value;
                var monthvalue = months.value;
                var monthtext = months.options[months.selectedIndex].text;
                var yearvalue = years.value;
                var yeartext = years.options[years.selectedIndex].text;

                var gotodate = yearvalue + "-" + monthvalue + "-" + "01";
                calendar.refetchEvents(); // call method
                calendar.gotoDate(gotodate);  //('2014-01-01')
            });

            prev.addEventListener('click', function () {
                calendar.prev(); // call method
            });

            next.addEventListener('click', function () {
                calendar.next(); // call method
            });
    }

    /* and the function it calls ... */
