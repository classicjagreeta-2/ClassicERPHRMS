@model List<HRMS.Models.TRN.T_DAILY_ATTEND>
@*@using PagedList.Mvc;
    @using PagedList;*@


@using System.Globalization


@{
    ViewBag.Title = "Employee Daily Attendance";
    DateTime date = DateTime.ParseExact(ViewBag.MonthCodeId, "yyyyMM", CultureInfo.InvariantCulture);
    ViewBag.MonthName = date.ToString("MMMM");
    ViewBag.Year = date.ToString("yyyy");

    var monthList = new SelectList(
    new List<SelectListItem>
    {
            new SelectListItem { Selected = false, Text = "January", Value = "01"},
            new SelectListItem { Selected = false, Text = "February", Value = "02"},
            new SelectListItem { Selected = false, Text = "March", Value = "03"},
            new SelectListItem { Selected = false, Text = "April", Value = "04"},
            new SelectListItem { Selected = false, Text = "May", Value = "05"},
            new SelectListItem { Selected = false, Text = "June", Value = "06"},
            new SelectListItem { Selected = false, Text = "July", Value = "07"},
            new SelectListItem { Selected = false, Text = "August", Value = "08"},
            new SelectListItem { Selected = false, Text = "September", Value = "09"},
            new SelectListItem { Selected = false, Text = "October", Value = "10"},
            new SelectListItem { Selected = false, Text = "November", Value = "11"},
            new SelectListItem { Selected = false, Text = "December", Value = "12"}
                                            }, "Value", "Text", 1);

    var yearList = new SelectList(
        new List<SelectListItem>
        {
            new SelectListItem { Selected = false, Text = "2025", Value = "2025"},
            new SelectListItem { Selected = false, Text = "2024", Value = "2024"},
            new SelectListItem { Selected = false, Text = "2023", Value = "2023"},
                                                }, "Value", "Text", 1);
}



<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/datatables.net-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/data-table/css/buttons.dataTables.min.css">
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<link href="~/libraries/TableRowDesign.css" rel="stylesheet" />
<link href="~/libraries/assets/css/CheckBoxStyle.css" rel="stylesheet" />
<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<!-- Multi Select css -->
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/bootstrap-multiselect/css/bootstrap-multiselect.css">
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/multiselect/css/multi-select.css">

<style>
    .modal-backdrop {
        opacity: 0.5 !important;
    }

    .dataTables_length {
        margin: 0px 0px -45px 6px;
    }

    div.dt-buttons {
        margin: 0px 0px 0px 188px;
    }


    .select2-container .select2-selection--single {
        height: 34px;
    }
</style>

<div class="card">
    <div class="card-header pull-right">
        <div class="float-left form-group">
            @using (Html.BeginForm("EmployeesList", "DailyAttend", FormMethod.Post))
            {
                <input type="hidden" id="EmpId" name="EmpId" value="@ViewBag.EmpId" id="hdnFlag" />
                @Html.DropDownList("year", new SelectList(yearList, "Value", "Text", ViewBag.YearDigit),
                                            new { @class = "btn btn-sm btn-inverse btn-outline-inverse", @onchange = "document.forms[0].submit();" })

                @Html.DropDownList("month", new SelectList(monthList, "Value", "Text", ViewBag.MonthDigit),
                     new { @class = "btn btn-sm btn-inverse btn-outline-inverse", onchange = "document.forms[0].submit();" })
            }

        </div>
        <a id="backBtn" href="@Url.Action("DailyAttend","DailyAttend")" class="btn btn-sm btn-info float-right">
            <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i> Back
        </a>
        <div class="text-center"><h4>Attendance Details (@ViewBag.MonthName @ViewBag.Year)</h4></div>
        <div class="text-center"><h5>@ViewBag.DisplayName </h5></div>
    </div>

    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <div id="TblEmp">
                @*@Html.Partial("~/Views/Attendance/_EmpList.cshtml", Model)*@


                @using (Html.BeginForm("BulkStoreOrEditEmployeesList", "DailyAttend", FormMethod.Post))
                {

                    @Html.AntiForgeryToken();

                    <table class="table table-bordered nowrap" style="width:100%">

                        <thead>
                            <tr>
                                <th width="5%">Date</th>
                                <th width="10%">Shift</th>
                                <th width="10%">In Time</th>
                                <th width="10%">Out Time</th>
                                <th width="10%">Late Time</th>
                                <th width="15%">Attendance Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count() > 0)
                            {
                                for (int i = 0; i < Model.Count(); i++)
                                {
                                    <tr class="RowTable">

                                        <td>@Model[i].EDATE.Value.ToString("dd/MM/yyyy")</td>
                                        <td>@Model[i].FK_SHIFT_CODE</td>
                                        <td>@Model[i].IN_TIME</td>
                                        <td>@Html.DisplayFor(modelItem => @Model[i].OUT_TIME)</td>
                                        <td>
                                            @if (new string[6] { "W", "A", "L", "M", "S", "F" }.Contains(Model[i].FK_ATTEND_CODE))
                                            {
                                                @Html.TextBoxFor(x => Model[i].LATE_TIME, new { @class = "form-control col-8", @disabled = "disabled", @id = "LATE_TIME_" + Model[i].ID })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(x => Model[i].LATE_TIME, new { @class = "form-control col-8", @id = "LATE_TIME_" + Model[i].ID })
                                            }
                                        </td>
                                        <td>
                                            @Html.HiddenFor(modelItem => @Model[i].ID)
                                            @Html.HiddenFor(modelItem => @Model[i].UNIT)
                                            @Html.HiddenFor(modelItem => @Model[i].TOT_HOURS_WORKED)
                                            @Html.HiddenFor(modelItem => @Model[i].REMARKS)

                                            @Html.HiddenFor(modelItem => @Model[i].PTYPE)
                                            @Html.HiddenFor(modelItem => @Model[i].DTAG)

                                            @Html.HiddenFor(modelItem => @Model[i].EDATE)
                                            @Html.HiddenFor(modelItem => @Model[i].USER_NAME)
                                            @Html.HiddenFor(modelItem => @Model[i].FK_EMPCODE)
                                            @Html.HiddenFor(modelItem => @Model[i].LOCA)
                                            @Html.HiddenFor(modelItem => @Model[i].USER_ENTDT)
                                            @Html.HiddenFor(modelItem => @Model[i].OS_USER)
                                            @Html.HiddenFor(modelItem => @Model[i].TERMINAL_ID)
                                            @Html.HiddenFor(modelItem => @Model[i].UNIT)
                                            @Html.HiddenFor(modelItem => @Model[i].ATTEND)
                                            @Html.HiddenFor(modelItem => @Model[i].LEAVE)
                                            @Html.HiddenFor(modelItem => @Model[i].WEEKLY_OFF)
                                            @Html.HiddenFor(modelItem => @Model[i].ABSENT)
                                            @Html.HiddenFor(modelItem => @Model[i].LATE_TIME)
                                            @Html.HiddenFor(modelItem => @Model[i].HOLIDAY)

                                            @Html.HiddenFor(modelItem => @Model[i].IN_TIME)
                                            @Html.HiddenFor(modelItem => @Model[i].OUT_TIME)

                                            @Html.HiddenFor(modelItem => @Model[i].FK_SHIFT_CODE)
                                            @Html.HiddenFor(modelItem => @Model[i].FK_MONTHCODE)
                                            <input type="hidden" id="Leave" value="@ViewBag.LeaveRemaining" />
                                            @if (new string[1] { "F" }.Contains(Model[i].FK_ATTEND_CODE))
                                            {
                                                @Html.DropDownListFor(x => Model[i].FK_ATTEND_CODE,
                                               new SelectList(ViewBag.AttendType, "PK_ATTEND_CODE", "DESCRIPTION", Model[i].FK_ATTEND_CODE),
                                               new
                                                    {
                                                        @class = "js-example-responsive col-sm-12 ddlattend",
                                                        @id = "FK_ATTEND_CODE_" + "F_" + Model[i].ID,
                                                        @name = "FK_ATTEND_CODE",
                                                        @disabled = "disabled"
                                                    })
                                            }
                                            else
                                            {
                                                @Html.DropDownListFor(x => Model[i].FK_ATTEND_CODE,
                                               new SelectList(ViewBag.AttendType, "PK_ATTEND_CODE", "DESCRIPTION", Model[i].FK_ATTEND_CODE),
                                               new
                                                    {
                                                        @class = "js-example-responsive col-sm-12 ddlattend",
                                                        @id = " b" + Model[i].FK_ATTEND_CODE + "_" + Model[i].ID,
                                                        @name = "FK_ATTEND_CODE",
                                                        @onchange = "jsFunction(this.value, '" + Model[i].EDATE.Value.ToString("yyyy-MM-dd") + "')"
                                                    })
                                            }
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2"><center> No Data </center></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @*<button type="submit" class="btn btn-primary" onclick=" ()">Submit</button>*@
                    <button type="submit" class="btn btn-primary">Submit</button>
                }




                @*@section scripts{
                        <script src="~/libraries/js/jquery-1.11.3.min.js"></script>
                        <script>
                            function submitForm() {
                                debugger
                                $('#loader').show();
                                $('#myForm').submit(function () {
                                    $('#loader').hide();
                                });
                            }
                        </script>
                    }*@


            </div>
        </div>
    </div>
</div>



@section scripts{
    <script>
        $(document).ready(function () {
            debugger;
            var d = new Date();
            var month = d.getMonth() + 1;
            var year = d.getFullYear();
            var data = year.toString() + month.toString();
            //$("#month").val(month);
            //$("#years").val(year);
        });

        function submitForm() {
            $('#loader').show();
            $('#myForm').submit(function () {
                $('#loader').hide();
            });
        }

        var table;
        $(document).ready(function () {
            datatable();
        });

        $(document).ready(function () {
            $('.ddlattend').change(function () {
                debugger
                var selectedValue = $(this).val();
                var lateTimeInput = $(this).closest('tr').find('.form-control');

                if (selectedValue == 'S' || selectedValue == 'M' || selectedValue == 'PH' || selectedValue == 'L' || selectedValue == 'W' || selectedValue == 'A') {
                    lateTimeInput.prop('disabled', true);
                } else {
                    lateTimeInput.prop('disabled', false);
                }
                // Close the dropdown
                $(this).select2('close');
            });
        });

        function datatable() {
            $(function () {
                table = $("#ajax-table").DataTable({
                    scrollY: '320px',
                    scrollX: true,
                    "processing": true, // for show progress bar,
                    retrieve: true,
                    "language": {
                        'processing': '<i class="icofont icofont-spinner-alt-2 icofont-3x"></i>'
                    },

                    lengthMenu: [
                        [50, 100, 500, -1],
                        ['50', '100', '500', 'Show all']
                    ],
                    dom: 'lBfrtip',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                        }
                    ],
                });
            });
        }

        setTimeout(function () { $('.alert').alert('close'); }, 5000);

        $('#btnSubmit').click(function (e) {
            e.preventDefault();
            var IstoVlidate = 'form';
            debugger;
            if ($(IstoVlidate).smkValidate()) {
                debugger;
                var dataString = new FormData($("#myForm").get(0));
                var returnUrl = '@Url.Action("StoreOrEdit", "Attendance")'
                blockUIStart();
                // "StoreOrEdit", "Master_Customer"
                $.ajax({
                    url: returnUrl,
                    data: dataString,
                    contentType: false,
                    processData: false,
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        OnSuccess(data);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        debugger;
                        OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                });
            }
        });

