                                         $.notify(" No Remaining " + selectedOptionText + " left, Contact ADMINISTRATION", {
                                        globalPosition: "top center",
                                        className: "Error"
                                    })
                                }
                                     else {
                                         $("#TblEmp").empty().html(data);
                                         datatable();
                                    //$.notify("Remaining " + leaveType + " " + " Leave: " + remainingCasualLeave + ", Contact ADMINISTRATION", {
                                    //    globalPosition: "top center",
                                    //    className: "Error"
                                    $.notify("Successfully Save. " + "Remaining " + selectedOptionText + " " + remainingCasualLeave , {
                                        globalPosition: "top center",
                                        className: "success"
                                    })
                                }
                     },
                     error: function (errorjqXHR, exception) {

                         $('.btnClose').click();
