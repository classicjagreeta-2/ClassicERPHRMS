            debugger

            let attendtypeid = "FK_ATTEND_CODE" + Id;
            let attendtype2 = document.getElementById(attendtypeid).value;//id+ID=idID
            let lateValue = document.getElementById("txt_" + Id).value;
            let data = { Id: Id, EmpCode: empcode, MonthCode: moncode, LateId: lateValue, AttendType: attendtype2 };
            var returnUrl = '@Url.Action("StoreOrEditEmployeesList", "Attendance")'
            if (!["P", "E", "W", "A", "M", "F"].includes(attendtype2))
            {
                //var leaveType = document.getElementById(attendtypeid);
