                             className: "Errror"
                         })
                     }
                 });
            }

            else
            {
                 @*let data = { Id: Id, EmpCode: empcode, MonthCode: moncode, LateId: lateValue, AttendType: attendtype2 };
                  var returnUrl = '@Url.Action("StoreOrEditEmployeesList", "Attendance")'*@
                 $.ajax({
                     type: "POST",
                    /* url: "/MastEmpLinkDel/AddEditModel",*/
                     url: returnUrl,
                     async: false,
                     data: data,
                     success: function (data) {
                         debugger;

                         $.notify("Successfully Save", {
                             globalPosition: "top center",
                             className: "success"
                         })
                         $("#TblEmp").empty().html(data);
                         datatable();




                     },
                     error: function (errorjqXHR, exception) {

                         $('.btnClose').click();
                         $.notify("Error In Edit", {
                             globalPosition: "right center",
                             className: "Errror"
                         })
                     }
                 });
            }
        }

        function BackPageForm(moncode) {
            debugger
            let data = { mcode: moncode };
            var returnUrl = '@Url.Action("DailyAttend", "Attendance")'
            $.ajax({
                type: "GET",
                url: returnUrl,
                async: false,
                data: data,
                success: function (data) {
                    //$("#BackIdModal").empty().append(data);
                    //waitingDialog.hide();
                },
                error: function (errorjqXHR, exception) {

                    $('.btnClose').click();
                    $.notify("Error In Edit", {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        };

        document.getElementById("backBtn").addEventListener("click", openNewWindow);

         function openNewWindow() {
             var url = '../DailyAttend?MONTHCODE=@ViewBag.MonthCodeId';
            window.open(url, '_self');
        }

        $("#IdaddNewRecord").click(function () {
            debugger
            var Id = $(this).data('id');
            var data = { monthcode: Id };
            var returnUrl = '@Url.Action("EmployeesList", "Attendance")'
            //var x = httpGetWithObj("/MastEmp/AddEditModel", data);
            //$("#IdModal").empty().append(x.data);
            debugger;
            $.ajax({
                type: "GET",
                url: returnUrl,
                async: false,
                data: data,
                success: function (data) {

                    debugger;
                    $("#IdModal").empty().append(data);
                },
                error: function (errorjqXHR, exception) {
                    $("#divMsg").empty();
                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        });

        function SubmitForm(form) {
            debugger
            $.validator.unobtrusive.parse(form);

            if ($(form).valid()) {
                $("#divMsg").empty().append("Please Wait......");
                $.ajax({
                    type: "POST",
                    url: form.action,
                    async: false,
                    data: $(form).serialize(),
                    success: function (data) {
                        $("#divMsg").empty();
                        if (data.success) {

                            $('#IdModal').modal('toggle');

                            dataTable.ajax.reload();

                            $.notify(data.message, {
                                globalPosition: "top center",
                                className: "success"
                            })
                        }
                        else {
                            $("#IdDivMsg").empty().append(data.message);
                            $("#IdDivDeatils").empty().append(data.details);
                            // $("#divMsg").empty().append(data.details);
                            $("#myModal2").modal('show');
                        }
                    },
                    error: function (errorjqXHR, exception) {
                        $("#divMsg").empty();
                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "Errror"
                        })
                    }
                });
            }
            return false;
        }

        $("#FK_ATTEND_CODE").change(function () {
            debugger
            var attendCode = $(this).val();
            @*var remainingCasualLeave = @ViewBag.LeaveRemaining;*@
            var remainingCasualLeave = LeaveCount;
            if (attendCode == "C" && remainingCasualLeave == 0)
            {
               /* $("#errorMsg").text("Casual Leave: 0, Contact Administration");*/
                $("#IdDivMsg").empty().append("Casual Leave: 0, Contact Administration");
                // Show error message
            }
            else
            {
                $("#IdDivMsg").empty().append("Reamaining Casual Leave: "+remainingCasualLeave);
                    // Clear error message
            }
        });

        function Delete(id) {
            $.confirm({
                title: "Confirmation required",
                content: "Are you sure you want to delete?",
                buttons: {
                    YES: function () {

                        DeleteRecord(id);
                    },
                    NO: function () {

                    },
                }
            });
        }

        function DeleteRecord(id) {
            $.ajax({

                type: "POST",
                url: "../TD_OtherMaster/Delete",
                data: { Id: id },
                success: function (data) {

                    if (data.success) {

                        dataTable.ajax.reload();

                        $.notify(data.message, {
                            globalPosition: "top center",
                            className: "success"
                        })
                    }
                    else {
                        $("#IdDivMsg").empty().append(data.message);
                        $("#IdDivDeatils").empty().append(data.details);
                        // $("#divMsg").empty().append(data.details);
                        $("#myModal2").modal('show');
                    }
                },
                error: function (errorjqXHR, exception) {

                    $.notify(data.message, {
                        globalPosition: "top center",
                        className: "Errror"
                    })
                }
            });
        }

        function submitForm() {
            debugger
            $('#loader').show();
            $('#myForm').submit(function () {
                $('#loader').hide();
            });
        }

    </script>
}


