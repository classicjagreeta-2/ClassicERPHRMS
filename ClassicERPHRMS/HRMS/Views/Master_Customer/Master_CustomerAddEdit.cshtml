    <script>
            //$(document).ready(function () {
            //    $("#IdMenu").pcodedmenu({
            //        themelayout: 'horizontal',
            //        FixedNavbarPosition: true,
            //        FixedHeaderPosition: true,
            //    });
            //});

            $('#btnSubmit').click(function (e) {
                e.preventDefault();
                if ($('form').smkValidate()) {

                    var dataString = new FormData($("#myForm").get(0));
                    blockUIStart();

                    $.ajax({
                        url: "../Master_Item/StoreOrEdit",
                        data: dataString,
                        contentType: false,
                        processData: false,
                        cache: false,
                        type: "POST",
                        dataType: "json",
                        success: function (data) {
                            OnSuccess(data);
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        }
                    });


                }
            });


            function PopupForm() {
                alert('');
                $('#myModal2').modal('show');

            }

            function LoadProgess() {
                alert('');
            }



            function OnSuccess(result) {
                $.unblockUI();
                if (result.success == false) {
                    debugger;
                    msgError(result.details);
                    //$.notify(result.message, {
                    //    globalPosition: "top center",
                    //    className: "Errror"
                    //})

                } else {
                    //msgSuccess(result.message);
                    $('form').smkClear();
                    $("#ddlaccounthead option:selected").val(null).trigger("change");

                    $.confirm({

                        title:'Confirmation !!',
                        type: 'green',
                        content: result.message,
                        typeAnimated: true,
                        icon: 'icon-smiley',
                        buttons: {

                            Okay: function () {
                               var url = '@Url.Action("Master_Item", "Master_Item")';
                               window.location.href = url;
                            },
                            //cancel: function () {

                            //}
                        }

                    });

                   
                    //  debugger;
                    // $("#ddlaccounthead").empty().trigger('change')
                    // $("#ddlaccounthead option:selected").prop("selected", false);
                    // $("#ddlaccounthead").selectpicker("refresh");
                    //$.notify(result.message, {
                    //    globalPosition: "top center",
                    //    className: "success"
                    //})
                }

            }

            function OnFailure(result) {
                $.unblockUI();
            }

    </script>

}
