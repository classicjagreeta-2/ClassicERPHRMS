@model WEB_VIEWMODEL17.TD_Model.TD_Model_CustomerMaster



<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">


    @*@using (Ajax.BeginForm("StoreOrEdit", "Master_Customer", new AjaxOptions
        { OnSuccess = "OnSuccess", OnBegin = "OnBegin",OnFailure= "OnFailure" }, new {
            onsubmit = "return SubmitForm(this)" }))*@
    @using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))

    {

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Customer Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Customer Id</label>
                                @Html.TextBoxFor(x => x.CustHead.PK_PCD, new { @class = "form-control mustfiled", @maxlength = "6", @readonly = true })
                                @Html.HiddenFor(x => x.CustHead.RES_TEL)
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="exampleInputName1">Name*</label>
                                @Html.TextBoxFor(x => x.CustHead.NAME, new { @class = "form-control mustfiled", @required = "required", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">Short Name</label>
                                @Html.TextBoxFor(x => x.CustHead.SHT_NAME, new { @class = "form-control", @required = "required", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="exampleInputName1">Company Name</label>
                                @Html.TextBoxFor(x => x.CustHead.COMP_NAME, new { @class = "form-control", @maxlength = "100" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Address 1*</label>
                                @Html.TextAreaFor(x => x.CustHead.ADD1, new { @class = "form-control", @required = "required", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Address 2</label>
                                @Html.TextAreaFor(x => x.CustHead.ADD2, new { @class = "form-control", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Address 3</label>
                                @Html.TextAreaFor(x => x.CustHead.ADD3, new { @class = "form-control", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Address 4</label>
                                @Html.TextAreaFor(x => x.CustHead.ADD4, new { @class = "form-control", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">City</label>
                                @Html.TextBoxFor(x => x.CustHead.CITY, new { @class = "form-control", @maxlength = "15" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">PIN</label>
                                @Html.TextBoxFor(x => x.CustHead.PIN, new { @class = "form-control", @maxlength = "10" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">State</label>
                                @Html.TextBoxFor(x => x.CustHead.STATE, new { @class = "form-control", @maxlength = "15" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Office Phone No</label>
                                @Html.TextBoxFor(x => x.CustHead.OFF_TEL, new { @class = "form-control", @maxlength = "30" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Mobile No</label>
                                @Html.TextBoxFor(x => x.CustHead.MOBILE_NO, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">WhatsApp No</label>
                                @Html.TextBoxFor(x => x.CustHead.WAPP_NO, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Fax No</label>
                                @Html.TextBoxFor(x => x.CustHead.FAX_NO, new { @class = "form-control", @maxlength = "30" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">E-Mail</label>
                                @Html.TextBoxFor(x => x.CustHead.E_MAIL_ID, new { @class = "form-control", @maxlength = "40" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Country*</label>
                                @Html.DropDownListFor(x => x.CustHead.FK_COUNTRY_CODE, new SelectList(ViewBag.DropdownListMasterCountry, "PK_CODE", "NAME"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlCountry", @required = "required" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Destination</label>
                                @Html.TextBoxFor(x => x.CustHead.DESTI, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Currency*</label>
                                @Html.DropDownListFor(x => x.CustHead.FK_CURRENCY_CD, new SelectList(ViewBag.DropdownListMasterCurrency, "PK_CODE", "NAME"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlCurrency", @required = "required" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="PartyType">
                                <label for="exampleInputName1">Customer Type*</label>
                                @Html.DropDownListFor(x => x.CustHead.TYPE, new SelectList(ViewBag.DropdownListMasterPartyType, "PK_CODE", "DESCN"),
                                    "SELECT..", new { @class = "js-example-responsive", @id = "ddlPartyType", @required = "required" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">IBAN No</label>
                                @Html.TextBoxFor(x => x.CustHead.IBAN, new { @class = "form-control", @maxlength = "30" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">TRN/TIN No</label>
                                @Html.TextBoxFor(x => x.CustHead.TRN_NO, new { @class = "form-control", @maxlength = "20" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Contact Person 1</label>
                                @Html.TextBoxFor(x => x.CustHead.CONT_NAME1, new { @class = "form-control", @maxlength = "50" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Contact Person 2</label>
                                @Html.TextBoxFor(x => x.CustHead.CONT_NAME2, new { @class = "form-control", @maxlength = "50" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Contact Person 2 Phone No</label>
                                @Html.TextBoxFor(x => x.CustHead.CONT_PH2, new { @class = "form-control", @maxlength = "15" })
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="TableMaxRow" value=@ViewBag.MaxRowIndex />
                <input type="hidden" id="IdHiddenProject" value="@ViewBag.Unit" />
                <div class="col-lg-12">
                    <div class="row">
                        <div class="col-lg-12">
                            <input type="hidden" name="hiddentablei" id="hiddentablei" value="0">
                            <div class="dataTables_scroll">
                                <div class="table-responsive text-nowrap" id="DivTble">
                                    <div style="overflow:auto">
                                        <table id="tblUnit" class="table table-striped table-bordered nowrap dataTable no-footer" style="width: 100%;" role="grid" aria-describedby="ajax-table_info">
                                            <thead class="classHaeder">
                                                <tr>
                                                    <th width="6%">
                                                        <a type="button" class="button button-small ag-i-btn" onclick="addItemRow()"><i class="fa fa-plus"></i></a>
                                                    </th>
                                                    <th width="40%"><label class="col-form-label">  Unit </label> </th>
                                                    <th><label class="col-form-label"> Customer Type </label> </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @Html.Partial("_CustomerUnitChild", Model)
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>
                
                <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>


<script src="~/libraries/assets/js/select2.js"></script>
<!-- Multiselect js -->
<!-- Custom js -->
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>



