<div class="card">
    <div class="card-header pull-right">
        <button id="IdaddNewRecord" type="button" class="btn btn-sm btn-info aLoader" data-toggle="modal">
            <i class="fa fa-plus-circle fa-lg" aria-hidden="true"></i>  Add New
        </button>
        <a href=@Url.Action("CommonDashBoard","CommonDashBoard") class="btn btn-sm btn-info">
            <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>Close
        </a>
        <div class="text-center" style="margin-top: -29px;"><h4>Allowance Calculation Mode Master</h4></div>
    </div>

    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="allowcalc" class="table table-striped table-bordered nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th width="1%">Action</th>
                        <th width="10%">Calculation Mode Code</th>
                        <th>Calculation Mode Description</th>
                        @*<th width="20%">Unit Code And Description</th>*@
                        @*<th width="30%">Applicable in State Code and State Name</th>*@


                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


