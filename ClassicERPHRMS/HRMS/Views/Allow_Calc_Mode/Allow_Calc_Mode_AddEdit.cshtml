
@model HRMS.Models.Master.M_AllOW_CALC_MODE

@using HRMS.Models.Master





<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">


    @*@using (Ajax.BeginForm("StoreOrEdit", "Master_Item", new AjaxOptions
        { OnSuccess = "OnSuccess", OnBegin = "OnBegin" }, new { onsubmit = "return SubmitForm(this)" }))*@

    @using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))
    {

        @Html.HiddenFor(x => x.id)
        <div class="modal-content" style="width:70%">
            <div class="modal-header">
                <h5 class="modal-title">Allowance Calculation Mode Master</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        @if (Model != null)
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Calcution Mode Code:</label>
                                    @Html.TextBoxFor(x => x.pK_CALC_MODE, new { @class = "form-control", @maxlength = "2", @required = "required", @disabled = "disabled" })
                                </div>
                                @Html.HiddenFor(x => x.id)
                                @Html.HiddenFor(x => x.pK_CALC_MODE)
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Calcution Mode Code:</label>
                                    @Html.TextBoxFor(x => x.pK_CALC_MODE, new { @class = "form-control", @maxlength = "2", @required = "required" })
                                </div>
                            </div>
                        }


                        <div class="col-md-5">
                            <div class="form-group">
                                <label for="exampleInputName1">Calculation Mode Description:</label>
                                @Html.TextBoxFor(x => x.description, new { @class = "form-control", @maxlength = "30", @required = "required" })
                            </div>
                        </div>


                        @*<div class="col-md-4">
                                <div class="form-group">
                                    <label for="exampleInputName1">Unit Code And Unit Description:</label>


                                    @{
                                        var unilst = ViewBag.Uunt as List<M_UNIT>;
                                        var uniSelectList = unilst.Select(item => new SelectListItem { Text = item.CODE + " " + " - " + item.NAME, Value = item.CODE.ToString() }).ToList();
                                        uniSelectList.Insert(0, new SelectListItem { Text = "SELECT..", Value = "" });
                                    }

                                    @Html.DropDownListFor(x => x.UNIT, uniSelectList, new { @class = "js-example-disabled-results col-sm-12", @required = "required" })
                                </div>

                            </div>*@



                    </div>



                </div>
            </div>

            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>
                <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>

<script src="~/libraries/assets/js/select2.js"></script>
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

<script>
    $('#btnSubmit').click(function (e) {
        e.preventDefault();
        var IstoVlidate = 'form';
        var directUrl = '@Url.Action("StoreOrEdit", "Allow_Calc_Mode")';
        debugger;
        if ($(IstoVlidate).smkValidate()) {
            debugger;
            var dataString = new FormData($("#myForm").get(0));
            blockUIStart();
            // "StoreOrEdit", "Master_Customer"
            $.ajax({
                url: directUrl,
                data: dataString,
                contentType: false,
                processData: false,
                cache: false,
                type: "POST",
                dataType: "json",
                success: function (data) {
                    OnSuccess(data);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    debugger;
                    OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });


        }
    });
    function OnFailure() {
        $.unblockUI();
    }
    function OnBegin() {
        blockUIStart();
    }

    function OnSuccess(result) {

        $.unblockUI();
        if (result.success == false) {
            debugger;
            msgError(result.details);
            //$.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "Errror"
            //})

        } else {
            //msgSuccess(result.message);
            $('form').smkClear();
            $("#ddlaccounthead option:selected").val(null).trigger("change");

            $.confirm({

                title: 'Confirmation !!',
                type: 'green',
                content: result.message,
                typeAnimated: true,
                icon: 'icon-smiley',
                buttons: {

                    Okay: function () {
                        $("#btnclose").click();
                        dataTable.ajax.reload();

                    },
                    //cancel: function () {

                    //}
                }

            });

            //  debugger;
            // $("#ddlaccounthead").empty().trigger('change')
            // $("#ddlaccounthead option:selected").prop("selected", false);
            // $("#ddlaccounthead").selectpicker("refresh");
            // $.notify(result.message, {
            //    globalPosition: "top center",
            //    className: "success"
            //})

        }

    }

    function OnFailure(result) {
        $.unblockUI();
    }
</script>



}

