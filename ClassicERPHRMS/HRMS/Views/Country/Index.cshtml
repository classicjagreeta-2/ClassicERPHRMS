@model PagedList.StaticPagedList<HRMS.Models.Master.M_COUNTRY>
@using PagedList.Mvc;
@using PagedList;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-body">
    <div class="card">
        <div class="card-header pull-right">          
            @using (Html.BeginForm("AddEditModal", "Country", FormMethod.Post, new { style = "display:inline" }))
            {
                <button type="submit" class="btn btn-sm btn-info aLoader"  data-toggle="modal">
                    <i class="fa fa-plus-circle fa-lg" aria-hidden="true"></i>  Add New
                </button>
            }
            <a href=@Url.Action("Index","Menu") class="btn btn-sm btn-info">
                <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>Close
            </a>
            <div class="text-center" style="margin-top: -29px;"><h4>Country Master</h4></div>
        </div>
        <div class="card-block">
            <div class="table-responsive dt-responsive">
                <div id="dom-jqry_wrapper" class="dataTables_wrapper dt-bootstrap4">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-sm-12 col-md-6">
                            <div class="dataTables_length" id="dom-jqry_length">
                                @using (Html.BeginForm("Index", "Country", FormMethod.Get))
                                {
                                    <label>
                                        Show
                                        <select name="pageSize" onchange="document.forms[0];" aria-controls="dom-jqry" class="form-control input-sm" fdprocessedid="794bn7">
                                            <option value=25>25</option>
                                            <option value=50>50</option>
                                            <option value=100>100</option>
                                        </select>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-6">
                            <div id="dom-jqry_filter" class="dataTables_filter">
                                @using (Html.BeginForm("Index", "Country", FormMethod.Get))
                                {
                                    <label> Search:@Html.TextBox("SearchString", ViewBag.CurrentFilter as string, new { @class = "form-control input-sm" })</label>
                                    <button type="submit" class="btn btn-sm btn-info aLoader"> Search</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-12">
                            <table id="country" class="table table-striped table-bordered nowrap dataTable" style="width: 100%;" role="grid" aria-describedby="dom-jqry_info">
                                <thead>
                                    <tr role="row">
                                        <th width="1%">Action</th>
                                        <th width="30%"> Code</th>
                                        <th width="30%"> Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="sorting_1">
                                                @using (Html.BeginForm("AddEditModal", "Country", FormMethod.Post, new { style = "display:inline" }))
                                                {
                                                    @Html.Hidden("Id", item.id)
                                                    <button type="submit" class="btn btn-mini btn-info"><i class="fa fa-home"></i></button>
                                                }
                                                @*<a class="btn btn-mini btn-info" data-toggle="modal" onclick="location.href='@Url.Action("AddEditModal", "Country",new {Id = item.id})'">
                                                    <i class="icofont icofont-pencil-alt-4 icofont-1x"></i>
                                                </a>*@
                                                <a class="btn btn-mini btn-danger" onclick="FnDelete('2')">
                                                    <i class="fa fa-trash-o fa-lg">
                                                    </i>
                                                </a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.pK_COUNTRY_CODE)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.description)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        @if (Model != null)
                        {
                        <div class="col-xs-12 col-sm-12 col-md-5">
                            <div class="dataTables_info" id="dom-jqry_info" role="status" aria-live="polite"> Showing @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-7">
                            <div class="dataTables_paginate paging_simple_numbers" id="dom-jqry_paginate">
                                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="errorModal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" Style="padding: 2px;background-color: #ff00008a;color: white;">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="container"></div>
            <div class="modal-body">

                <div id="IdDivMsg" style="font-size:22px;color:red;">
                    Error In Edit
                </div>
                <br />
                <div id="IdDivDeatils" style="color: #cfcfcf;"> </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-dismiss="modal" class="btn btn-danger">Close</a>

            </div>
        </div>
    </div>
</div>


