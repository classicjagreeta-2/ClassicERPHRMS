                        <th width="1%">Action</th>
                        <th width="10%">Deduct Code</th>
                        <th width="10%">Deduct Description</th>
                        <th width="10%">Advance Amount</th>
                        <th width="10%">No. of Installment</th>
                        <th width="10%">Deduct Amount</th>
                        @*<th width="10%">Deduct Amount %</th>
                            <th width="10%">Limit</th>*@
                        <th width="10%">Currency Code</th>
                        <th width="10%">Effected From</th>
                        <th width="10%">Active Status</th>
                        <th width="10%">Effected To</th>


                        @*<th width="10%">Deduct Description</th>*@

                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


