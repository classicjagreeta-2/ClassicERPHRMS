    function FnDelete(id) {
      debugger;
      $.confirm({
          title: "Confirmation required",
          content: "Do you want to delete?",
          type: 'red',
          typeAnimated: true,
          buttons: {

              NO: function () {
              },
              YES: function () {
                  DeleteRecord(id);
              },
          }
      });

  }

  var Turl= '@Url.Action("Delete", "M_EmpDeductLinkDet")';
  function DeleteRecord(id) {
      debugger;
      $.ajax({
          type: "POST",
          url: Turl,
          data: { Id: id },
          beforeSend: function () {
              showLoading2("divcontainer","Deleting....")
          },
          complete: function () {
              HideLoading();
          },
          success: function (data) {
              debugger;
              if (data.success) {

                  dataTable.ajax.reload();
                  NotifyMsgSucc(data.message);


              }
              else {
                  NotifyMsgError(data.message + "\n" + data.details.Message )


              }
          },
          error: function (errorjqXHR, exception) {
              debugger;
              NotifyMsgError("Failed to delete")
          }

      });
  }

  function checkForDuplicate() {
      var enteredID = $('#idInput').val();

      // Perform an AJAX request to check if the entered ID already exists
      $.ajax({
          url: '../YourController/CheckForDuplicate',
          type: 'POST',
          data: { id: enteredID },
          success: function (response) {
              if (response.isDuplicate) {
                  alert('ID already exists. Please enter a different ID.');
              } else {
                  // If the ID is not a duplicate, submit the form
                  $('#myForm').submit();
              }
          },
          error: function () {
              alert('Error checking for duplicate ID.');
          }
      });
  }
