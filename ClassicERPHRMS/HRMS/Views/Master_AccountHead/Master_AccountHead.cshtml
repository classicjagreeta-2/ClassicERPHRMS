<div class="card">
    <div class="card-header">
        <div class="label-main">
            <label class="label label-inverse-noLine"><h4>Account Master</h4></label>
        </div>
        <button id="IdaddNewRecord" type="button" class="btn btn-grd-info  btn-md float-right" data-toggle="modal" data-target="#IdModal">Add New</button>

        @*<a href=@Url.Action("MasterAccountHeadAddEdit","Master_AccountHead",new {@Id=0}) class="btn btn-danger m-r-20">
