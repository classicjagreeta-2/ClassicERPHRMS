@model WEB_VIEWMODEL17.Model_BH21_ADDONFILEDS



<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">




<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">


    @using (Ajax.BeginForm("StoreOrEdit", "Master_AccountHead", new AjaxOptions
    { OnSuccess = "OnSuccess", OnBegin = "OnBegin" }, new { onsubmit = "return SubmitForm(this)" }))

    {

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Account Master</h4>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">


                @*<div class="panel-heading bg-info">
                        <div id="IdMenu" class="pcoded">

                            <button type="button" class="btn btn-primary"><i class="icofont icofont-plus-circle"></i>ADD NEW</button>
                        </div>
                    </div>*@



                <div class="card-block">

                  

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Name</label>
                                @Html.TextBoxFor(x => x.ACNAME, new { @class = "form-control mustfiled", @required = "required" })

                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Full Name</label>
                                @Html.TextBoxFor(x => x.COMP_NAME, new { @class = "form-control" })
                            </div>
                        </div>


                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Address 1</label>
                                @Html.TextBoxFor(x => x.ADD1, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Address 2</label>
                                @Html.TextBoxFor(x => x.ADD2, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">City </label>
                                @Html.TextBoxFor(x => x.CITY, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Pin Code </label>
                                @Html.TextBoxFor(x => x.PIN, new { @class = "form-control" })
                            </div>
                        </div>



                        <div class="col-md-3">

                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">State</label>
                                @Html.DropDownListFor(x => x.STATE_CODE, new SelectList(ViewBag.DropdownListMasterState, "STATE_CODE", "NAME"),
                                    "SELECT..", new { @class = "js-example-responsive col-sm-12 ddlstate", @id = "ddlstate" })

                            </div>
                        </div>



                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1"> Email</label>
                                @Html.TextBoxFor(x => x.EMAIL_ID, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1"> GST No.</label>
                                @Html.TextBoxFor(x => x.GST_NO, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">GST Date</label>
                                @*@Html.TextBoxFor(x => x.GST_REGDT, new { @class = "form-control", @type = "date", @style = "height:33.91px;" })*@
                                @Html.EditorFor(x => x.GST_REGDT, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Bank Name</label>
                                @Html.TextBoxFor(x => x.BANK_NAME, new { @class = "form-control" })
                            </div>
                        </div>



                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1"> Bank A/c No.</label>
                                @Html.TextBoxFor(x => x.AC_NO, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1"> IFSC Code</label>
                                @Html.TextBoxFor(x => x.RTGS_CODE, new { @class = "form-control" })
                            </div>
                        </div>


                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Branch Name</label>
                                @Html.TextBoxFor(x => x.BRANCH, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">MICR Code</label>
                                @Html.TextBoxFor(x => x.MICR_CODE, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Swift Code</label>
                                @Html.TextBoxFor(x => x.SWIFT_CODE, new { @class = "form-control" })

                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">PAN No.</label>
                                @Html.TextBoxFor(x => x.PAN_NO, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Ch. Printing Format No.</label>
                                @Html.TextBoxFor(x => x.PRINT_TAG, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">Account Head</label>
                                @Html.HiddenFor(x => x.UqKey)
                                @Html.HiddenFor(x => x.ACODE)
                                @Html.DropDownListFor(x => x.ACCODE, new SelectList(ViewBag.DropdownListMasterAccountHead, "ACODE", "ACNAME"),
                                  "SELECT..", new { @class = ViewBag.ddlType + "  col-sm-12 disabled", @id = "ddlaccounthead", @required = "required" })

                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Opening Bal(Rs.)</label>
                                @Html.TextBoxFor(x => x.MTHOPBAL, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">CR/DR</label>
                                <select class="js-example-disabled-results col-sm-12">
                                    <option value="CR">CR</option>
                                    <option value="DR">DR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">Nature</label>
                                @Html.DropDownListFor(x => x.YTD_FIGURE, new SelectList(ViewBag.DropdownListMasterNature, "VALUE", "TEXT"),
                                   "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @id = "ddlNature" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Opening Quantity</label>
                                @Html.TextBoxFor(x => x.OPNQTY, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="exampleInputName1">CR/DR</label>
                                <select class="js-example-disabled-results col-sm-12">
                                    <option value="CR">CR</option>
                                    <option value="DR">DR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">TDS Code</label>
                                @Html.DropDownListFor(x => x.TDS_CODE, new SelectList(ViewBag.DropdownListMasterTDSCode, "VALUE", "TEXT"),
                                    "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @id = "ddltdsCode" })
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">CCI Code</label>
                                @Html.TextBoxFor(x => x.CCAC, new { @class = "form-control" })

                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">

                                <div>

                                    @Html.CheckBoxFor(x => x.REF_ORA_BOOL)
                                    <span>Maintain Reference Account</span>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>

                                        @Html.CheckBoxFor(x => x.LOGIC1_BOOL)
                                        <span>Maintain Cost Center</span>
                                    </div>
                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    <div>

                                        @Html.CheckBoxFor(x => x.DUMMY_BOOL)
                                        <span>Maintain Quality also</span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Non Operative Date</label>
                                @*@Html.TextBoxFor(x => x.NONOP, new { @class = "form-control", @type = "date", @style = "height:33.91px;" })*@
                                @Html.EditorFor(x => x.NONOP, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="exampleInputName1">Non Operative Remarks</label>
                                @*<textarea class="form-control max-textarea"  rows="2"></textarea>*@
                                @Html.TextAreaFor(x => x.NONOP_REASON, new { @class = "form-control max-textarea", @rows = "2" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Trial Group</label>
                                @Html.DropDownListFor(x => x.GCODE, new SelectList(ViewBag.DropdownListMasterTrailGroupe, "CODE", "DESCN"),
                                    "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @id = "ddltrailgroup" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">Category</label>
                                @Html.DropDownListFor(x => x.CATE_CODE, new SelectList(ViewBag.DropdownListMasterCategoryGroup, "CODE", "DESCN"),
                                     "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @id = "ddlcategorygroup" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" id="sub_category">
                                <label for="exampleInputName1">Fund Flow Group</label>
                                @Html.DropDownListFor(x => x.FFCODE, new SelectList(ViewBag.DropdownListMasterFundFlowGroup, "CODE", "DESCN"),
                                    "SELECT..", new { @class = "js-example-disabled-results col-sm-12", @id = "ddlfundflowgroup" })
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">

                                <div class="checkbox-fade fade-in-primary">

                                    @Html.CheckBoxFor(x => x.TCS_TAG_BOOL)
                                    <span>TCS Applicable</span>

                                </div>
                                <div class="checkbox-fade fade-in-primary">

                                    @Html.CheckBoxFor(x => x.TDS_TAG_BOOL)
                                    <span>TDS Applicable</span>

                                </div>
                                <div class="checkbox-fade fade-in-primary">
                                    @Html.CheckBoxFor(x => x.SPECIFIED_PERSON_BOOL)
                                    <span>Specified Person</span>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div id="divMsg" class="text-danger"> </div>


                    @*<button type="button" class="btn btn-default waves-effect btnClose" data-dismiss="modal">Close</button>*@

                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>

    }
</div>


<!-- Select 2 js -->
<script type="text/javascript" src="~/libraries/bower_components/select2/js/select2.full.min.js"></script>
<!-- Multiselect js -->
<!-- Custom js -->
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/assets/js/pcoded.min.js"></script>



<script src="~/Scripts/notify.min.js"></script>

<script src="~/libraries/js/loader/jquery.blockUI.js"></script>

<script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

<script src="~/libraries/msg/jquery-confirm.min.js"></script>

<script src="~/JsProject/commanJs.js"></script>


<script>

    function OnBegin() {
        blockUIStart();
    }

    function OnSuccess(result) {

                $.unblockUI();
                if (result.success == false) {
                    debugger;
                    msgError(result.details);
                    //$.notify(result.message, {
                    //    globalPosition: "top center",
                    //    className: "Errror"
                    //})

                } else {
                    //msgSuccess(result.message);
                    $('form').smkClear();
                    $("#ddlaccounthead option:selected").val(null).trigger("change");

                    $.confirm({

                        title:'Confirmation !!',
                        type: 'green',
                        content: result.message,
                        typeAnimated: true,
                        icon: 'icon-smiley',
                        buttons: {

                            Okay: function () {
                                $("#btnclose").click();
                                dataTable.ajax.reload();
     
                            },
                            //cancel: function () {

                            //}
                        }

                    });


                    //  debugger;
                    // $("#ddlaccounthead").empty().trigger('change')
                    // $("#ddlaccounthead option:selected").prop("selected", false);
                    // $("#ddlaccounthead").selectpicker("refresh");
                    //$.notify(result.message, {
                    //    globalPosition: "top center",
                    //    className: "success"
                    //})
                }

            }

    function OnFailure(result) {
        $.unblockUI();

    }
</script>

}

