@model HRMS.Models.Master.M_WEEKLY_OFF
@{
    ViewBag.Title = "AddEditModal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="modal-dialog modal-lg" role="document">
    @using (Html.BeginForm("AddOrUpdate", "M_Weekly_Off", FormMethod.Post, new { id = "myForm" }))
    {
        @Html.HiddenFor(x => x.id)
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Weekly Off Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">
                    <div class="row">
                        @if (Model.id != 0)
                        {
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Unit Code & Descn:</label>
                                @Html.TextBoxFor(x => x.unit, new { @class = "form-control mustfiled", @required = "required", @readonly = true })
                            </div>
                            @Html.HiddenFor(x => x.id)
                            @Html.HiddenFor(x => x.unit)
                        </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="exampleInputName1">Unit Code & Descn:</label>
                                    @Html.DropDownListFor(x => x.unit, new SelectList(ViewBag.Unit, "Value", "Text"), "SELECT..", new { @class = "form-control" ,@required = "required" })
                                </div>
                            </div>
                        }
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1"> Attend Code & Descn:</label>
                                @if (Model.id != 0)
                                {
                                    @Html.TextBoxFor(x => x.fK_ATTEND_CODE, new { @class = "form-control mustfiled", @required = "required", @readonly = true })
                                    @Html.HiddenFor(x => x.fK_ATTEND_CODE)

                                }
                                else
                                {
                                    @Html.DropDownListFor(x => x.fK_ATTEND_CODE, new SelectList(ViewBag.Attend, "Value", "Text", "W"), "SELECT..", new { @class = "form-control", @required = "required" })
                                }

                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Off Day 1 :</label>
                                @Html.DropDownListFor(x => x.ofF_DAY1, new SelectList(ViewBag.DayList, "Value", "Text"), "SELECT..", new { @class = "form-control" , @required = "required" })
                            </div>                           
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Off Day 2 :</label>
                                @Html.DropDownListFor(x => x.ofF_DAY2, new SelectList(ViewBag.DayList, "Value", "Text"), "SELECT..", new { @class = "form-control" })
                            </div>

                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>
                <a class="btn btn-default waves-effect" onclick="location.href='@Url.Action("M_Weekly_Off","M_Weekly_Off")'" id="btnclose" data-dismiss="modal">Close</a>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>Submit</button>
            </div>
        </div>
    }
</div>






