

@model HRMS.Models.Master.MONTHLY_ATTENDANCE_ENTRY
@{
    ViewBag.Title = "MonthlyAttendanceUpload";
}

<div style="text-align:center "><b>Upload Monthly Attendence</b></div>
<div class="col-lg-12 col-xl-5">
    <div class="card">
        <div class="card-block">

            @using (Html.BeginForm("MonthlyAttendanceEntry", "MonthlyAttendanceEntry", FormMethod.Get))
            {
                <div class="row form-group col-sm-12">
                    <div class="col-sm-3">
                        <label class="col-form-label">Unit</label>
                    </div>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(m => m.UNIT, new SelectList(ViewBag.AllowCal2 ?? new List<SelectListItem>(), "Value", "Text"), "SELECT..",
                            new { @class = "form-control js-example-data-array", @id = "UNIT", onchange = "document.forms[0].submit();" })
                    </div>
                    <div class="row form-group col-sm-12">
                        <div class="col-sm-5">
                            <label class="col-form-label">For The Month</label>
                        </div>
                        <div class="col-sm-7">
                            @Html.DropDownListFor(m => m.MONTHCODE, new SelectList(ViewBag.emplist ?? new List<SelectListItem>(), "Value", "Text"), "SELECT..",
                                new { @class = "form-control js-example-data-array", @id = "MONTHCODE", onchange = "document.forms[0].submit();" })
                        </div>
                    </div>
                    
                    <div class="row form-group col-sm-12">
                        <div class="col-sm-12">
                            <input class="form-control " type="file" id="formFile">
                        </div>
                    </div>
                        <div class="row form-group col-sm-12">
                            <div class="col-sm-2">
                                <button type="submit" class="btn btn-primary">Uplode</button>
                            </div>

                            <div class="col-sm-2">
                                <button type="submit" class="btn btn-primary">Cancel</button>
                            </div>
                          
                            </div>
                       
                    </div>
            }
        </div>
    </div>
</div>