    <!-- Select 2 js -->
    <script type="text/javascript" src="~/libraries/bower_components/select2/js/select2.full.min.js"></script>
    <!-- Multiselect js -->
    <!-- Custom js -->
    <script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
    <script src="~/libraries/assets/js/pcoded.min.js"></script>

    <script src="~/libraries/js/jquery.unobtrusive-ajax.min.js"></script>

    <script src="~/Scripts/notify.min.js"></script>

    <script type="text/javascript" src="~/libraries/bower_components/sweetalert/js/sweetalert.min.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/modal.js"></script>
    <!-- sweet alert modal.js intialize js -->
    <!-- modalEffects js nifty modal window effects -->
    <script type="text/javascript" src="~/libraries/assets/js/modalEffects.js"></script>
    <script type="text/javascript" src="~/libraries/assets/js/classie.js"></script>

    <script type="text/javascript" src="~/libraries/assets/js/script.js"></script>

    <!-- Accordion js -->
    <script type="text/javascript" src="~/libraries/assets/pages/accordion/accordion.js"></script>

    <script src="~/libraries/js/loader/jquery.blockUI.js"></script>

    <script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>

    <script src="~/libraries/msg/jquery-confirm.min.js"></script>

    <script src="~/JsProject/commanJs.js"></script>
    <script src="~/libraries/jsEntryForm/ag-script.js"></script>

    <script>
            $(document).ready(function () {
                $("#mobile-collapse").click();
            });

            $('#btnSubmit').click(function (e) {
                e.preventDefault();
                if ($('form').smkValidate()) {

                    var dataString = new FormData($("#myForm").get(0));
                    blockUIStart();
                    var redirectUrl = '@Url.Action("StoreOrEdit", "Master_AccountHead")';
                    $.ajax({
                        url: redirectUrl,
                        data: dataString,
                        contentType: false,
                        processData: false,
                        cache: false,
                        type: "POST",
                        dataType: "json",
                        success: function (data) {
                            OnSuccess(data);
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        }
                    });


                }
            });


            function PopupForm() {
                alert('');
                $('#myModal2').modal('show');

            }

            function LoadProgess() {
                alert('');
            }



            function OnSuccess(result) {
                $.unblockUI();
                if (result.success == false) {
                    debugger;
                    msgError(result.details);
                    //$.notify(result.message, {
                    //    globalPosition: "top center",
                    //    className: "Errror"
                    //})

                } else {
                    //msgSuccess(result.message);
                    $('form').smkClear();
                    $("#ddlaccounthead option:selected").val(null).trigger("change");

                    $.confirm({

                        title:'Confirmation !!',
                        type: 'green',
                        content: result.message,
                        typeAnimated: true,
                        icon: 'icon-smiley',
                        buttons: {

                            Okay: function () {
                               var url = '@Url.Action("Master_AccountHead", "Master_AccountHead")';
                               window.location.href = url;
                            },
                            //cancel: function () {

                            //}
                        }

                    });


                    //  debugger;
                    // $("#ddlaccounthead").empty().trigger('change')
                    // $("#ddlaccounthead option:selected").prop("selected", false);
                    // $("#ddlaccounthead").selectpicker("refresh");
                    //$.notify(result.message, {
                    //    globalPosition: "top center",
                    //    className: "success"
                    //})
                }

            }

            function OnFailure(result) {
                $.unblockUI();
            }

    </script>

}
