    <script type="text/javascript" src="https://code.jquery.com/jquery-latest.min.js"></script>
    @*<script src="~/libraries/Export/html2pdf.bundle.min.js"></script>*@
    <script src="~/libraries/Export/FileSaver.min.js"></script>

    <script src="~/libraries/Export/polyfills.umd.js"></script>
    <script src="~/libraries/Export/jspdf.umd.min.js"></script>

    <script src="~/libraries/Export/pdfmake.min.js"></script>

    <script src="~/libraries/Export/vfs_fonts.js"></script>


    <script src="~/libraries/Export/tableExport.js"></script>

    <script>
        $(document).ready(function () {
            var element;
            $("#btnPrint").on('click', function () {

                var element = document.getElementById('contnet');
                html2pdf(element, {
                    margin: 0,
                    filename: 'FileName.pdf',
                    image: { type: 'jpeg', quality: 1 },
                    html2canvas: { dpi: 190, letterRendering: true },
                    jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
                });
            });
        });
        $("#btnPrintx").on('click', function () {
            $('#contnet').tableExport({
                type: 'pdf',
                pdfmake: {
                    enabled: true,

                }
            })
        })

    </script>

}
