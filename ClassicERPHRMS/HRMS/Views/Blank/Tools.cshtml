                                <select class="js-example-disabled-results col-sm-12">
                                    <option value="one">First</option>
                                    <option value="three">Third</option>
                                </select>
                            </div>
                        </div>


                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">Shipment Cost No.*</label>
                                <input type="text" name="shipment_cost_no" id="shipment_cost_no" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="exampleInputName1">E-Way Bill No.</label>
                                <input type="text" name="eway_bill_no" id="eway_bill_no" class="form-control">
